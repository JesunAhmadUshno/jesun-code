note jpm package "http": plain-English web helpers.

import urllib.request as urlmod
import builtins as bmod

to http_get with url
    response is urlmod.urlopen(url, timeout=10)
    reader is bmod.getattr(response, "read")
    body is reader()
    give back body.decode("utf-8", errors="replace")

to http_status with url
    response is urlmod.urlopen(url, timeout=10)
    give back response.status
