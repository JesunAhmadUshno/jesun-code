note jpm package "serve": the full-stack web framework (spec docs/spec-serve.md, v3.0 M2).
note A COMPOSITE package (first of its kind, spec section 1): used with
note jweb, sitegen, js, html, sqlite brought in alongside; serve calls only
note the functions named in spec section 3.7. Every serve-defined name is
note prefixed serve_ so bring-in order can never collide. serve defines no
note `serve`; the entry point is serve_start (jweb owns `serve`).
note M2 scope: Route, Page, Island, Table + admin (spec 3.1-3.3, 3.5).
note Live view (3.4) and Scene (3.6) are M3.

note ---- kinds: article + description for plain-English errors ----

to serve_article with k
    if k is "agent" then
        give back "an agent"
    if k is "true/false" then
        give back "true/false"
    if k is "python value" then
        give back "a python value"
    give back "a " + k

to serve_describe with v
    k is kind of v
    if k is "text" then
        give back "\"" + v + "\""
    if k is "number" or k is "true/false" then
        give back text of v
    a is serve_article with k
    give back a

note ---- module state (tables, so handlers can mutate them) ----

serve_state is {"site": nothing}
serve_registry is a new table

note ---- tiny helpers (serve's own; the composite list names no helpers) ----

to serve_starts_with with s and needle
    if length of s is less than length of needle then
        give back false
    i is 0
    n is length of needle
    chars is characters of s
    nchars is characters of needle
    repeat while i is less than n
        if chars[i] is not nchars[i] then
            give back false
        i is i + 1
    give back true

to serve_need_site
    if serve_state["site"] is nothing then
        fail with "serve_site has to be called first, with a name, a url, and a version."

note ---- serve_site: one site per app (spec 3.2) ----

to serve_site with name and url and version
    if kind of name is not "text" or kind of url is not "text" or kind of version is not "text" then
        fail with "serve_site needs a name, a url, and a version, all text."
    if serve_state["site"] is not nothing then
        fail with "serve_site was already called; one site per app."
    site is a new table
    site["name"] is name
    site["site_url"] is url
    site["version"] is version
    serve_state["site"] is site
    give back site

note ---- Route (spec 3.1): sentences over jweb's add_route ----

to serve_route with route and handler
    if kind of route is not "text" then
        fail with "serve_route needs \"METHOD /path\", like \"GET /hello\"."
    words is split of route by " "
    if length of words is not 2 then
        fail with "serve_route needs \"METHOD /path\", like \"GET /hello\"."
    if not (serve_starts_with with words[1] and "/") then
        fail with "serve_route needs \"METHOD /path\", like \"GET /hello\"."
    if kind of handler is not "function" then
        d is serve_describe with handler
        fail with "the route handler has to be a function, but this is " + d + "."
    add_route with route and handler
    give back nothing

to serve_start with port
    if kind of port is not "number" then
        d is serve_describe with port
        fail with "serve_start needs a port number from 1 to 65535, but this is " + d + "."
    if port is less than 1 or port is greater than 65535 then
        d is serve_describe with port
        fail with "serve_start needs a port number from 1 to 65535, but this is " + d + "."
    if (text of port) contains "." then
        d is serve_describe with port
        fail with "serve_start needs a port number from 1 to 65535, but this is " + d + "."
    site is serve_state["site"]
    if site is nothing then
        show "serve: listening without a site name; call serve_site to name it."
    otherwise
        show "Serving " + site["name"] + " on port " + (text of port)
    serve with port

note ---- Page (spec 3.2): server-rendered HTML, zero JavaScript ----
note Composes sitegen_head + sitegen_nav + body + sitegen_footer directly,
note NOT sitegen_page: sitegen_page hardcodes an assets/app.js script tag
note that dynamic pages must not carry (spec section 3.2 judgment call).

to serve_page_table with title and body and canonical
    serve_need_site
    if kind of title is not "text" or title is "" then
        fail with "a page needs a title, but this one is missing."
    if kind of body is not "text" then
        d is serve_describe with body
        fail with "a page body has to be text, but this is " + d + "."
    site is serve_state["site"]
    page is a new table
    page["title"] is title
    page["description"] is ""
    page["canonical"] is canonical
    page["body"] is body
    page["root_prefix"] is "./"
    page["nav"] is "root"
    give back page

to serve_render_page with page
    site is serve_state["site"]
    head is sitegen_head with page and site
    nav is sitegen_nav with page and site
    foot is sitegen_footer with page and site
    doc is "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n" + head + "\n</head>\n<body>\n"
    doc is doc + nav + "\n" + page["body"] + "\n" + foot + "\n</body>\n</html>\n"
    give back doc

to serve_page with title and body
    serve_need_site
    site is serve_state["site"]
    page is serve_page_table with title and body and site["site_url"]
    doc is serve_render_page with page
    give back ok with doc

to serve_page_at with route and title and body
    serve_need_site
    site is serve_state["site"]
    page is serve_page_table with title and body and (site["site_url"] + route)
    doc is serve_render_page with page
    give back ok with doc

note ---- Island (spec 3.3): a fenced interactive widget ----
note html plus its own script, hydrated only where placed. The script is
note already-built JavaScript text (assembled with the js package); serve
note wraps it in one script tag and nothing else.

serve_letters is "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
serve_alnum is "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

to serve_valid_island_id with id
    if kind of id is not "text" or id is "" then
        give back false
    chars is characters of id
    if not (serve_letters contains chars[0]) then
        give back false
    i is 1
    repeat while i is less than length of chars
        c is chars[i]
        if not (serve_alnum contains c) and c is not "-" and c is not "_" then
            give back false
        i is i + 1
    give back true

to serve_island with id and html and script
    if not (serve_valid_island_id with id) then
        shown is serve_describe with id
        if kind of id is "text" then
            shown is "\"" + id + "\""
        fail with shown + " is not a valid island id. Use letters, numbers, dashes, and underscores, starting with a letter."
    if kind of html is not "text" then
        d is serve_describe with html
        fail with "an island html has to be text, but this is " + d + "."
    if kind of script is not "text" then
        d is serve_describe with script
        fail with "an island script has to be text, but this is " + d + "."
    give back html + "\n" + (script_tag with script)

note ---- Table: the English data layer (spec 3.5) ----
note Names are validated, so DDL is built by joining validated
note identifiers only; user text never reaches DDL except through
note ? parameters. Injection-safe by construction (spec section 7).

serve_field_types is {"text": "TEXT", "number": "REAL", "true/false": "INTEGER"}

to serve_valid_name with name
    if kind of name is not "text" or name is "" then
        give back false
    chars is characters of name
    if not (serve_letters contains chars[0]) then
        give back false
    i is 1
    repeat while i is less than length of chars
        c is chars[i]
        if not (serve_alnum contains c) and c is not "_" then
            give back false
        i is i + 1
    give back true

to serve_table with name and fields
    if not (serve_valid_name with name) then
        fail with (serve_describe with name) + " is not a valid table name. Use letters, numbers, and underscores, starting with a letter."
    clean is []
    seen is []
    for each f in fields
        if kind of f is not "list" or length of f is less than 2 then
            fail with "each field has to be a [name, kind] pair, but this is " + (serve_describe with f) + "."
        fname is f[0]
        fkind is f[1]
        if not (serve_valid_name with fname) then
            fail with (serve_describe with fname) + " is not a valid field name. Use letters, numbers, and underscores, starting with a letter."
        if kind of fkind is not "text" or not (serve_field_types contains fkind) then
            fail with (serve_describe with fkind) + " is not a field kind. Use \"text\", \"number\", or \"true/false\"."
        if seen contains fname then
            fail with "the table \"" + name + "\" already has a field called \"" + fname + "\"."
        push fname to seen
        push [fname, fkind] to clean
    cols is ["id INTEGER PRIMARY KEY"]
    for each f in clean
        push (f[0] + " " + serve_field_types[f[1]]) to cols
    create is "CREATE TABLE " + name + " (" + (join of cols with ", ") + ")"
    decl is {"name": name, "fields": clean, "history": [{"version": 1, "sql": create}], "version": 1}
    give back decl

to serve_add_field with declaration and name and field_kind
    tname is declaration["name"]
    if not (serve_valid_name with name) then
        fail with (serve_describe with name) + " is not a valid field name. Use letters, numbers, and underscores, starting with a letter."
    if kind of field_kind is not "text" or not (serve_field_types contains field_kind) then
        fail with (serve_describe with field_kind) + " is not a field kind. Use \"text\", \"number\", or \"true/false\"."
    for each f in declaration["fields"]
        if f[0] is name then
            fail with "the table \"" + tname + "\" already has a field called \"" + name + "\"."
    v is declaration["version"] + 1
    declaration["version"] is v
    flds is declaration["fields"]
    push [name, field_kind] to flds
    declaration["fields"] is flds
    sql is "ALTER TABLE " + tname + " ADD COLUMN " + name + " " + serve_field_types[field_kind]
    hist is declaration["history"]
    push {"version": v, "sql": sql} to hist
    declaration["history"] is hist
    give back declaration

to serve_migrate with db and declaration
    tname is declaration["name"]
    db_run with db and "CREATE TABLE IF NOT EXISTS _serve_migrations (tname TEXT, version INTEGER, sql TEXT, applied TEXT)" and nothing
    found is db_query with db and "SELECT version FROM _serve_migrations WHERE tname = ?" and [tname]
    applied is []
    for each r in found
        push r["version"] to applied
    done is []
    today is time_today
    for each m in declaration["history"]
        v is m["version"]
        if not (applied contains v) then
            db_run with db and m["sql"] and nothing
            db_run with db and "INSERT INTO _serve_migrations (tname, version, sql, applied) VALUES (?, ?, ?, ?)" and [tname, v, m["sql"], today]
            push v to done
    give back done

to serve_migrations with db and name
    rows is db_query with db and "SELECT tname, version, sql, applied FROM _serve_migrations WHERE tname = ? ORDER BY version" and [name]
    give back rows

to serve_all with db and declaration
    tname is declaration["name"]
    give back db_query with db and ("SELECT * FROM " + tname) and nothing

note ---- forms, guards, and the derived admin ----

to serve_form with request
    body is ""
    if request contains "body" then
        body is request["body"]
    if kind of body is not "text" or body is "" then
        give back a new table
    give back jweb_parse_query with body

to serve_guard with request
    sess is session_of with request
    if sess contains "user" then
        give back sess["user"]
    give back nothing

to serve_admin_tname with path
    note "/admin/<tname>" or "/admin/<tname>/delete": the table name
    note is always the third slash-segment.
    parts is split of path by "/"
    give back parts[2]

to serve_admin_list with request
    tname is serve_admin_tname with request["path"]
    entry is serve_registry[tname]
    db is entry["db"]
    decl is entry["declaration"]
    rows is serve_all with db and decl
    head is ""
    for each f in decl["fields"]
        head is head + "<th>" + (escape_html with f[0]) + "</th>"
    body_rows is ""
    for each r in rows
        cells is ""
        for each f in decl["fields"]
            v is r[f[0]]
            if v is nothing then
                v is ""
            otherwise
                v is text of v
            cells is cells + "<td>" + (escape_html with v) + "</td>"
        del is "<form method=\"post\" action=\"/admin/" + tname + "/delete\">" + "<input type=\"hidden\" name=\"id\" value=\"" + (escape_html with (text of r["id"])) + "\">" + "<button type=\"submit\">Delete</button></form>"
        body_rows is body_rows + "<tr>" + cells + "<td>" + del + "</td></tr>"
    inputs is ""
    for each f in decl["fields"]
        inputs is inputs + "<label>" + (escape_html with f[0]) + " <input name=\"" + (escape_html with f[0]) + "\"></label> "
    form is "<form method=\"post\" action=\"/admin/" + tname + "\">" + inputs + "<button type=\"submit\">Add</button></form>"
    page_body is "<main><h1>" + (escape_html with (tname + " admin")) + "</h1><table><tr>" + head + "<th></th></tr>" + body_rows + "</table>" + form + "</main>"
    give back serve_page with (tname + " admin") and page_body

to serve_admin_create with request
    tname is serve_admin_tname with request["path"]
    entry is serve_registry[tname]
    db is entry["db"]
    decl is entry["declaration"]
    form is serve_form with request
    cols is []
    marks is []
    vals is []
    for each f in decl["fields"]
        fname is f[0]
        push fname to cols
        push "?" to marks
        v is nothing
        if form contains fname then
            v is form[fname]
        push v to vals
    sql is "INSERT INTO " + tname + " DEFAULT VALUES"
    if length of cols is greater than 0 then
        sql is "INSERT INTO " + tname + " (" + (join of cols with ", ") + ") VALUES (" + (join of marks with ", ") + ")"
    db_run with db and sql and vals
    give back redirect_to with ("/admin/" + tname)

to serve_admin_delete with request
    tname is serve_admin_tname with request["path"]
    entry is serve_registry[tname]
    db is entry["db"]
    form is serve_form with request
    id is nothing
    if form contains "id" then
        id is form["id"]
    db_run with db and ("DELETE FROM " + tname + " WHERE id = ?") and [id]
    give back redirect_to with ("/admin/" + tname)

to serve_admin with db and declaration
    tname is declaration["name"]
    if serve_registry contains tname then
        fail with "the admin for \"" + tname + "\" is already registered."
    serve_registry[tname] is {"db": db, "declaration": declaration}
    add_route with ("GET /admin/" + tname) and serve_admin_list
    add_route with ("POST /admin/" + tname) and serve_admin_create
    add_route with ("POST /admin/" + tname + "/delete") and serve_admin_delete
    give back nothing

note ---- live views: server-sent events (spec v3.0 sections 3.4, 5) ----
note One page, one stream, one session. GET <route>/events opens the SSE
note stream; POST <route>/events feeds click events back in. The client
note (serve_live_script) is an EventSource plus click delegation, built
note with the js package per the spec's composite list (section 3.7).

serve_streams is a new table
serve_stream_ctx is a new table
serve_live_routes is []

to serve_live_entry with sid
    if serve_streams contains sid then
        give back serve_streams[sid]
    give back nothing

to serve_find_from with chars and needle and start
    note First index of needle in chars at or after start, or -1.
    n is length of chars
    m is length of needle
    i is start
    repeat while i + m is at most n
        match is true
        j is 0
        repeat while j is less than m
            if chars[i + j] is not needle[j] then
                match is false
            j is j + 1
        if match then
            give back i
        i is i + 1
    give back -1

to serve_parse_json_string with chars and i
    note chars[i] is the opening quote. Gives back [text, next index],
    note or nothing when the string never closes or an escape runs off.
    i is i + 1
    out is ""
    n is length of chars
    repeat while i is less than n
        c is chars[i]
        if c is "\"" then
            give back [out, i + 1]
        if c is "\\" then
            i is i + 1
            if i is at least n then
                give back nothing
            e is chars[i]
            if e is "n" then
                out is out + "\n"
            otherwise
                if e is "t" then
                    out is out + "\u0009"
                otherwise
                    out is out + e
        otherwise
            out is out + c
        i is i + 1
    give back nothing

to serve_parse_event with body
    note The event name from a body shaped like {"event": "name"},
    note or nothing for anything else (unknown JSON is a 400 upstream).
    if kind of body is not "text" then
        give back nothing
    chars is characters of (trim of body)
    n is length of chars
    if n is less than 2 then
        give back nothing
    if chars[0] is not "{{" then
        give back nothing
    keypos is serve_find_from with chars and (characters of "\"event\"") and 1
    if keypos is -1 then
        give back nothing
    i is keypos + 7
    repeat while i is less than n and chars[i] is " "
        i is i + 1
    if i is at least n then
        give back nothing
    if chars[i] is not ":" then
        give back nothing
    i is i + 1
    repeat while i is less than n and chars[i] is " "
        i is i + 1
    if i is at least n then
        give back nothing
    if chars[i] is not "\"" then
        give back nothing
    parsed is serve_parse_json_string with chars and i
    if parsed is nothing then
        give back nothing
    give back parsed[0]

to serve_live_script with route
    note The client: an EventSource on <route>/events re-rendering the
    note #serve-live div on every "render" frame, plus click delegation
    note POSTing {"event": name} for [data-event] clicks. Built with the
    note js package (spec 3.7); EventSource has no builder, so that one
    note line is hand-written text.
    url is js_string with (route + "/events")
    render_code is "var es = new EventSource(" + url + ");\n"
    render_code is render_code + "es.addEventListener(\"render\", function(e) {{\n"
    render_code is render_code + "document.getElementById(\"serve-live\").innerHTML = e.data;\n"
    render_code is render_code + "});"
    post is js_fetch with (route + "/events") and "POST" and "JSON.stringify({{event: t.getAttribute(\"data-event\")}})"
    click_code is "document.getElementById(\"serve-live\").addEventListener(\"click\", function(e) {{\n"
    click_code is click_code + "var t = e.target.closest(\"[data-event]\");\n"
    click_code is click_code + "if (!t) return;\n"
    click_code is click_code + post + ";\n"
    click_code is click_code + "});"
    give back dom_ready with (render_code + "\n" + click_code)

to serve_live with request and title and state and render and on_event
    note A page that re-renders itself live over SSE (spec 3.4). `state`
    note is this visitor's starting table (copied per session), `render`
    note turns state into HTML, and `on_event` handles {"name": ...}
    note events, giving back the next HTML frame.
    serve_need_site
    if kind of title is not "text" or title is "" then
        fail with "a page needs a title, but this one is missing."
    if kind of state is not "table" then
        d is serve_describe with state
        fail with "live view state has to be a table, but this is " + d + "."
    if kind of render is not "function" then
        d is serve_describe with render
        fail with "a live view needs a render function, but this is " + d + "."
    if kind of on_event is not "function" then
        d is serve_describe with on_event
        fail with "a live view needs an event function, but this is " + d + "."
    route is request["path"]
    sess is session_of with request
    sid is jweb_session_id with request
    mine is a new table
    for each k in keys of state
        mine[k] is state[k]
    serve_stream_ctx[sid] is {"state": mine, "render": render, "on_event": on_event}
    if not (serve_live_routes contains route) then
        push route to serve_live_routes
        add_route with ("GET " + route + "/events") and serve_live_stream
        add_route with ("POST " + route + "/events") and serve_live_post
    initial is render with mine
    body is "<main>\n<div id=\"serve-live\">\n" + initial + "\n</div>\n</main>"
    give back serve_page with title and (body + "\n" + (script_tag with (serve_live_script with route)))

to serve_live_stream with request
    sid is jweb_session_id with request
    if not (serve_stream_ctx contains sid) then
        give back {"status": 410, "headers": {"content-type": "application/json"}, "body": "{{\"error\": \"the live view is gone; reload the page.\"}}"}
    give back {"sse": true, "setup": serve_live_setup}

to serve_live_setup with pipe and request
    note Runs on the main thread inside jweb_sse_stream. Registers the
    note stream, sends the first render frame, and gives back: the byte
    note pump keeps the socket open, so this never blocks the server.
    sid is jweb_session_id with request
    if not (serve_stream_ctx contains sid) then
        fail with "the live view is gone; reload the page."
    ctx is serve_stream_ctx[sid]
    pair is pipe["pair"]
    jweb_sse_use with pair
    sender is pipe["send"]
    rend is ctx["render"]
    initial is rend with ctx["state"]
    ok is sender with "render" and initial
    if not ok then
        give back nothing
    stream is pipe["stream"]
    stream["serve_sid"] is sid
    stream["cleanup"] is serve_live_cleanup
    serve_streams[sid] is {"pair": pair, "send": sender, "state": ctx["state"], "render": ctx["render"], "on_event": ctx["on_event"]}
    give back nothing

to serve_live_cleanup
    note Runs on the main thread from jweb's reaper when a stream's
    note socket dies. Drops the session's registry entries so the next
    note POST gets a 410 instead of writing into a dead stream.
    st is jweb_dead_stream
    if st is nothing then
        give back nothing
    if st contains "serve_sid" then
        sid is st["serve_sid"]
        serve_streams[sid] is nothing
        serve_stream_ctx[sid] is nothing
    give back nothing

to serve_live_post with request
    sid is jweb_session_id with request
    body is ""
    if request contains "body" then
        body is request["body"]
    name is serve_parse_event with body
    if name is nothing then
        give back {"status": 400, "headers": {"content-type": "application/json"}, "body": "{{\"error\": \"that event was not JSON.\"}}"}
    entry is serve_live_entry with sid
    if entry is nothing then
        give back {"status": 410, "headers": {"content-type": "application/json"}, "body": "{{\"error\": \"the live view is gone; reload the page.\"}}"}
    if jweb_sse_dead with entry["pair"] then
        serve_streams[sid] is nothing
        serve_stream_ctx[sid] is nothing
        give back {"status": 410, "headers": {"content-type": "application/json"}, "body": "{{\"error\": \"the live view is gone; reload the page.\"}}"}
    jweb_sse_use with entry["pair"]
    sender is entry["send"]
    onev is entry["on_event"]
    html is onev with entry["state"] and {"name": name}
    ok is sender with "render" and html
    give back {"status": 200, "headers": {"content-type": "application/json"}, "body": "{{\"ok\": true}}"}

to serve_scene with title and scene
    note A 3D scene page (spec v3.0 section 3.6): the scene is assembled
    note with the threejs package and wrapped here in a full page.
    serve_need_site
    if kind of title is not "text" or title is "" then
        fail with "a page needs a title, but this one is missing."
    doc is three_page with title and scene
    give back ok with doc

note ---- fenced code running: the playground fence (spec v3.0 section 9, M4) ----
note Untrusted Jesun.Code source runs in a child process: a 5-second timeout,
note a fresh sandbox working folder per run, stdout/stderr capped at 64 KiB,
note and the network cut with unshare -n where the host allows it. Failures
note come back as plain-English text, never a traceback. This is the one
note exception to the framework's rule against running client code.
note Raw primitives (the v1.4 scaffolder boundary, like sitegen's makedirs):
note the child is spawned through one eval'd lambda so the timeout and the
note capture kwargs stay on the Python side; the fence's decisions (sandbox,
note timeout mapping, output cap) are all Jesun.Code.

import os as osfencemod
import sys as sysfencemod
import builtins as bmodfence
import shutil as shutfence
import tempfile as tmpfence

serve_fence_spawn is bmodfence.eval("lambda argv, cwd: __import__('subprocess').run(argv, capture_output=True, text=True, timeout=5, cwd=cwd)")

to serve_fence_cmd
    note The child is this same runtime: the frozen binary runs itself,
    note the bootstrap runs the python script again.
    exe is bmodfence.getattr(sysfencemod, "executable")
    frozen is bmodfence.getattr(sysfencemod, "frozen", false)
    argv is bmodfence.getattr(sysfencemod, "argv")
    script is argv[0]
    if frozen or not ((text of script) contains ".py") then
        give back [exe]
    note Absolute: the child runs with the sandbox as its working folder,
    note so a relative interpreter path would not resolve there.
    give back [exe, serve_fence_abspath(script)]

to serve_fence_net
    note true when unshare -n actually cuts the network on this host.
    unshare is shutfence.which("unshare")
    if kind of unshare is "nothing" then
        give back false
    probe is attempt serve_fence_spawn([unshare, "-n", "true"], "/tmp")
    if not (probe["ok"]) then
        give back false
    done is probe["value"]
    give back (bmodfence.getattr(done, "returncode") is 0)

serve_fence_unshare is serve_fence_net

serve_fence_slice is bmodfence.eval("lambda s, n: s[:n]")

serve_fence_abspath is bmodfence.eval("lambda p: __import__('os').path.abspath(p)")

to serve_fence_cap with content
    note 64 KiB cap; the tail note says when it cut. The slice is a
    note bridge lambda on purpose: a character loop here would be quadratic
    note and a big output would hang the server it is meant to protect.
    if length of content is at most 65536 then
        give back content
    cut is serve_fence_slice(content, 65536)
    give back cut + "\n(output cut at 64 KiB)"

to serve_fence_text with value
    note Bridge strings come back as "" or text; None would be nothing.
    if kind of value is "nothing" then
        give back ""
    give back value

to serve_run_fenced with source
    note Run untrusted Jesun.Code source inside the fence. Gives back a table:
    note ok, output (capped plain text), timed_out, net_isolated.
    if kind of source is not "text" then
        d is serve_describe with source
        fail with "fenced source has to be text, but this is " + d + "."
    if source is "" then
        fail with "fenced source is empty; there is nothing to run."
    if length of source is greater than 1048576 then
        fail with "fenced source is over 1 MiB; the fence refuses it."
    note The sandbox lives under this process's working folder: Jesun.Code
    note file I/O refuses paths outside the working folder, so the system
    note temp dir is off limits. The child's own writes are confined to
    note the box the same way, because the child runs with the box as its
    note working folder.
    here is osfencemod.getcwd()
    box is tmpfence.mkdtemp("", "jc_fence_", here)
    write source to file (box + "/main.jc")
    cmd is serve_fence_cmd
    if serve_fence_unshare then
        unshare is shutfence.which("unshare")
        full is [unshare, "-n"]
        for each part in cmd
            push part to full
        push (box + "/main.jc") to full
        cmd is full
    otherwise
        push (box + "/main.jc") to cmd
    outcome is attempt serve_fence_spawn(cmd, box)
    ignored is attempt shutfence.rmtree(box, true)
    result is {"ok": false, "output": "", "timed_out": false, "net_isolated": serve_fence_unshare}
    if not (outcome["ok"]) then
        err is outcome["error"]
        if (text of err) contains "timed out" then
            result["timed_out"] is true
            result["output"] is "that program took too long; the fence stopped it after 5 seconds."
        otherwise
            result["output"] is "the fence could not start that program: " + err
        give back result
    done is outcome["value"]
    code is bmodfence.getattr(done, "returncode")
    if code is 0 then
        result["ok"] is true
        result["output"] is serve_fence_cap with (serve_fence_text with (bmodfence.getattr(done, "stdout")))
    otherwise
        note Jesun.Code failures print to stdout, so the plain-English
        note error is there; stderr is the fallback for bridge-level noise.
        errtext is serve_fence_text with (bmodfence.getattr(done, "stdout"))
        if errtext is "" then
            errtext is serve_fence_text with (bmodfence.getattr(done, "stderr"))
        if errtext is "" then
            errtext is "that program failed without saying why."
        result["output"] is serve_fence_cap with errtext
    give back result

to serve_run_route with request
    note POST /run: Jesun.Code source in, fenced output out as JSON.
    body is ""
    if request contains "body" then
        body is request["body"]
    if kind of body is not "text" or body is "" then
        give back {"status": 400, "headers": {"content-type": "application/json"}, "body": "{{\"error\": \"post Jesun.Code source as the body.\"}}"}
    if length of body is greater than 1048576 then
        give back {"status": 413, "headers": {"content-type": "application/json"}, "body": "{{\"error\": \"source is over 1 MiB; the fence refuses it.\"}}"}
    fenced is serve_run_fenced with body
    give back {"status": 200, "headers": {"content-type": "application/json"}, "body": json of {"ok": fenced["ok"], "output": fenced["output"], "timed_out": fenced["timed_out"], "net_isolated": fenced["net_isolated"]}}

serve_run_state is {"registered": false}

to serve_run_api
    note Register POST /run and GET /run (the usage page) on this site.
    serve_need_site
    if serve_run_state["registered"] then
        fail with "the /run api is already registered."
    serve_run_state["registered"] is true
    add_route with "POST /run" and serve_run_route
    add_route with "GET /run" and serve_run_help
    give back nothing

to serve_run_help with request
    note A human page explaining POST /run with a curl example.
    body is "<main><h1>Run Jesun.Code in the fence</h1>"
    body is body + "<p>POST Jesun.Code source to <code>/run</code>. It runs in a child process: 5-second timeout, a fresh sandbox folder, output capped at 64 KiB, no network. You get JSON back.</p>"
    body is body + "<pre>curl -X POST --data-binary @hello.jc https://HOST/run</pre>"
    body is body + "<p>Example reply: <code>{{\"ok\": true, \"output\": \"hi\\n\", \"timed_out\": false, \"net_isolated\": true}}</code></p>"
    body is body + "</main>"
    give back serve_page with "Run in the fence" and body
