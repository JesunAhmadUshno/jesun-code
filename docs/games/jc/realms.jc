note DEEPDELVE REALMS: a roguelike in pure Jesun.Code.
note No bring in, no import, no show. The driver pumps seed_game, set_difficulty, press, tick.
note Display list commands go to OUT["dl"]; HUD and messages to OUT.
note Frame is 192x128 pixels. Top-down tiles are 8px; FPP casts 48 rays over 66 degrees.
note
note HONEST RENDERER NOTE: the driver only understands rect, circle and line on a
note 192x128 canvas. There is no texture memory, no image blitting, no GPU. The
note ceiling for "textures" here is flat-shaded pixel art: multi-rect sprites,
note distance-banded wall shading, two-tone dithering on static tiles, and
note animated color cycling. Anything fancier would need new driver primitives.

G is a new table
OUT is a new table

note Logical sprite names. The driver resolves these through assets/atlas.json.
note drawImage blits keep every gameplay system in pure Jesun.Code.
SPR is a new table
SPR["tile_wall"] is "tile_wall"
SPR["tile_floor"] is "tile_floor"
SPR["tile_grass"] is "tile_grass"
SPR["tile_flowers"] is "tile_flowers"
SPR["tile_tree_pine"] is "tile_tree_pine"
SPR["tile_tree_round"] is "tile_tree_round"
SPR["tile_water0"] is "tile_water0"
SPR["tile_water1"] is "tile_water1"
SPR["tile_path"] is "tile_path"
SPR["tile_roof"] is "tile_roof"
SPR["tile_housewall"] is "tile_housewall"
SPR["tile_cave"] is "tile_cave"
SPR["tile_gold"] is "tile_gold"
SPR["tile_potion"] is "tile_potion"
SPR["tile_bridge"] is "tile_bridge"
SPR["tile_torch"] is "tile_torch"
SPR["knight"] is "knight"
SPR["knight2"] is "knight2"
SPR["goblin"] is "goblin"
SPR["goblin2"] is "goblin2"
SPR["ogre"] is "ogre"
SPR["ogre2"] is "ogre2"
SPR["warden"] is "warden"
SPR["warden2"] is "warden2"
SPR["merchant"] is "merchant"
SPR["elder"] is "elder"
SPR["villager0"] is "villager0"
SPR["villager1"] is "villager1"
SPR["wanderer"] is "wanderer"
SPR["rat"] is "rat"
SPR["rat2"] is "rat2"
SPR["bat"] is "bat"
SPR["bat2"] is "bat2"
SPR["well"] is "well"
SPR["stairs_down"] is "stairs_down"
SPR["stairs_sealed"] is "stairs_sealed"
SPR["ladder"] is "ladder"
SPR["shrine_might"] is "shrine_might"
SPR["shrine_vitality"] is "shrine_vitality"

to sprw_of with nm
    note Texture width for FPP billboard column math. The dark character set
    note is 32px; every tile stays 16px.
    if nm is "knight" then
        give back 32
    otherwise if nm is "knight2" then
        give back 32
    otherwise if nm is "goblin" then
        give back 32
    otherwise if nm is "goblin2" then
        give back 32
    otherwise if nm is "ogre" then
        give back 32
    otherwise if nm is "ogre2" then
        give back 32
    otherwise if nm is "rat" then
        give back 32
    otherwise if nm is "rat2" then
        give back 32
    otherwise if nm is "bat" then
        give back 32
    otherwise if nm is "bat2" then
        give back 32
    otherwise if nm is "warden" then
        give back 32
    otherwise if nm is "warden2" then
        give back 32
    otherwise if nm is "merchant" then
        give back 32
    otherwise if nm is "elder" then
        give back 32
    otherwise if nm is "villager0" then
        give back 32
    otherwise if nm is "villager1" then
        give back 32
    otherwise if nm is "wanderer" then
        give back 32
    give back 16

to rnd with n
    note Park-Miller LCG. n must be a positive whole number.
    G["seed"] is (G["seed"] * 16807) % 2147483647
    give back G["seed"] % n

to idiv with a and b
    note Whole-number division for non-negative a and positive b.
    q is 0
    r is a
    repeat while r is greater than b - 1
        r is r - b
        q is q + 1
    give back q

to ipart with v
    note Whole-number part of a non-negative float. Faster than idiv for pixels.
    q is 0
    r is v
    repeat while r is greater than 32
        r is r - 32
        q is q + 32
    repeat while r is greater than 1
        r is r - 1
        q is q + 1
    if r is 1 then
        q is q + 1
    give back q

to clamp with v and lo and hi
    if v is less than lo then
        give back lo
    if v is greater than hi then
        give back hi
    give back v

to absv with v
    if v is less than 0 then
        give back 0 - v
    give back v

to msg with t
    log is G["log"]
    push t to log
    if length of log is greater than 5 then
        nl is []
        i is 1
        repeat while i is less than length of log
            push log[i] to nl
            i is i + 1
        G["log"] is nl
    give back nothing

note ---- procedural sound: game logic emits commands, the driver plays them ----
note A tone is ["tone", f0, f1, dur_ms, wave, vol]; wave is square, saw, tri, sine.
note A burst is ["noise", dur_ms, vol]. The queue drains into OUT["snd"] each tick.

to tone with f0 and f1 and dur and wv and vol
    q is G["sndq"]
    push ["tone", f0, f1, dur, wv, vol] to q
    give back nothing

to hiss with dur and vol
    q is G["sndq"]
    push ["noise", dur, vol] to q
    give back nothing

to sfx with nm
    if nm is "swing" then
        hiss with 40 and 0.20
        tone with 320 and 140 and 70 and "saw" and 0.14
    otherwise if nm is "hit" then
        tone with 180 and 90 and 80 and "square" and 0.28
        hiss with 60 and 0.18
    otherwise if nm is "crit" then
        tone with 220 and 660 and 110 and "square" and 0.32
        tone with 660 and 990 and 90 and "square" and 0.26
    otherwise if nm is "kill" then
        tone with 300 and 60 and 150 and "saw" and 0.28
        hiss with 110 and 0.22
    otherwise if nm is "hurt" then
        tone with 140 and 70 and 130 and "saw" and 0.32
    otherwise if nm is "die" then
        tone with 220 and 40 and 700 and "saw" and 0.36
        hiss with 400 and 0.18
    otherwise if nm is "potion" then
        tone with 400 and 900 and 90 and "sine" and 0.28
        tone with 600 and 1200 and 90 and "sine" and 0.24
    otherwise if nm is "gold" then
        tone with 1250 and 1250 and 50 and "square" and 0.20
        tone with 1660 and 1660 and 70 and "square" and 0.20
    otherwise if nm is "stairs" then
        tone with 500 and 120 and 260 and "tri" and 0.28
    otherwise if nm is "surface" then
        tone with 120 and 500 and 260 and "tri" and 0.28
    otherwise if nm is "shrine" then
        tone with 523 and 523 and 90 and "sine" and 0.28
        tone with 659 and 659 and 90 and "sine" and 0.28
        tone with 784 and 784 and 140 and "sine" and 0.28
    otherwise if nm is "buy" then
        tone with 880 and 880 and 60 and "square" and 0.22
        tone with 1174 and 1174 and 80 and "square" and 0.22
    otherwise if nm is "bless" then
        tone with 523 and 1046 and 200 and "sine" and 0.28
        tone with 784 and 784 and 130 and "sine" and 0.24
    otherwise if nm is "bossdie" then
        tone with 330 and 55 and 600 and "saw" and 0.36
        hiss with 300 and 0.26
    otherwise if nm is "heal" then
        tone with 500 and 800 and 120 and "sine" and 0.24
    otherwise if nm is "error" then
        tone with 160 and 160 and 90 and "square" and 0.18
    otherwise if nm is "click" then
        tone with 700 and 700 and 40 and "square" and 0.14
    give back nothing

to seed_game with s
    G["seed"] is s
    was3d is G["gl3d"]
    G["diff"] is 2
    G["diffset"] is false
    G["dname"] is "DELVER"
    G["ehp"] is 100
    G["edmg"] is 100
    G["mode"] is "top"
    G["map"] is "over"
    G["gl3d"] is was3d
    G["hp"] is 100
    G["maxhp"] is 100
    G["atk"] is 12
    G["gold"] is 0
    G["potions"] is 1
    G["kills"] is 0
    G["depth"] is 0
    G["missions"] is 0
    G["tick"] is 0
    G["queue"] is []
    G["log"] is []
    G["over"] is false
    G["paused"] is false
    G["pface"] is 1
    G["pyaw"] is 0
    note Facing yaw for the 3D overworld knight model: 0 south, 1.5708 east.
    G["patk"] is 0 - 999
    G["pph"] is 0
    G["blessed"] is false
    G["parts"] is []
    G["floaters"] is []
    G["sndq"] is []
    G["shake"] is 0
    G["hitstop"] is 0
    G["flash"] is 0
    G["dying"] is 0
    G["shx"] is 0
    G["shy"] is 0
    G["enemies"] is []
    G["npcs"] is []
    G["items"] is []
    G["rooms"] is []
    G["eid"] is 0
    G["iid"] is 0
    G["px"] is 15
    G["py"] is 15
    G["lpx"] is 15
    G["lpy"] is 15
    G["block_npc"] is nothing
    G["sx"] is 0
    G["sy"] is 0
    G["upx"] is 0 - 1
    G["upy"] is 0 - 1
    G["locked"] is false
    G["mission"] is ""
    G["quest"] is ""
    G["fdx"] is 1
    G["fdy"] is 0
    G["ptx"] is 15
    G["pty"] is 15
    G["pfx"] is 0.5
    G["pfy"] is 0.5
    G["xcols"] is ["4a4a66", "3d3d52", "2a2a3a", "1e1e2a"]
    G["ycols"] is ["3d3d52", "2a2a3a", "1e1e2a", "14141e"]
    G["ceil"] is ["040410", "060616", "08081c", "0a0a22", "0c0c28", "0e0e2e", "101034", "12123a"]
    G["flor"] is ["1c1c26", "1a1a22", "181820", "16161e", "14141c", "12121a", "101018", "0e0e16"]
    gen_overworld
    msg with "Emberhold village. The cave mouth gapes east of the river."
    give back nothing

to set_difficulty with d
    note Called once after seed_game, before the first tick.
    note Rescales the (empty, at seed time) enemy list, sets player stock,
    note and stores the multipliers that mk_enemy and gen_floor use later.
    note The guard below keeps a second call from compounding enemy scaling.
    if G["diffset"] then
        give back nothing
    G["diffset"] is true
    G["diff"] is d
    if d is 1 then
        G["dname"] is "STORY"
        G["ehp"] is 60
        G["edmg"] is 60
        G["potions"] is 2
    otherwise if d is 3 then
        G["dname"] is "NIGHTMARE"
        G["ehp"] is 150
        G["edmg"] is 150
        G["potions"] is 0
        kept is []
        for each it in G["items"]
            if it["kind"] is "shrine" then
                skip
            push it to kept
        G["items"] is kept
    otherwise
        G["dname"] is "DELVER"
        G["ehp"] is 100
        G["edmg"] is 100
    for each e in G["enemies"]
        e["hp"] is idiv with e["hp"] * G["ehp"] and 100
        e["maxhp"] is idiv with e["maxhp"] * G["ehp"] and 100
        e["atk"] is idiv with e["atk"] * G["edmg"] and 100
        if e["hp"] is less than 1 then
            e["hp"] is 1
        if e["maxhp"] is less than 1 then
            e["maxhp"] is 1
        if e["atk"] is less than 1 then
            e["atk"] is 1
    msg with "Difficulty: " + G["dname"] + "."
    rebuild_dl
    refresh_out
    give back nothing

note ---- overworld: Emberhold village ----
note Terrain codes: 0 grass, 1 tree, 2 water, 3 path, 4 house, 5 well, 6 flowers, 7 cave.

to ov_set with x and y and c
    if x is less than 0 or x is greater than 59 or y is less than 0 or y is greater than 41 then
        give back nothing
    if G["grid"][y][x] is 0 or G["grid"][y][x] is 6 then
        G["grid"][y][x] is c
    give back nothing

to carve_path with x0 and y0 and x1 and y1
    x is x0
    y is y0
    repeat while x is not x1
        ov_set with x and y and 3
        if x1 is greater than x then
            x is x + 1
        otherwise
            x is x - 1
    repeat while y is not y1
        ov_set with x and y and 3
        if y1 is greater than y then
            y is y + 1
        otherwise
            y is y - 1
    ov_set with x and y and 3
    give back nothing

to ov_walk with x and y
    if x is less than 0 or x is greater than 59 or y is less than 0 or y is greater than 41 then
        give back false
    c is G["grid"][y][x]
    if c is 0 or c is 3 or c is 6 or c is 7 then
        give back true
    give back false

to ov_spot_near with x and y
    if ov_walk with x and y then
        s is a new table
        s["x"] is x
        s["y"] is y
        give back s
    if ov_walk with x + 1 and y then
        s is a new table
        s["x"] is x + 1
        s["y"] is y
        give back s
    if ov_walk with x - 1 and y then
        s is a new table
        s["x"] is x - 1
        s["y"] is y
        give back s
    if ov_walk with x and y + 1 then
        s is a new table
        s["x"] is x
        s["y"] is y + 1
        give back s
    if ov_walk with x and y - 1 then
        s is a new table
        s["x"] is x
        s["y"] is y - 1
        give back s
    give back nothing

to ov_free
    t is 0
    repeat while t is less than 200
        t is t + 1
        x is rnd with 60
        y is rnd with 42
        if ov_walk with x and y then
            e1 is entity_at with x and y
            it1 is item_at with x and y
            if e1 is nothing and it1 is nothing then
                s is a new table
                s["x"] is x
                s["y"] is y
                give back s
    give back nothing

to mk_ov_npc with nkind and nm and x and y
    s is ov_spot_near with x and y
    if s is nothing then
        give back nothing
    n is a new table
    n["kind"] is "npc"
    n["nkind"] is nkind
    n["name"] is nm
    n["x"] is s["x"]
    n["y"] is s["y"]
    n["tick"] is rnd with 4
    n["ph"] is rnd with 2
    n["used"] is false
    n["li"] is 0
    if nkind is "elder" then
        n["lines"] is ["The Deepdelve took my brother, and his gold with him.", "The cave east of the river breathes cold. That is the way down.", "Bring me 30 gold as an offering and I will bless your blade. (+2 attack)"]
    otherwise
        n["lines"] is ["Emberhold has stood a hundred years. The delve stood longer.", "They say a Warden sleeps on every third floor.", "My cousin sells potions down below. Twenty gold, no refunds."]
    ns is G["npcs"]
    push n to ns
    give back nothing

to npc_line with n
    ls is n["lines"]
    l is ls[n["li"] % length of ls]
    n["li"] is n["li"] + 1
    give back l

to gen_overworld
    G["map"] is "over"
    G["mode"] is "top"
    grid is []
    y is 0
    repeat 42 times
        row is []
        x is 0
        repeat 60 times
            push 0 to row
            x is x + 1
        push row to grid
        y is y + 1
    G["grid"] is grid
    c is 0
    repeat while c is less than 14
        cx is 2 + (rnd with 56)
        cy is 2 + (rnd with 38)
        tn is 3 + (rnd with 4)
        t is 0
        repeat while t is less than tn
            x is cx + (rnd with 3) - 1
            y is cy + (rnd with 3) - 1
            if x is greater than 0 and x is less than 59 and y is greater than 0 and y is less than 41 then
                if grid[y][x] is 0 then
                    grid[y][x] is 1
            t is t + 1
        c is c + 1
    rx is 26 + (rnd with 10)
    brx is rx
    y is 0
    repeat while y is less than 42
        grid[y][rx] is 2
        if rx + 1 is less than 59 then
            grid[y][rx + 1] is 2
        if y is 34 then
            brx is rx
        rx is rx + (rnd with 3) - 1
        if rx is less than 8 then
            rx is 8
        if rx is greater than 50 then
            rx is 50
        y is y + 1
    grid[34][brx] is 3
    if brx + 1 is less than 59 then
        grid[34][brx + 1] is 3
    wx is 14
    wy is 11
    qy is 0
    repeat while qy is less than 2
        qx is 0
        repeat while qx is less than 2
            if grid[wy + qy][wx + qx] is 0 then
                grid[wy + qy][wx + qx] is 5
            qx is qx + 1
        qy is qy + 1
    hi is 0
    repeat while hi is less than 4
        hx is 7 + (hi % 2) * 12 + (rnd with 3) - 1
        hy is 7 + (idiv with hi and 2) * 9 + (rnd with 3) - 1
        dy2 is 0
        repeat while dy2 is less than 4
            dx2 is 0
            repeat while dx2 is less than 5
                x is hx + dx2
                y is hy + dy2
                if x is greater than 0 and x is less than 59 and y is greater than 0 and y is less than 41 then
                    if grid[y][x] is 0 then
                        grid[y][x] is 4
                dx2 is dx2 + 1
            dy2 is dy2 + 1
        dx is hx + 2
        dy is hy + 4
        if dx is greater than 0 and dx is less than 59 and dy is greater than 0 and dy is less than 41 then
            if grid[dy][dx] is 0 then
                grid[dy][dx] is 3
            carve_path with dx and dy and wx and wy
        hi is hi + 1
    carve_path with wx and wy and brx and 34
    carve_path with brx + 2 and 34 and 48 and 34
    fx is 0
    repeat while fx is less than 40
        x is rnd with 60
        y is rnd with 42
        if grid[y][x] is 0 then
            grid[y][x] is 6
        fx is fx + 1
    grid[34][50] is 7
    grid[34][51] is 7
    grid[35][50] is 7
    grid[35][51] is 7
    G["npcs"] is []
    mk_ov_npc with "elder" and "Elder Marla" and wx + 2 and wy + 1
    nm1 is pick_name with 0
    mk_ov_npc with "villager" and nm1 and 8 and 14
    nm2 is pick_name with 0
    mk_ov_npc with "villager" and nm2 and 22 and 9
    G["enemies"] is []
    G["items"] is []
    i is 0
    repeat while i is less than 6
        s is ov_free
        if s is nothing then
            stop
        it is a new table
        it["x"] is s["x"]
        it["y"] is s["y"]
        G["iid"] is G["iid"] + 1
        it["id"] is G["iid"]
        it["kind"] is "gold"
        it["amt"] is 5 + (rnd with 10)
        im is G["items"]
        push it to im
        i is i + 1
    i is 0
    repeat while i is less than 3
        s is ov_free
        if s is nothing then
            stop
        it is a new table
        it["x"] is s["x"]
        it["y"] is s["y"]
        G["iid"] is G["iid"] + 1
        it["id"] is G["iid"]
        it["kind"] is "potion"
        im is G["items"]
        push it to im
        i is i + 1
    if grid[15][15] is not 0 then
        grid[15][15] is 0
    G["px"] is 15
    G["py"] is 15
    G["lpx"] is 15
    G["lpy"] is 15
    G["block_npc"] is nothing
    note Spawn clearing: the seed is random every run, so the knight must
    note never wake up boxed in by river, trees or houses. Pave the ring
    note around spawn to grass.
    cdx is 0 - 1
    repeat while cdx is less than 2
        cdy is 0 - 1
        repeat while cdy is less than 2
            cw is ov_walk with 15 + cdx and 15 + cdy
            if cw is false then
                grid[15 + cdy][15 + cdx] is 0
            cdy is cdy + 1
        cdx is cdx + 1
    note River repair: the river meanders, so the carved village path can
    note hit water where ov_set refused to pave, cutting the cave off.
    note Pave any water on the route so the cave is always reachable.
    ry is 11
    repeat while ry is less than 35
        if grid[ry][brx] is 2 then
            grid[ry][brx] is 3
        if grid[ry][brx + 1] is 2 then
            grid[ry][brx + 1] is 3
        ry is ry + 1
    rx3 is 14
    repeat while rx3 is less than brx + 1
        if grid[11][rx3] is 2 then
            grid[11][rx3] is 3
        rx3 is rx3 + 1
    rx4 is brx
    repeat while rx4 is less than 50
        if grid[34][rx4] is 2 then
            grid[34][rx4] is 3
        rx4 is rx4 + 1
    G["ptx"] is 15
    G["pty"] is 15
    G["pfx"] is 0.5
    G["pfy"] is 0.5
    G["fdx"] is 1
    G["fdy"] is 0
    G["pface"] is 1
    G["mission"] is "Explore Emberhold. Find the cave east of the river."
    give back nothing

to enter_dungeon
    G["map"] is "dungeon"
    G["mode"] is "top"
    sfx with "stairs"
    gen_floor with 1
    sync_fpp
    msg with "You squeeze through the cave mouth into the dark."
    msg with "Depth 1. " + G["mission"]
    give back nothing

to sync_fpp
    G["ptx"] is G["px"]
    G["pty"] is G["py"]
    G["pfx"] is 0.5
    G["pfy"] is 0.5
    G["fdx"] is 1
    G["fdy"] is 0
    give back nothing

note ---- dungeon generation (map-aware) ----

to carve with x and y
    if x is greater than 0 and x is less than 59 and y is greater than 0 and y is less than 41 then
        row is G["grid"][y]
        row[x] is 0
    give back nothing

to is_wall with x and y
    if x is less than 0 then
        give back true
    if y is less than 0 then
        give back true
    if x is greater than 59 then
        give back true
    if y is greater than 41 then
        give back true
    if G["map"] is "over" then
        c is G["grid"][y][x]
        if c is 1 or c is 2 or c is 4 or c is 5 then
            give back true
        give back false
    if G["grid"][y][x] is 1 then
        give back true
    give back false

to entity_at with x and y
    for each e in G["enemies"]
        if e["x"] is x and e["y"] is y then
            give back e
    for each n in G["npcs"]
        if n["x"] is x and n["y"] is y then
            give back n
    give back nothing

to item_at with x and y
    for each it in G["items"]
        if it["x"] is x and it["y"] is y then
            give back it
    give back nothing

to grid_open with x and y
    if G["map"] is "over" then
        w is ov_walk with x and y
        if w is false then
            give back false
    otherwise if G["grid"][y][x] is not 0 then
        give back false
    e is entity_at with x and y
    if e is not nothing then
        give back false
    it is item_at with x and y
    if it is not nothing then
        give back false
    give back true

to free_spot
    t is 0
    repeat while t is less than 300
        t is t + 1
        rooms is G["rooms"]
        r is rooms[rnd with length of rooms]
        x is r["x"] + (rnd with r["w"])
        y is r["y"] + (rnd with r["h"])
        if grid_open with x and y then
            s is a new table
            s["x"] is x
            s["y"] is y
            give back s
    give back nothing

to mk_enemy with et and x and y
    e is a new table
    e["kind"] is "enemy"
    e["type"] is et
    e["x"] is x
    e["y"] is y
    e["tick"] is rnd with 3
    e["ph"] is 0
    e["face"] is 1
    e["boss"] is false
    e["atkT"] is 0 - 999
    e["flash"] is 0
    e["kb"] is 0
    e["kbx"] is 0
    e["kby"] is 0
    G["eid"] is G["eid"] + 1
    e["id"] is G["eid"]
    d is G["depth"]
    hpct is G["ehp"]
    dpct is G["edmg"]
    if et is "rat" then
        e["name"] is "Cave Rat"
        e["hp"] is idiv with (14 + (idiv with d * 5 and 2)) * hpct and 100
        e["atk"] is idiv with (4 + (idiv with d * 4 and 5)) * dpct and 100
        e["rate"] is 3
    otherwise if et is "bat" then
        e["name"] is "Gloom Bat"
        e["hp"] is idiv with (10 + (idiv with d * 5 and 2)) * hpct and 100
        e["atk"] is idiv with (5 + (idiv with d * 4 and 5)) * dpct and 100
        e["rate"] is 1
    otherwise if et is "goblin" then
        e["name"] is "Goblin"
        e["hp"] is idiv with (26 + (idiv with d * 5 and 2)) * hpct and 100
        e["atk"] is idiv with (7 + (idiv with d * 4 and 5)) * dpct and 100
        e["rate"] is 2
    otherwise if et is "ogre" then
        e["name"] is "Deep Ogre"
        e["hp"] is idiv with (55 + (idiv with d * 5 and 2)) * hpct and 100
        e["atk"] is idiv with (11 + (idiv with d * 4 and 5)) * dpct and 100
        e["rate"] is 3
    otherwise
        e["name"] is "Deep Warden"
        e["hp"] is idiv with (120 + d * 12) * hpct and 100
        e["maxhp"] is idiv with (120 + d * 12) * hpct and 100
        e["atk"] is idiv with (14 + d) * dpct and 100
        e["rate"] is 2
        e["boss"] is true
    if e["hp"] is less than 1 then
        e["hp"] is 1
    if e["atk"] is less than 1 then
        e["atk"] is 1
    if et is not "warden" then
        e["maxhp"] is e["hp"]
    es is G["enemies"]
    push e to es
    give back nothing

to pick_name with which
    i is rnd with 4
    if which is 1 then
        if i is 0 then
            give back "Sable"
        if i is 1 then
            give back "Old Fen"
        if i is 2 then
            give back "Marla"
        give back "Garr"
    if i is 0 then
        give back "Wren"
    if i is 1 then
        give back "Pip"
    if i is 2 then
        give back "Sage"
    give back "Dain"

to hint
    i is rnd with 6
    if i is 0 then
        give back "Wardens sleep on every third floor. Wake them and the stairs stay shut."
    if i is 1 then
        give back "Merchants love gold. Twenty coins buys a full heal in a bottle."
    if i is 2 then
        give back "Rats are weak but they travel in packs. Keep moving."
    if i is 3 then
        give back "Bats are fast and stupid. Let them come to you."
    if i is 4 then
        give back "Shrines hum with old power. Touch one if you dare."
    give back "The deeper you go, the meaner it gets. That is the whole deal."

to gen_floor with d
    G["map"] is "dungeon"
    G["depth"] is d
    G["block_npc"] is nothing
    mw is 60
    mh is 42
    grid is []
    y is 0
    repeat mh times
        row is []
        x is 0
        repeat mw times
            push 1 to row
            x is x + 1
        push row to grid
        y is y + 1
    G["grid"] is grid
    rooms is []
    tries is 0
    repeat while length of rooms is less than 11
        tries is tries + 1
        if tries is greater than 200 then
            stop
        w is 5 + (rnd with 7)
        h is 4 + (rnd with 5)
        x is 1 + (rnd with (mw - w - 2))
        y is 1 + (rnd with (mh - h - 2))
        ok is true
        for each r in rooms
            if x is less than r["x"] + r["w"] + 1 and x + w + 1 is greater than r["x"] and y is less than r["y"] + r["h"] + 1 and y + h + 1 is greater than r["y"] then
                ok is false
        if ok then
            nr is a new table
            nr["x"] is x
            nr["y"] is y
            nr["w"] is w
            nr["h"] is h
            nr["cx"] is x + (idiv with w and 2)
            nr["cy"] is y + (idiv with h and 2)
            push nr to rooms
    G["rooms"] is rooms
    ri is 0
    repeat while ri is less than length of rooms
        rm is rooms[ri]
        yy is rm["y"]
        repeat while yy is less than rm["y"] + rm["h"]
            xx is rm["x"]
            repeat while xx is less than rm["x"] + rm["w"]
                carve with xx and yy
                xx is xx + 1
            yy is yy + 1
        if ri is greater than 0 then
            pr is rooms[ri - 1]
            cx is pr["cx"]
            cy is pr["cy"]
            repeat while cx is not rm["cx"]
                carve with cx and cy
                if rm["cx"] is greater than cx then
                    cx is cx + 1
                otherwise
                    cx is cx - 1
            repeat while cy is not rm["cy"]
                carve with cx and cy
                if rm["cy"] is greater than cy then
                    cy is cy + 1
                otherwise
                    cy is cy - 1
            carve with cx and cy
        ri is ri + 1
    note Precompute FPP minimap cells: corridor floor tiles not inside a room.
    note Rooms are drawn as rects at tick time; this one-time pass costs about
    note 27k checks at floor gen so the per-tick draw stays O(cells).
    corr is []
    yy2 is 0
    repeat while yy2 is less than 42
        xx2 is 0
        repeat while xx2 is less than 60
            if grid[yy2][xx2] is 0 then
                inroom is false
                for each r in rooms
                    if xx2 is at least r["x"] and xx2 is less than r["x"] + r["w"] and yy2 is at least r["y"] and yy2 is less than r["y"] + r["h"] then
                        inroom is true
                if inroom is false then
                    cell is [xx2, yy2]
                    push cell to corr
            xx2 is xx2 + 1
        yy2 is yy2 + 1
    G["mmap_corr"] is corr
    isboss is false
    if d % 3 is 0 then
        isboss is true
    r0 is rooms[0]
    G["px"] is r0["cx"]
    G["py"] is r0["cy"]
    rl is rooms[length of rooms - 1]
    G["sx"] is rl["cx"]
    G["sy"] is rl["cy"]
    G["locked"] is isboss
    G["upx"] is 0 - 1
    G["upy"] is 0 - 1
    if d is 1 then
        s is free_spot
        if s is not nothing then
            note Keep the rope ladder away from the spawn: surfacing on the
            note first step feels like the dungeon rejected the player.
            t2 is 0
            repeat while t2 is less than 40
                dx2 is absv with s["x"] - G["px"]
                dy2 is absv with s["y"] - G["py"]
                if dx2 is greater than 1 or dy2 is greater than 1 then
                    stop
                s is free_spot
                if s is nothing then
                    stop
                t2 is t2 + 1
            if s is not nothing then
                if s["x"] is G["sx"] and s["y"] is G["sy"] then
                    s["x"] is s["x"] + 1
                G["upx"] is s["x"]
                G["upy"] is s["y"]
    if isboss then
        G["mission"] is "Slay the Deep Warden, then take the stairs down."
        G["quest"] is "Slay the Deep Warden"
    otherwise
        G["mission"] is "Find the stairs and descend."
        G["quest"] is ""
    G["enemies"] is []
    ne is 4 + d * 2
    if ne is greater than 22 then
        ne is 22
    i is 0
    repeat while i is less than ne
        s is free_spot
        if s is nothing then
            stop
        r is rnd with 100
        et is "rat"
        if d is greater than 3 and r is less than 22 then
            et is "ogre"
        otherwise if d is greater than 1 and r is less than 50 then
            et is "goblin"
        otherwise if r is less than 72 then
            et is "bat"
        mk_enemy with et and s["x"] and s["y"]
        i is i + 1
    if isboss then
        s is free_spot
        if s is nothing then
            s is a new table
            s["x"] is G["sx"]
            s["y"] is G["sy"]
        mk_enemy with "warden" and s["x"] and s["y"]
    G["npcs"] is []
    nn is 1 + (rnd with 2)
    i is 0
    repeat while i is less than nn
        s is free_spot
        if s is nothing then
            stop
        nkind is "wanderer"
        rk is rnd with 100
        if rk is less than 45 then
            nkind is "merchant"
        if isboss and nkind is "merchant" then
            rk2 is rnd with 100
            if rk2 is less than 50 then
                nkind is "wanderer"
        n is a new table
        n["kind"] is "npc"
        n["nkind"] is nkind
        n["x"] is s["x"]
        n["y"] is s["y"]
        n["used"] is false
        n["tick"] is rnd with 4
        n["ph"] is 0
        n["li"] is 0
        if nkind is "merchant" then
            n["name"] is pick_name with 1
        otherwise
            n["name"] is pick_name with 0
        ns is G["npcs"]
        push n to ns
        i is i + 1
    G["items"] is []
    ni is 5 + (rnd with 4)
    i is 0
    repeat while i is less than ni
        s is free_spot
        if s is nothing then
            stop
        it is a new table
        it["x"] is s["x"]
        it["y"] is s["y"]
        G["iid"] is G["iid"] + 1
        it["id"] is G["iid"]
        r70 is rnd with 100
        if r70 is less than 70 then
            it["kind"] is "gold"
            it["amt"] is 5 + (rnd with (6 + d * 3))
        otherwise
            it["kind"] is "potion"
        im is G["items"]
        push it to im
        i is i + 1
    shrine_chance is 55
    if G["diff"] is 3 then
        shrine_chance is 20
    r55 is rnd with 100
    if r55 is less than shrine_chance then
        s is free_spot
        if s is not nothing then
            it is a new table
            it["x"] is s["x"]
            it["y"] is s["y"]
            it["kind"] is "shrine"
            G["iid"] is G["iid"] + 1
            it["id"] is G["iid"]
            rb is rnd with 2
            if rb is 0 then
                it["boon"] is "might"
            otherwise
                it["boon"] is "vitality"
            im is G["items"]
            push it to im
    give back nothing

note ---- driver interface and game actions ----

to press with k
    q is G["queue"]
    push k to q
    give back nothing

to tick
    if G["over"] then
        note The run is over; the driver shows the overlay. Hold the last frame.
        rebuild_dl
        refresh_out
        give back nothing
    if G["paused"] then
        note Paused: the world clock freezes. Only P unpauses, queued moves are dropped.
        n is 0
        repeat while n is less than 3
            if length of G["queue"] is 0 then
                stop
            k is G["queue"][0]
            nq is []
            i is 1
            repeat while i is less than length of G["queue"]
                push G["queue"][i] to nq
                i is i + 1
            G["queue"] is nq
            if k is "p" then
                handle_key with k
            n is n + 1
        rebuild_dl
        if G["paused"] then
            draw_pause_overlay
        refresh_out
        give back nothing
    G["tick"] is G["tick"] + 1
    if G["hitstop"] is greater than 0 then
        note Hit-stop: freeze frames on heavy hits. World holds, particles drift.
        G["hitstop"] is G["hitstop"] - 1
        tick_parts
        tick_floaters
        rebuild_dl
        refresh_out
        give back nothing
    if G["dying"] is greater than 0 then
        note Death delay: let the burst play before the YOU DIED overlay.
        G["dying"] is G["dying"] - 1
        tick_parts
        tick_floaters
        rebuild_dl
        refresh_out
        if G["dying"] is 0 then
            G["over"] is true
            refresh_out
        give back nothing
    n is 0
    repeat while n is less than 3
        if length of G["queue"] is 0 then
            stop
        k is G["queue"][0]
        nq is []
        i is 1
        repeat while i is less than length of G["queue"]
            push G["queue"][i] to nq
            i is i + 1
        G["queue"] is nq
        handle_key with k
        if G["over"] then
            stop
        n is n + 1
    if G["over"] is false then
        enemy_ai
    tick_parts
    tick_floaters
    rebuild_dl
    if G["paused"] then
        note Pause engaged on this tick: stamp the overlay now, not next tick.
        draw_pause_overlay
    refresh_out
    give back nothing

to toggle_mode
    if G["map"] is not "dungeon" then
        msg with "The open sky needs no magic eye."
        give back nothing
    if G["mode"] is "top" then
        G["mode"] is "fpp"
        sync_fpp
        sfx with "click"
        msg with "First-person sight. W/S walk, A/D turn, M to return."
    otherwise
        G["mode"] is "top"
        sfx with "click"
        msg with "Bird's-eye sight."
    give back nothing

to toggle_pause
    if G["paused"] then
        G["paused"] is false
        sfx with "click"
        msg with "Resumed."
    otherwise
        G["paused"] is true
        sfx with "click"
        msg with "Paused. Press P to resume."
    give back nothing

to handle_key with k
    if k is "p" then
        toggle_pause
        give back nothing
    if k is "m" then
        toggle_mode
        give back nothing
    if G["mode"] is "fpp" then
        if k is "w" then
            fpp_step with 0.35
        otherwise if k is "s" then
            fpp_step with 0 - 0.35
        otherwise if k is "a" then
            fpp_turn with 0 - 1
        otherwise if k is "d" then
            fpp_turn with 1
        otherwise if k is " " or k is "space" then
            attack_all
        otherwise if k is "e" then
            interact
        otherwise if k is "q" then
            drink_potion
        give back nothing
    if k is "w" then
        try_move with 0 and 0 - 1
        give back nothing
    if k is "s" then
        try_move with 0 and 1
        give back nothing
    if k is "a" then
        G["pface"] is 0 - 1
        try_move with 0 - 1 and 0
        give back nothing
    if k is "d" then
        G["pface"] is 1
        try_move with 1 and 0
        give back nothing
    if k is " " or k is "space" then
        attack_all
        give back nothing
    if k is "e" then
        interact
        give back nothing
    if k is "q" then
        drink_potion
        give back nothing
    give back nothing

to fpp_turn with dirn
    c is 0.96593
    if dirn is 1 then
        s is 0.25882
    otherwise
        s is 0 - 0.25882
    nx is G["fdx"] * c - G["fdy"] * s
    ny is G["fdx"] * s + G["fdy"] * c
    G["fdx"] is nx
    G["fdy"] is ny
    give back nothing

to try_axis with dx and dy
    nx is G["pfx"] + dx
    ny is G["pfy"] + dy
    tx is G["ptx"]
    ty is G["pty"]
    if nx is less than 0 then
        if is_wall with tx - 1 and ty then
            give back nothing
        G["ptx"] is tx - 1
        G["pfx"] is nx + 1
        give back nothing
    if nx is greater than 0.999999 then
        if is_wall with tx + 1 and ty then
            give back nothing
        G["ptx"] is tx + 1
        G["pfx"] is nx - 1
        give back nothing
    if ny is less than 0 then
        if is_wall with tx and ty - 1 then
            give back nothing
        G["pty"] is ty - 1
        G["pfy"] is ny + 1
        give back nothing
    if ny is greater than 0.999999 then
        if is_wall with tx and ty + 1 then
            give back nothing
        G["pty"] is ty + 1
        G["pfy"] is ny - 1
        give back nothing
    G["pfx"] is nx
    G["pfy"] is ny
    give back nothing

to fpp_step with amt
    G["pph"] is G["pph"] + 1
    ox is G["ptx"]
    oy is G["pty"]
    try_axis with G["fdx"] * amt and 0
    try_axis with 0 and G["fdy"] * amt
    G["px"] is G["ptx"]
    G["py"] is G["pty"]
    e is entity_at with G["ptx"] and G["pty"]
    if e is not nothing and e["kind"] is "enemy" then
        G["ptx"] is ox
        G["pty"] is oy
        G["pfx"] is 0.5
        G["pfy"] is 0.5
        G["px"] is ox
        G["py"] is oy
        player_attack with e
        give back nothing
    it is item_at with G["ptx"] and G["pty"]
    if it is not nothing then
        take_item with it
    if G["ptx"] is G["sx"] and G["pty"] is G["sy"] then
        if G["locked"] then
            G["ptx"] is ox
            G["pty"] is oy
            G["pfx"] is 0.5
            G["pfy"] is 0.5
            G["px"] is ox
            G["py"] is oy
            msg with "The stairs are sealed. Slay the Deep Warden first."
            give back nothing
        enter_stairs
        give back nothing
    if G["depth"] is 1 and G["ptx"] is G["upx"] and G["pty"] is G["upy"] then
        if G["ptx"] is not ox or G["pty"] is not oy then
            note Only surface when this step actually moved onto the ladder.
            note Standing still on it (even against a wall) must not surface.
            msg with "You climb the rope back to Emberhold."
            gen_overworld
            give back nothing
    give back nothing

to enter_stairs
    G["missions"] is G["missions"] + 1
    sfx with "stairs"
    msg with "Mission complete. Descending..."
    G["flash"] is 12
    i is 0
    repeat while i is less than 8
        spawn_part with G["px"] and G["py"] and "ffffff" and 8
        spawn_part with G["px"] and G["py"] and "ffd75e" and 8
        i is i + 1
    gen_floor with G["depth"] + 1
    sync_fpp
    msg with "Depth " + (text of G["depth"]) + ". " + G["mission"]
    if G["depth"] % 3 is 0 then
        msg with "The air grows cold. The Deep Warden stirs."
    give back nothing

to try_move with dx and dy
    if G["map"] is "over" then
        w is ov_walk with G["px"] and G["py"]
        if w is false then
            note Rescue: the knight somehow stands on an unwalkable tile.
            note Step to the last walkable tile, or the nearest one, so
            note movement can never die while other keys keep working.
            wl is ov_walk with G["lpx"] and G["lpy"]
            if wl is false then
                s is rescue_spot
                if s is not nothing then
                    G["px"] is s["x"]
                    G["py"] is s["y"]
                    G["lpx"] is s["x"]
                    G["lpy"] is s["y"]
            otherwise
                G["px"] is G["lpx"]
                G["py"] is G["lpy"]
            msg with "You scramble back to solid ground."
            give back nothing
    note Face the direction of travel for the 3D overworld view.
    if dx is greater than 0 then
        G["pyaw"] is 1.5708
    otherwise if dx is less than 0 then
        G["pyaw"] is 4.7124
    otherwise if dy is greater than 0 then
        G["pyaw"] is 0
    otherwise if dy is less than 0 then
        G["pyaw"] is 3.1416
    nx is G["px"] + dx
    ny is G["py"] + dy
    if is_wall with nx and ny then
        give back nothing
    if G["map"] is "over" then
        w2 is ov_walk with nx and ny
        if w2 is false then
            give back nothing
    e is entity_at with nx and ny
    if e is not nothing and e["kind"] is "enemy" then
        player_attack with e
        give back nothing
    if G["map"] is "over" and G["grid"][ny][nx] is 7 then
        note The cave mouth always wins: no NPC can block the descent.
        enter_dungeon
        give back nothing
    if G["map"] is "dungeon" and G["depth"] is 1 and nx is G["upx"] and ny is G["upy"] then
        note The rope ladder always wins: no NPC can block the climb.
        msg with "You climb the rope back to Emberhold."
        sfx with "surface"
        gen_overworld
        give back nothing
    if G["map"] is "dungeon" and nx is G["sx"] and ny is G["sy"] then
        if G["locked"] then
            sfx with "error"
            msg with "The stairs are sealed. Slay the Deep Warden first."
            give back nothing
        enter_stairs
        give back nothing
    if e is not nothing then
        note Remember the blocker so E always reaches them, even if they
        note wander a step before the player presses it.
        G["block_npc"] is e
        msg with e["name"] + " blocks the way. Press E to talk."
        give back nothing
    G["pph"] is G["pph"] + 1
    if G["map"] is "over" then
        it is item_at with nx and ny
        if it is not nothing then
            take_item with it
        G["px"] is nx
        G["py"] is ny
        G["lpx"] is nx
        G["lpy"] is ny
        G["block_npc"] is nothing
        give back nothing
    it is item_at with nx and ny
    if it is not nothing then
        take_item with it
    G["px"] is nx
    G["py"] is ny
    G["block_npc"] is nothing
    give back nothing

to rescue_spot
    note Spiral out from the knight for the nearest walkable tile.
    r is 1
    repeat while r is less than 12
        dx is 0 - r
        repeat while dx is less than r + 1
            dy is 0 - r
            repeat while dy is less than r + 1
                cx is G["px"] + dx
                cy is G["py"] + dy
                w is ov_walk with cx and cy
                if w is false then
                    dy is dy + 1
                otherwise
                    s is a new table
                    s["x"] is cx
                    s["y"] is cy
                    give back s
            dx is dx + 1
        r is r + 1
    give back nothing

to player_attack with e
    r4 is rnd with 4
    dmg is G["atk"] + r4
    crit is false
    if r4 is 3 then
        crit is true
        dmg is ipart with (dmg * 3) / 2
    e["hp"] is e["hp"] - dmg
    e["flash"] is 2
    kbx is 0
    if e["x"] is greater than G["px"] then
        kbx is 2
    otherwise if e["x"] is less than G["px"] then
        kbx is 0 - 2
    kby is 0
    if e["y"] is greater than G["py"] then
        kby is 2
    otherwise if e["y"] is less than G["py"] then
        kby is 0 - 2
    e["kbx"] is kbx
    e["kby"] is kby
    e["kb"] is 3
    G["patk"] is G["tick"]
    sfx with "swing"
    spawn_part with e["x"] and e["y"] and "ffd75e" and 4
    if crit then
        spawn_floater with e["x"] and e["y"] and ("CRIT " + (text of dmg)) and "ffd75e" and 22
        G["shake"] is G["shake"] + 2
        G["hitstop"] is 2
        sfx with "crit"
        msg with "Critical hit! " + (text of dmg) + " to the " + e["name"] + "."
    otherwise
        spawn_floater with e["x"] and e["y"] and (text of dmg) and "ffffff" and 18
        sfx with "hit"
        msg with "You hit the " + e["name"] + " for " + (text of dmg) + "."
    if e["hp"] is less than 1 then
        kill_enemy with e
    give back nothing

to kill_enemy with e
    kept is []
    for each x in G["enemies"]
        if x["id"] is e["id"] then
            skip
        push x to kept
    G["enemies"] is kept
    G["kills"] is G["kills"] + 1
    spawn_part with e["x"] and e["y"] and "ffb02a" and 6
    spawn_part with e["x"] and e["y"] and "ff5a2a" and 5
    loot is 3 + (rnd with 6) + (idiv with G["depth"] * 3 and 2)
    if e["boss"] then
        loot is 60 + G["depth"] * 10
        G["locked"] is false
        G["mission"] is "Warden slain. Take the stairs down."
        G["quest"] is ""
        G["missions"] is G["missions"] + 1
        G["shake"] is 10
        G["hitstop"] is 4
        i is 0
        repeat while i is less than 12
            spawn_part with e["x"] and e["y"] and "ffd75e" and 12
            i is i + 1
        spawn_floater with e["x"] and e["y"] and ("+" + (text of loot) + " gold") and "ffd75e" and 26
        msg with "The Deep Warden falls. The stairs grind open."
        msg with "The Warden's hoard: +" + (text of loot) + " gold."
        sfx with "bossdie"
    otherwise
        msg with "The " + e["name"] + " dies. +" + (text of loot) + " gold."
        sfx with "kill"
    G["gold"] is G["gold"] + loot
    give back nothing

to hurt_player with dmg and nm
    G["hp"] is G["hp"] - dmg
    spawn_part with G["px"] and G["py"] and "e03030" and 5
    spawn_floater with G["px"] and G["py"] and (text of dmg) and "ff5a5a" and 18
    G["shake"] is G["shake"] + 3
    msg with nm + " hits you for " + (text of dmg) + "."
    if G["hp"] is less than 1 then
        G["hp"] is 0
        G["dying"] is 30
        G["shake"] is 10
        i is 0
        repeat while i is less than 12
            spawn_part with G["px"] and G["py"] and "ff5a5a" and 10
            spawn_part with G["px"] and G["py"] and "ffffff" and 8
            i is i + 1
        sfx with "die"
        msg with "You died in the deep."
    otherwise
        sfx with "hurt"
    give back nothing

to attack_all
    hit is false
    copy is []
    for each e in G["enemies"]
        push e to copy
    for each e in copy
        ax is absv with e["x"] - G["px"]
        ay is absv with e["y"] - G["py"]
        if ax is less than 2 and ay is less than 2 then
            player_attack with e
            hit is true
    if hit is false then
        sfx with "swing"
        msg with "You swing at empty air."
    give back nothing

to drink_potion
    if G["potions"] is less than 1 then
        sfx with "error"
        msg with "No potions left."
        give back nothing
    if G["hp"] is G["maxhp"] then
        sfx with "error"
        msg with "Already at full health."
        give back nothing
    G["potions"] is G["potions"] - 1
    healed is 40
    if G["hp"] + 40 is greater than G["maxhp"] then
        healed is G["maxhp"] - G["hp"]
    G["hp"] is G["hp"] + 40
    if G["hp"] is greater than G["maxhp"] then
        G["hp"] is G["maxhp"]
    spawn_part with G["px"] and G["py"] and "8fd6ff" and 6
    spawn_part with G["px"] and G["py"] and "bfe9ff" and 5
    sfx with "potion"
    msg with "You drink a potion. +" + (text of healed) + " HP."
    give back nothing

to adjacent_npc
    for each n in G["npcs"]
        ax is absv with n["x"] - G["px"]
        ay is absv with n["y"] - G["py"]
        if ax is less than 2 and ay is less than 2 then
            give back n
    give back nothing

to interact
    if G["map"] is "dungeon" then
        stx is G["sx"]
        sty is G["sy"]
        ax is absv with G["px"] - stx
        ay is absv with G["py"] - sty
        if ax is less than 2 and ay is less than 2 then
            if G["px"] is not stx or G["py"] is not sty then
                dx is stx - G["px"]
                dy is sty - G["py"]
                if dx is greater than 1 then
                    dx is 1
                if dx is less than 0 - 1 then
                    dx is 0 - 1
                if dy is greater than 1 then
                    dy is 1
                if dy is less than 0 - 1 then
                    dy is 0 - 1
                try_move with dx and dy
                give back nothing
    n is nothing
    bn is G["block_npc"]
    if bn is not nothing then
        note The NPC that just blocked the way answers E, no matter where
        note they wandered. This is what stops every NPC soft-lock.
        n is bn
    if n is nothing then
        n is adjacent_npc
    G["block_npc"] is nothing
    if n is nothing then
        msg with "Nobody to talk to here."
        give back nothing
    note The blocker steps aside after you talk, so the way stays open.
    if bn is not nothing then
        sx is n["x"] - G["px"]
        sy is n["y"] - G["py"]
        if sx is not 0 then
            sx is sx / absv with sx
        if sy is not 0 then
            sy is sy / absv with sy
        moved is false
        dx is sx
        dy is sy
        if grid_open with n["x"] + dx and n["y"] + dy then
            n["x"] is n["x"] + dx
            n["y"] is n["y"] + dy
            moved is true
        if moved is false then
            if grid_open with n["x"] + 1 and n["y"] then
                n["x"] is n["x"] + 1
                moved is true
            otherwise if grid_open with n["x"] - 1 and n["y"] then
                n["x"] is n["x"] - 1
                moved is true
            otherwise if grid_open with n["x"] and n["y"] + 1 then
                n["y"] is n["y"] + 1
                moved is true
            otherwise if grid_open with n["x"] and n["y"] - 1 then
                n["y"] is n["y"] - 1
                moved is true
    if n["nkind"] is "elder" then
        if G["blessed"] is false then
            G["quest"] is "Bring Elder Marla 30 gold for her blessing"
        if G["blessed"] is false and G["gold"] is greater than 29 then
            G["gold"] is G["gold"] - 30
            G["atk"] is G["atk"] + 2
            G["blessed"] is true
            G["quest"] is ""
            spawn_part with n["x"] and n["y"] and "ffe75a" and 8
            spawn_floater with n["x"] and n["y"] and "Blessed! Atk +2" and "ffe75a" and 24
            sfx with "bless"
            msg with "Elder Marla accepts the offering and blesses your blade. Attack +2."
            give back nothing
        msg with "Elder Marla: " + npc_line with n
        give back nothing
    if n["nkind"] is "villager" then
        msg with n["name"] + ": " + npc_line with n
        give back nothing
    if n["nkind"] is "merchant" then
        if G["gold"] is greater than 19 then
            G["gold"] is G["gold"] - 20
            G["potions"] is G["potions"] + 1
            sfx with "buy"
            msg with n["name"] + ": Pleasure doing business. One potion, good as new."
        otherwise
            msg with n["name"] + " the merchant: Potions, 20 gold. Come back richer, delver."
    otherwise
        if n["used"] is false then
            n["used"] is true
            G["hp"] is G["hp"] + 30
            if G["hp"] is greater than G["maxhp"] then
                G["hp"] is G["maxhp"]
            sfx with "heal"
            msg with n["name"] + " the wanderer shares a tale. You feel restored. +30 HP."
            msg with hint
        otherwise
            msg with n["name"] + " the wanderer: " + hint
    give back nothing

to take_item with it
    kept is []
    for each x in G["items"]
        if x["id"] is it["id"] then
            skip
        push x to kept
    G["items"] is kept
    if it["kind"] is "gold" then
        G["gold"] is G["gold"] + it["amt"]
        spawn_floater with G["px"] and G["py"] and ("+" + (text of it["amt"]) + " gold") and "ffd75e" and 20
        sfx with "gold"
        msg with "Picked up " + (text of it["amt"]) + " gold."
    otherwise if it["kind"] is "potion" then
        G["potions"] is G["potions"] + 1
        spawn_floater with G["px"] and G["py"] and "+1 potion" and "7df0a8" and 20
        sfx with "click"
        msg with "Found a healing potion. Press Q to drink."
    otherwise
        spawn_part with it["x"] and it["y"] and "4ae08a" and 7
        if it["boon"] is "might" then
            G["atk"] is G["atk"] + 2
            spawn_floater with G["px"] and G["py"] and "Might +2" and "ff9a3c" and 20
            sfx with "shrine"
            msg with "Shrine of Might: attack +2."
        otherwise
            G["maxhp"] is G["maxhp"] + 10
            G["hp"] is G["hp"] + 10
            if G["hp"] is greater than G["maxhp"] then
                G["hp"] is G["maxhp"]
            spawn_floater with G["px"] and G["py"] and "Vitality +10" and "ff9a3c" and 20
            sfx with "shrine"
            msg with "Shrine of Vitality: max HP +10."
    give back nothing

to enemy_ai
    for each e in G["enemies"]
        if e["flash"] is greater than 0 then
            e["flash"] is e["flash"] - 1
        if e["kb"] is greater than 0 then
            e["kb"] is e["kb"] - 1
        e["tick"] is e["tick"] + 1
        if e["tick"] is less than e["rate"] then
            skip
        e["tick"] is 0
        dx is G["px"] - e["x"]
        dy is G["py"] - e["y"]
        dist is (absv with dx) + (absv with dy)
        if dist is 1 then
            r3 is rnd with 3
            dmg is e["atk"] + r3
            e["atkT"] is G["tick"]
            hurt_player with dmg and e["name"]
            skip
        chaser is false
        if e["type"] is "goblin" or e["type"] is "ogre" or e["type"] is "warden" then
            chaser is true
        mx is 0
        my is 0
        if chaser and dist is less than 10 then
            adx is absv with dx
            ady is absv with dy
            if adx is greater than ady then
                if dx is greater than 0 then
                    mx is 1
                otherwise
                    mx is 0 - 1
            otherwise
                if dy is greater than 0 then
                    my is 1
                otherwise
                    my is 0 - 1
            r25 is rnd with 100
            if r25 is less than 25 then
                mx is (rnd with 3) - 1
                if mx is 0 then
                    my is (rnd with 3) - 1
                otherwise
                    my is 0
        otherwise
            mx is (rnd with 3) - 1
            if mx is 0 then
                my is (rnd with 3) - 1
            otherwise
                my is 0
        if mx is 0 and my is 0 then
            skip
        nx is e["x"] + mx
        ny is e["y"] + my
        if is_wall with nx and ny then
            skip
        if nx is G["px"] and ny is G["py"] then
            r3 is rnd with 3
            dmg is e["atk"] + r3
            e["atkT"] is G["tick"]
            hurt_player with dmg and e["name"]
            skip
        occ is entity_at with nx and ny
        if occ is not nothing then
            skip
        e["x"] is nx
        e["y"] is ny
        e["ph"] is e["ph"] + 1
    npc_wander
    give back nothing

to npc_wander
    for each n in G["npcs"]
        n["tick"] is n["tick"] + 1
        if n["tick"] is less than 4 then
            skip
        n["tick"] is 0
        wx is (rnd with 3) - 1
        if wx is 0 then
            wy is (rnd with 3) - 1
        otherwise
            wy is 0
        if wx is 0 and wy is 0 then
            skip
        tx is n["x"] + wx
        ty is n["y"] + wy
        if is_wall with tx and ty then
            skip
        if tx is G["px"] and ty is G["py"] then
            skip
        occ is entity_at with tx and ty
        if occ is not nothing then
            skip
        if G["map"] is "dungeon" and tx is G["sx"] and ty is G["sy"] then
            skip
        if G["map"] is "over" and G["grid"][ty][tx] is 7 then
            note Never camp the cave mouth on the surface.
            skip
        if G["map"] is "dungeon" and tx is G["upx"] and ty is G["upy"] then
            note Never camp the rope ladder in the dungeon.
            skip
        n["x"] is tx
        n["y"] is ty
        n["ph"] is n["ph"] + 1
    give back nothing

to spawn_part with tx and ty and col and life
    p is a new table
    p["x"] is tx
    p["y"] is ty
    p["c"] is col
    p["l"] is life
    p["s"] is rnd with 4
    ps is G["parts"]
    push p to ps
    if length of ps is greater than 36 then
        np is []
        i is 1
        repeat while i is less than length of ps
            push ps[i] to np
            i is i + 1
        G["parts"] is np
    give back nothing

to tick_parts
    np is []
    for each p in G["parts"]
        p["l"] is p["l"] - 1
        if p["l"] is greater than 0 then
            push p to np
    G["parts"] is np
    give back nothing

to spawn_floater with tx and ty and txt and col and life
    f is a new table
    f["x"] is tx
    f["y"] is ty
    f["t"] is txt
    f["c"] is col
    f["l"] is life
    f["m"] is life
    fs is G["floaters"]
    push f to fs
    if length of fs is greater than 24 then
        nf is []
        i is 1
        repeat while i is less than length of fs
            push fs[i] to nf
            i is i + 1
        G["floaters"] is nf
    give back nothing

to tick_floaters
    nf is []
    for each f in G["floaters"]
        f["l"] is f["l"] - 1
        if f["l"] is greater than 0 then
            push f to nf
    G["floaters"] is nf
    give back nothing

note ---- display list ----

to on_screen with x and y and camx and camy
    if x is less than camx then
        give back false
    if x is greater than camx + 23 then
        give back false
    if y is less than camy then
        give back false
    if y is greater than camy + 15 then
        give back false
    give back true

to rebuild_dl
    dl is []
    if G["shake"] is greater than 0 then
        note Deterministic camera shake from a tick hash. No RNG is burned.
        h1 is (G["tick"] * 37 + 11) % 3
        h2 is (G["tick"] * 53 + 29) % 3
        G["shx"] is h1 - 1
        G["shy"] is h2 - 1
        if G["shake"] is greater than 4 then
            h3 is (G["tick"] * 37 + 11) % 5
            h4 is (G["tick"] * 53 + 29) % 5
            G["shx"] is h3 - 2
            G["shy"] is h4 - 2
        G["shake"] is G["shake"] - 1
    otherwise
        G["shx"] is 0
        G["shy"] is 0
    push ["clear", "0a0a0f"] to dl
    if G["mode"] is "fpp" then
        if G["gl3d"] then
            render_fpp3d with dl
        otherwise
            render_fpp with dl
    otherwise if G["map"] is "over" then
        note Overworld 3D pulled back 20261008: the oblique look shipped too
        note early and read as cheap. Back to the 2D top-down until the
        note overworld gets a real art pass. Dungeon first-person stays 3D.
        render_over with dl
    otherwise
        render_top with dl
    for each f in G["floaters"]
        rise is ipart with (f["m"] - f["l"]) / 2
        is3d is false
        if G["gl3d"] then
            if G["mode"] is "fpp" then
                is3d is true
            if G["map"] is "over" then
                is3d is true
        if is3d then
            note WebGL 3D (first-person or overworld): world-anchored text,
            note the driver projects it.
            push ["text3d", f["x"] + 0.5, 0.9, f["y"] + 0.5, f["t"], f["c"]] to dl
        otherwise if G["mode"] is "fpp" then
            note First-person: project the floater into the 3D view, like parts.
            ox is G["ptx"] + G["pfx"]
            oy is G["pty"] + G["pfy"]
            d is sproj with f["x"] + 0.5 and f["y"] + 0.5 and ox and oy and G["fdx"] and G["fdy"]
            if d is greater than 0.3 and d is less than 12 then
                rx is 0 - G["fdy"]
                ry is G["fdx"]
                lat is ((f["x"] + 0.5) - ox) * rx + ((f["y"] + 0.5) - oy) * ry
                fx is 96 + lat * 147.83 / d
                if fx is greater than 0 - 8 and fx is less than 200 then
                    fy is 56 - rise
                    push ["text", (ipart with (fx - 8)) + G["shx"], fy + G["shy"], f["t"], f["c"], 8] to dl
        otherwise
            note Top-down: tile coords to screen coords through the camera.
            camx is clamp with G["px"] - 12 and 0 and 36
            camy is clamp with G["py"] - 8 and 0 and 26
            if f["x"] is greater than camx - 3 and f["x"] is less than camx + 27 and f["y"] is greater than camy - 3 and f["y"] is less than camy + 19 then
                sx is (f["x"] - camx) * 8 - 6 + G["shx"]
                sy is (f["y"] - camy) * 8 - rise + G["shy"]
                push ["text", sx, sy, f["t"], f["c"], 8] to dl
    hpf is (G["hp"] * 100) / G["maxhp"]
    if hpf is less than 30 then
        note Low-HP warning: red pulsing vignette border.
        tm is G["tick"] % 8
        pulse is 2 + ipart with tm / 4
        push ["rect", 0, 0, 192, pulse, "c02020"] to dl
        push ["rect", 0, 128 - pulse, 192, pulse, "c02020"] to dl
        push ["rect", 0, 0, pulse, 128, "c02020"] to dl
        push ["rect", 192 - pulse, 0, pulse, 128, "c02020"] to dl
    if G["flash"] is greater than 0 then
        G["flash"] is G["flash"] - 1
        push ["rect", 0, 0, 192, 128, "ffffff"] to dl
    OUT["dl"] is dl
    give back nothing

to draw_pause_overlay
    note PAUSED stamp on top of the frozen frame, drawn through the display list.
    dl is OUT["dl"]
    push ["rect", 54, 46, 84, 36, "0a0a14"] to dl
    push ["rect", 54, 46, 84, 1, "ffd75e"] to dl
    push ["rect", 54, 81, 84, 1, "ffd75e"] to dl
    push ["text", 71, 54, "PAUSED", "ffd75e", 12] to dl
    push ["text", 75, 70, "press P", "8a8a9a", 8] to dl
    give back nothing

to draw_parts_top with dl and camx and camy
    for each p in G["parts"]
        vis is on_screen with p["x"] and p["y"] and camx and camy
        if vis then
            sx is (p["x"] - camx) * 8 + 3 + p["s"] + G["shx"]
            sy is (p["y"] - camy) * 8 + 2 + ((p["l"] + p["s"]) % 3) + G["shy"]
            push ["rect", sx, sy, 2, 2, p["c"]] to dl
    give back nothing

to render_top with dl
    camx is clamp with G["px"] - 12 and 0 and 36
    camy is clamp with G["py"] - 8 and 0 and 26
    ty is 0
    repeat while ty is less than 16
        tx is 0
        repeat while tx is less than 24
            mx is camx + tx
            my is camy + ty
            if G["grid"][my][mx] is 1 then
                sx is tx * 8 + G["shx"]
                sy is ty * 8 + G["shy"]
                push ["sprite", SPR["tile_wall"], sx, sy, 8, 8, 0, 0] to dl
                if (mx * 3 + my * 5 + G["tick"]) % 7 is 0 then
                    push ["rect", sx + 3, sy + 2, 2, 2, "ffd75e"] to dl
            otherwise
                sx is tx * 8 + G["shx"]
                sy is ty * 8 + G["shy"]
                push ["sprite", SPR["tile_floor"], sx, sy, 8, 8, 0, 0] to dl
            tx is tx + 1
        ty is ty + 1
    if G["depth"] is 1 and G["upx"] is not 0 - 1 then
        draw_ladder with dl and camx and camy
    draw_stairs with dl and camx and camy
    for each it in G["items"]
        draw_item with dl and it and camx and camy
    for each n in G["npcs"]
        draw_npc with dl and n and camx and camy
    for each e in G["enemies"]
        draw_enemy with dl and e and camx and camy
    draw_player with dl and camx and camy
    draw_parts_top with dl and camx and camy
    give back nothing

to draw_ladder with dl and camx and camy
    vis is on_screen with G["upx"] and G["upy"] and camx and camy
    if vis is false then
        give back nothing
    sx is (G["upx"] - camx) * 8 + G["shx"]
    sy is (G["upy"] - camy) * 8 + G["shy"]
    push ["sprite", SPR["ladder"], sx, sy, 8, 8, 0, 0] to dl
    give back nothing

to draw_stairs with dl and camx and camy
    vis is on_screen with G["sx"] and G["sy"] and camx and camy
    if vis is false then
        give back nothing
    sx is (G["sx"] - camx) * 8 + G["shx"]
    sy is (G["sy"] - camy) * 8 + G["shy"]
    nm is SPR["stairs_down"]
    if G["locked"] then
        nm is SPR["stairs_sealed"]
    push ["sprite", nm, sx, sy, 8, 8, 0, 0] to dl
    give back nothing

to draw_item with dl and it and camx and camy
    vis is on_screen with it["x"] and it["y"] and camx and camy
    if vis is false then
        give back nothing
    sx is (it["x"] - camx) * 8 + G["shx"]
    sy is (it["y"] - camy) * 8 + G["shy"]
    bob is (G["tick"] + it["id"]) % 2
    if it["kind"] is "gold" then
        push ["sprite", SPR["tile_gold"], sx, sy - bob, 8, 8, 0, 0] to dl
    otherwise if it["kind"] is "potion" then
        push ["sprite", SPR["tile_potion"], sx, sy - bob, 8, 8, 0, 0] to dl
    otherwise
        nm is SPR["shrine_might"]
        if it["boon"] is "vitality" then
            nm is SPR["shrine_vitality"]
        push ["sprite", nm, sx, sy, 8, 8, 0, 0] to dl
        if (G["tick"] + it["id"]) % 4 is less than 2 then
            push ["rect", sx + 3, sy + 1, 2, 1, "ffffff"] to dl
    give back nothing

to draw_npc with dl and n and camx and camy
    vis is on_screen with n["x"] and n["y"] and camx and camy
    if vis is false then
        give back nothing
    sx is (n["x"] - camx) * 8 + G["shx"]
    sy is (n["y"] - camy) * 8 + G["shy"]
    idle is (G["tick"] + n["ph"]) % 4
    bob is 0
    if idle is 3 then
        bob is 1
    nm is SPR["wanderer"]
    if n["nkind"] is "merchant" then
        nm is SPR["merchant"]
    otherwise if n["nkind"] is "elder" then
        nm is SPR["elder"]
    otherwise if n["nkind"] is "villager" then
        nm is SPR["villager0"]
        if n["ph"] % 2 is 1 then
            nm is SPR["villager1"]
    push ["sprite", nm, sx, sy - bob, 8, 8, 0, 0] to dl
    give back nothing

to draw_enemy with dl and e and camx and camy
    vis is on_screen with e["x"] and e["y"] and camx and camy
    if vis is false then
        give back nothing
    sx is (e["x"] - camx) * 8 + G["shx"]
    sy is (e["y"] - camy) * 8 + G["shy"]
    if e["kb"] is greater than 0 then
        sx is sx + e["kbx"]
        sy is sy + e["kby"]
    fl is 0
    if e["flash"] is greater than 0 then
        fl is 1
    face is 0
    if G["px"] is less than e["x"] then
        face is 1
    t is e["type"]
    nm is SPR["goblin"]
    if t is "rat" then
        nm is SPR["rat"]
    otherwise if t is "bat" then
        nm is SPR["bat"]
    otherwise if t is "ogre" then
        nm is SPR["ogre"]
    otherwise if t is "warden" then
        nm is SPR["warden"]
    note walk-cycle frame: alternate sprite on a 4-tick period, offset per
    note enemy so a pack does not march in lockstep
    if (G["tick"] + e["x"] + e["y"]) % 4 is less than 2 then
        if t is "rat" then
            nm is SPR["rat2"]
        otherwise if t is "bat" then
            nm is SPR["bat2"]
        otherwise if t is "ogre" then
            nm is SPR["ogre2"]
        otherwise if t is "warden" then
            nm is SPR["warden2"]
        otherwise
            nm is SPR["goblin2"]
    push ["sprite", nm, sx, sy, 8, 8, face, fl] to dl
    lunging is false
    if G["tick"] - e["atkT"] is less than 2 then
        lunging is true
    if lunging then
        lx is sx + 4
        if G["px"] is less than e["x"] then
            lx is sx - 1
        otherwise if G["px"] is greater than e["x"] then
            lx is sx + 8
        push ["rect", lx, sy + 3, 1, 2, "ff5a5a"] to dl
    give back nothing

to draw_rat with dl and sx and sy and e
    give back nothing

to draw_bat with dl and sx and sy and e
    give back nothing

to draw_goblin with dl and sx and sy and e
    give back nothing

to draw_ogre with dl and sx and sy and e
    give back nothing

to draw_warden with dl and sx and sy and e
    give back nothing

to pmx with sx and o and w
    if G["pface"] is 1 then
        give back sx + o
    give back sx + 8 - o - w

to draw_player with dl and camx and camy
    sx is (G["px"] - camx) * 8 + G["shx"]
    sy is (G["py"] - camy) * 8 + G["shy"]
    face is 0
    if G["pface"] is 0 then
        face is 1
    knm is SPR["knight"]
    if G["tick"] % 4 is less than 2 then
        knm is SPR["knight2"]
    push ["sprite", knm, sx, sy, 8, 8, face, 0] to dl
    recent is false
    if G["tick"] - G["patk"] is less than 2 then
        recent is true
    if recent then
        bx is pmx with sx and 7 and 6
        push ["rect", bx, sy + 3, 6, 1, "dfe6f5"] to dl
        push ["rect", bx, sy + 2, 2, 1, "ffffff"] to dl
    give back nothing

to draw_terrain with dl and c and sx and sy and mx and my
    shx is G["shx"]
    shy is G["shy"]
    if c is 0 then
        push ["sprite", SPR["tile_grass"], sx + shx, sy + shy, 8, 8, 0, 0] to dl
    otherwise if c is 6 then
        push ["sprite", SPR["tile_flowers"], sx + shx, sy + shy, 8, 8, 0, 0] to dl
    otherwise if c is 3 then
        push ["sprite", SPR["tile_path"], sx + shx, sy + shy, 8, 8, 0, 0] to dl
    otherwise if c is 1 then
        tn is SPR["tile_tree_pine"]
        if (mx + my) % 2 is 1 then
            tn is SPR["tile_tree_round"]
        push ["sprite", tn, sx + shx, sy + shy, 8, 8, 0, 0] to dl
    otherwise if c is 2 then
        wn is SPR["tile_water0"]
        if (mx + G["tick"]) % 4 is less than 2 then
            wn is SPR["tile_water1"]
        push ["sprite", wn, sx + shx, sy + shy, 8, 8, 0, 0] to dl
    otherwise if c is 4 then
        roof is false
        if my is 0 then
            roof is true
        otherwise if G["grid"][my - 1][mx] is not 4 then
            roof is true
        if roof then
            push ["sprite", SPR["tile_roof"], sx + shx, sy + shy, 8, 8, 0, 0] to dl
        otherwise
            push ["sprite", SPR["tile_housewall"], sx + shx, sy + shy, 8, 8, 0, 0] to dl
    otherwise if c is 5 then
        push ["sprite", SPR["well"], sx + shx, sy + shy, 8, 8, 0, 0] to dl
    otherwise
        push ["sprite", SPR["tile_cave"], sx + shx, sy + shy, 8, 8, 0, 0] to dl
    give back nothing


to render_over with dl
    camx is clamp with G["px"] - 12 and 0 and 36
    camy is clamp with G["py"] - 8 and 0 and 26
    ty is 0
    repeat while ty is less than 16
        tx is 0
        repeat while tx is less than 24
            mx is camx + tx
            my is camy + ty
            c is G["grid"][my][mx]
            draw_terrain with dl and c and tx * 8 and ty * 8 and mx and my
            tx is tx + 1
        ty is ty + 1
    for each it in G["items"]
        draw_item with dl and it and camx and camy
    for each n in G["npcs"]
        draw_npc with dl and n and camx and camy
    draw_player with dl and camx and camy
    draw_parts_top with dl and camx and camy
    give back nothing

note ---- overworld in real 3D (roadmap item 1e) ----
note Oblique third-person camera over Emberhold: textured terrain quads for
note a 13x13 window, house walls with raised roof planes, tree/well/cave
note prop models, and the knight/NPC/item models. Game logic is unchanged;
note the driver draws it with the same WebGL pipeline as first-person 3D.

to over3d_ground with dl and mx and my and tn
    push ["quad3d", mx, 0, my, mx + 1, 0, my, mx + 1, 0, my + 1, mx, 0, my + 1, tn, 1] to dl
    give back nothing

to over3d_wall with dl and mx and my
    note One vertical quad per side whose neighbor is not house (tile 4).
    if my is greater than 0 then
        if G["grid"][my - 1][mx] is not 4 then
            push ["quad3d", mx, 0, my, mx + 1, 0, my, mx + 1, 0.9, my, mx, 0.9, my, "wall", 1] to dl
    if my is less than 41 then
        if G["grid"][my + 1][mx] is not 4 then
            push ["quad3d", mx, 0, my + 1, mx + 1, 0, my + 1, mx + 1, 0.9, my + 1, mx, 0.9, my + 1, "wall", 0.8] to dl
    if mx is greater than 0 then
        if G["grid"][my][mx - 1] is not 4 then
            push ["quad3d", mx, 0, my, mx, 0, my + 1, mx, 0.9, my + 1, mx, 0.9, my, "wall", 0.85] to dl
    if mx is less than 59 then
        if G["grid"][my][mx + 1] is not 4 then
            push ["quad3d", mx + 1, 0, my, mx + 1, 0, my + 1, mx + 1, 0.9, my + 1, mx + 1, 0.9, my, "wall", 0.85] to dl
    give back nothing

to over3d_inwin with wx and wy and x0 and y0 and x1 and y1
    if wx is less than x0 - 1 then
        give back false
    if wx is greater than x1 + 2 then
        give back false
    if wy is less than y0 - 1 then
        give back false
    if wy is greater than y1 + 2 then
        give back false
    give back true

to render_over3d with dl
    push ["cam3do", G["px"] + 0.5, G["py"] + 0.5] to dl
    cx is ipart with G["px"]
    cy is ipart with G["py"]
    x0 is cx - 6
    if x0 is less than 0 then
        x0 is 0
    x1 is cx + 6
    if x1 is greater than 59 then
        x1 is 59
    y0 is cy - 6
    if y0 is less than 0 then
        y0 is 0
    y1 is cy + 6
    if y1 is greater than 41 then
        y1 is 41
    note Slow water shimmer: the frame flips about every 16 ticks.
    wt is "water0"
    wtick is ipart with (G["tick"] / 16)
    if wtick % 2 is 0 then
        wt is "water1"
    my is y0
    repeat while my is less than y1 + 1
        mx is x0
        repeat while mx is less than x1 + 1
            c is G["grid"][my][mx]
            if c is 2 then
                over3d_ground with dl and mx and my and wt
            otherwise if c is 3 then
                over3d_ground with dl and mx and my and "path"
            otherwise if c is 6 then
                over3d_ground with dl and mx and my and "flowers"
            otherwise if c is 1 then
                over3d_ground with dl and mx and my and "grass"
                tn is "tree1"
                if (mx + my) % 2 is 1 then
                    tn is "tree2"
                push ["model3d", tn, mx + 0.5, 0, my + 0.5, 0, 0, 1] to dl
            otherwise if c is 5 then
                over3d_ground with dl and mx and my and "stone"
                push ["model3d", "well", mx + 0.5, 0, my + 0.5, 0, 0, 1] to dl
            otherwise if c is 7 then
                over3d_ground with dl and mx and my and "dark"
                push ["model3d", "cave", mx + 0.5, 0, my + 0.5, 0, 0, 1] to dl
            otherwise if c is 4 then
                roof is false
                if my is 0 then
                    roof is true
                otherwise if G["grid"][my - 1][mx] is not 4 then
                    roof is true
                if roof then
                    note Raised roof plane, read edge-on from the oblique camera.
                    push ["quad3d", mx, 0.55, my, mx + 1, 0.55, my, mx + 1, 0.55, my + 1, mx, 0.55, my + 1, "roof", 1] to dl
                otherwise
                    over3d_ground with dl and mx and my and "wood"
                    over3d_wall with dl and mx and my
            otherwise
                over3d_ground with dl and mx and my and "grass"
            mx is mx + 1
        my is my + 1
    note The knight, facing the last travel direction, walk pose on step parity.
    ppose is 0
    if (G["tick"] + G["pph"]) % 4 is less than 2 then
        ppose is 1
    push ["model3d", "knight", G["px"] + 0.5, 0, G["py"] + 0.5, G["pyaw"], ppose, 1] to dl
    for each n in G["npcs"]
        wx is n["x"] + 0.5
        wy is n["y"] + 0.5
        if over3d_inwin with wx and wy and x0 and y0 and x1 and y1 then
            yaw is face_yaw with G["px"] - wx and G["py"] - wy
            npose is 0
            if (G["tick"] + n["ph"]) % 8 is less than 4 then
                npose is 1
            push ["model3d", n["nkind"], wx, 0, wy, yaw, npose, 1] to dl
    for each it in G["items"]
        wx is it["x"] + 0.5
        wy is it["y"] + 0.5
        if over3d_inwin with wx and wy and x0 and y0 and x1 and y1 then
            im is "shrine"
            if it["kind"] is "gold" then
                im is "gold"
            otherwise if it["kind"] is "potion" then
                im is "potion"
            push ["model3d", im, wx, 0, wy, 0, 0, 1] to dl
    for each p in G["parts"]
        wx is p["x"] + 0.5
        wy is p["y"] + 0.5
        if over3d_inwin with wx and wy and x0 and y0 and x1 and y1 then
            push ["model3d", "spark", wx, 0.5, wy, 0, 0, 1] to dl
    give back nothing

note ---- first-person raycaster ----
note 48 rays over a 66-degree field of view. Rays are unit vectors built by
note rotating the facing vector: first to -33 deg, then +66/47 deg per ray.
note Rotation uses fixed float constants (no trig in the language):
note cos15 0.96593 sin15 0.25882, cos33 0.83867 sin33 0.54464,
note per-ray cos 0.99970 sin 0.02450. Focal length 147.83 = 96 / tan(33deg).
note DDA walks the 0/1 dungeon grid, max 48 steps per ray. Wall height is
note 128 / perpendicular-distance, shaded by distance band and wall side.
note Sprites are true-3D billboards: project to camera space, sort far to
note near, depth-test every screen column against the ray depth buffer,
note draw textured vertical strips from the atlas (mirrors wall columns).

to tex_col with t
    note Fast texture column 0-15 from t in [-16, 16]. Binary range reduction,
    note no slow ipart loops. Caller clamps t; far walls are too dark to show detail.
    s is 0.5 + t
    s2 is s + 32
    if s2 is greater than 31 then
        s2 is s2 - 32
    if s2 is greater than 15 then
        s2 is s2 - 16
    if s2 is greater than 7 then
        s2 is s2 - 8
    if s2 is greater than 3 then
        s2 is s2 - 4
    if s2 is greater than 1 then
        s2 is s2 - 2
        if s2 is greater than 1 then
            s2 is s2 - 1
    if s2 is 1 then
        s2 is 0
    if s2 is less than 0 then
        s2 is s2 + 1
    note s2 is now frac(s) in [0, 1).
    v is s2 * 16
    texx is 0
    if v is greater than 7 then
        texx is 8
        v is v - 8
    if v is greater than 3 then
        texx is texx + 4
        v is v - 4
    if v is greater than 1 then
        texx is texx + 2
        v is v - 2
        if v is greater than 1 then
            texx is texx + 1
    give back texx

to cast_one with ox and oy and rdx and rdy and zb and xb
    mx is G["ptx"]
    my is G["pty"]
    ax is absv with rdx
    if ax is less than 0.0001 then
        dxd is 1000000
    otherwise
        dxd is absv with (1 / rdx)
    ay is absv with rdy
    if ay is less than 0.0001 then
        dyd is 1000000
    otherwise
        dyd is absv with (1 / rdy)
    if rdx is less than 0 then
        stepx is 0 - 1
        sdx is (ox - mx) * dxd
    otherwise
        stepx is 1
        sdx is (mx + 1 - ox) * dxd
    if rdy is less than 0 then
        stepy is 0 - 1
        sdy is (oy - my) * dyd
    otherwise
        stepy is 1
        sdy is (my + 1 - oy) * dyd
    side is 0
    dist is 0
    i is 0
    repeat while i is less than 32
        if sdx is less than sdy then
            dist is sdx
            sdx is sdx + dxd
            mx is mx + stepx
            side is 0
        otherwise
            dist is sdy
            sdy is sdy + dyd
            my is my + stepy
            side is 1
        if mx is less than 0 or mx is greater than 59 or my is less than 0 or my is greater than 41 then
            stop
        if G["grid"][my][mx] is 1 then
            stop
        i is i + 1
    depth is dist * (rdx * G["fdx"] + rdy * G["fdy"])
    if depth is less than 0.15 then
        depth is 0.15
    push depth to zb
    note Texture column via fast binary frac. Far walls clamp; detail invisible there.
    if side is 0 then
        t is depth * rdy
    otherwise
        t is depth * rdx
    if t is greater than 16 then
        t is 16
    if t is less than 0 - 16 then
        t is 0 - 16
    texx is tex_col with t
    if side is 0 then
        if rdx is greater than 0 then
            texx is 15 - texx
    otherwise
        if rdy is less than 0 then
            texx is 15 - texx
    push texx to xb
    give back side

to wall_col with depth and side
    idx is 3
    if depth is less than 1.5 then
        idx is 0
    otherwise if depth is less than 3 then
        idx is 1
    otherwise if depth is less than 6 then
        idx is 2
    if side is 1 then
        give back G["ycols"][idx]
    give back G["xcols"][idx]

to sproj with wx and wy and ox and oy and fdx and fdy
    relx is wx - ox
    rely is wy - oy
    give back relx * fdx + rely * fdy

to sprite_cols with tag and ref and d
    sh is 0
    if d is greater than 5 then
        sh is 1
    if tag is "e" then
        t is ref["type"]
        if t is "rat" then
            cs is ["9a9a8a", "6a6a5a"]
        otherwise if t is "bat" then
            cs is ["7a6ae0", "4a3ed0"]
        otherwise if t is "goblin" then
            cs is ["4ae08a", "2a8a4a"]
        otherwise if t is "ogre" then
            cs is ["8a6a4a", "5a4a3a"]
        otherwise
            cs is ["8a2a2a", "4a1414"]
        give back [cs[sh], cs[0]]
    if tag is "n" then
        nk is ref["nkind"]
        if nk is "merchant" then
            give back ["6a3a7a", "4a2a5a"]
        otherwise
            give back ["2f5a7a", "1f3a5a"]
    k is ref["kind"]
    if k is "gold" then
        give back ["ffd75e", "b8860b"]
    if k is "potion" then
        give back ["e03060", "8f1438"]
    if ref["boon"] is "vitality" then
        give back ["4ae08a", "2a6a4a"]
    give back ["ff9a3a", "8a5a1a"]

to fpp_spr_name with tag and ref
    if tag is "e" then
        t is ref["type"]
        nm is SPR["goblin"]
        if t is "rat" then
            nm is SPR["rat"]
        otherwise if t is "bat" then
            nm is SPR["bat"]
        otherwise if t is "ogre" then
            nm is SPR["ogre"]
        otherwise if t is "warden" then
            nm is SPR["warden"]
        note same walk-cycle parity as draw_enemy so both views agree
        if (G["tick"] + ref["x"] + ref["y"]) % 4 is less than 2 then
            if t is "rat" then
                nm is SPR["rat2"]
            otherwise if t is "bat" then
                nm is SPR["bat2"]
            otherwise if t is "ogre" then
                nm is SPR["ogre2"]
            otherwise if t is "warden" then
                nm is SPR["warden2"]
            otherwise
                nm is SPR["goblin2"]
        give back nm
    if tag is "n" then
        nk is ref["nkind"]
        if nk is "merchant" then
            give back SPR["merchant"]
        otherwise if nk is "elder" then
            give back SPR["elder"]
        otherwise if nk is "villager" then
            give back SPR["villager0"]
        give back SPR["wanderer"]
    k is ref["kind"]
    if k is "gold" then
        give back SPR["tile_gold"]
    if k is "potion" then
        give back SPR["tile_potion"]
    if ref["boon"] is "vitality" then
        give back SPR["shrine_vitality"]
    give back SPR["shrine_might"]

to draw_fpp_sprites with dl and zb and ox and oy
    note True-3D billboarded sprites. Each visible entity is projected to
    note camera space, scaled by distance, then drawn as textured vertical
    note strips from the atlas (["sslice", name, t0, t1, dx, dy, dw, dh, shade]).
    note Every screen column is depth-tested against the ray depth buffer, so
    note sprites clip correctly behind wall edges instead of popping. Visible
    note columns are coalesced into runs to keep the display list small.
    note Shading is deliberately subtle (min 0.5) so texture detail stays
    note readable; the driver smooth-filters strips for crisp scaled reads.
    fdx is G["fdx"]
    fdy is G["fdy"]
    rx is 0 - fdy
    ry is fdx
    spr is []
    for each e in G["enemies"]
        d is sproj with e["x"] + 0.5 and e["y"] + 0.5 and ox and oy and fdx and fdy
        if d is greater than 0.4 and d is less than 14 then
            push [d, "e", e] to spr
    for each n in G["npcs"]
        d is sproj with n["x"] + 0.5 and n["y"] + 0.5 and ox and oy and fdx and fdy
        if d is greater than 0.4 and d is less than 14 then
            push [d, "n", n] to spr
    for each it in G["items"]
        d is sproj with it["x"] + 0.5 and it["y"] + 0.5 and ox and oy and fdx and fdy
        if d is greater than 0.4 and d is less than 14 then
            push [d, "i", it] to spr
    note far to near so near sprites overdraw far ones
    n2 is length of spr
    i is 1
    repeat while i is less than n2
        j is i
        repeat while j is greater than 0
            if spr[j][0] is greater than spr[j - 1][0] then
                tmp is spr[j]
                spr[j] is spr[j - 1]
                spr[j - 1] is tmp
                j is j - 1
            otherwise
                stop
        i is i + 1
    drawn is 0
    for each s in spr
        if drawn is greater than 11 then
            stop
        d is s[0]
        relx is (s[2]["x"] + 0.5) - ox
        rely is (s[2]["y"] + 0.5) - oy
        lat is relx * rx + rely * ry
        fx is 96 + lat * 147.83 / d
        if fx is less than (0 - d * 8) or fx is greater than 192 + d * 8 then
            skip
        h is 147.83 * 0.85 / d
        if h is greater than 120 then
            h is 120
        if h is less than 3 then
            skip
        hi is ipart with h
        wi is ipart with (h * 0.7)
        if wi is less than 2 then
            wi is 2
        x0 is ipart with (fx - h * 0.35)
        x1 is x0 + wi
        if x1 is less than 0 or x0 is greater than 191 then
            skip
        y0 is ipart with (64 + h * 0.15 - h)
        if y0 is less than 0 then
            y0 is 0
        shade is 1 - d / 24
        if shade is less than 0.45 then
            shade is 0.45
        nm is fpp_spr_name with s[1] and s[2]
        tw is sprw_of with nm
        note depth buffer span for this sprite, one ray column per 4px
        col0 is ipart with (x0 / 4)
        if col0 is less than 0 then
            col0 is 0
        if col0 is greater than 47 then
            col0 is 47
        col1 is ipart with ((x1 - 1) / 4)
        if col1 is less than 0 then
            col1 is 0
        if col1 is greater than 47 then
            col1 is 47
        note exact early-outs: min/max over the covered ray columns
        zbmin is 99999
        zbmax is 0 - 99999
        cc is col0
        repeat while cc is less than col1 + 1
            z is zb[cc]
            if z is less than zbmin then
                zbmin is z
            if z is greater than zbmax then
                zbmax is z
            cc is cc + 1
        if zbmax is less than d - 0.25 then
            note fully behind a wall: nothing to draw
            skip
        if zbmin is greater than d - 0.25 then
            note fully visible: one strip, no per-column loop
            dx0 is x0
            if dx0 is less than 0 then
                dx0 is 0
            dx1 is x1
            if dx1 is greater than 192 then
                dx1 is 192
            t0 is ipart with ((dx0 - x0) * tw / wi)
            t1 is ipart with ((dx1 - 1 - x0) * tw / wi)
            dw is dx1 - dx0
            push ["sslice", nm, t0, t1, dx0 + G["shx"], y0 + G["shy"], dw, hi, shade] to dl
            drawn is drawn + 1
            skip
        note partial occlusion: coalesce visible columns into runs
        c is x0
        run0 is 0 - 1
        t0 is 0
        repeat while c is less than x1
            vis is 0
            if c is greater than 0 - 1 and c is less than 192 then
                qc is ipart with (c / 4)
                if qc is less than 0 then
                    qc is 0
                if qc is greater than 47 then
                    qc is 47
                if zb[qc] is greater than d - 0.25 then
                    vis is 1
            if vis is 1 then
                if run0 is 0 - 1 then
                    run0 is c
                    t0 is ipart with ((c - x0) * tw / wi)
            otherwise
                if run0 is not 0 - 1 then
                    t1 is ipart with ((c - 1 - x0) * tw / wi)
                    dw is c - run0
                    push ["sslice", nm, t0, t1, run0 + G["shx"], y0 + G["shy"], dw, hi, shade] to dl
                    run0 is 0 - 1
            c is c + 1
        if run0 is not 0 - 1 then
            t1 is ipart with ((x1 - 1 - x0) * tw / wi)
            dw is x1 - run0
            push ["sslice", nm, t0, t1, run0 + G["shx"], y0 + G["shy"], dw, hi, shade] to dl
        drawn is drawn + 1
    give back nothing

to draw_fpp_parts with dl and zb and ox and oy
    fdx is G["fdx"]
    fdy is G["fdy"]
    rx is 0 - fdy
    ry is fdx
    for each p in G["parts"]
        d is sproj with p["x"] + 0.5 and p["y"] + 0.5 and ox and oy and fdx and fdy
        if d is greater than 0.3 and d is less than 10 then
            relx is (p["x"] + 0.5) - ox
            rely is (p["y"] + 0.5) - oy
            lat is relx * rx + rely * ry
            fx is 96 + lat * 147.83 / d
            if fx is less than 0 or fx is greater than 192 then
                skip
            qc is ipart with (fx / 4)
            col is clamp with qc and 0 and 47
            if zb[col] is less than d - 0.2 then
                skip
            sz is ipart with (6 / d) + 1
            if sz is less than 1 then
                sz is 1
            if sz is greater than 4 then
                sz is 4
            x0 is ipart with fx
            y0 is ipart with (64 + p["s"] - p["l"])
            push ["rect", x0, y0, sz, sz, p["c"]] to dl
    give back nothing

to draw_fpp_minimap with dl
    note FPP minimap, top-right corner of the 192x128 canvas. 1px per tile,
    note 60x42 tile dungeon plus a 1px plate border. Rooms are dark rects,
    note corridor cells dark dots, stairs gold, up-ladder cyan, boss red,
    note player white arrow. All pushes are small rects: bounded per-tick cost.
    ox is 128 + G["shx"]
    oy is 2 + G["shy"]
    push ["rect", ox, oy, 62, 44, "050508"] to dl
    for each r in G["rooms"]
        push ["rect", ox + 1 + r["x"], oy + 1 + r["y"], r["w"], r["h"], "262630"] to dl
    for each c in G["mmap_corr"]
        push ["rect", ox + 1 + c[0], oy + 1 + c[1], 1, 1, "262630"] to dl
    if G["upx"] is not 0 - 1 then
        push ["rect", ox + G["upx"], oy + G["upy"], 2, 2, "7ee0ff"] to dl
    push ["rect", ox + G["sx"], oy + G["sy"], 2, 2, "ffd75e"] to dl
    for each e in G["enemies"]
        if e["boss"] then
            push ["rect", ox + e["x"], oy + e["y"], 2, 2, "ff2020"] to dl
    px2 is ox + 1 + G["px"]
    py2 is oy + 1 + G["py"]
    push ["rect", px2, py2, 2, 2, "ffffff"] to dl
    if G["fdx"] is greater than 0.5 then
        push ["rect", px2 + 2, py2, 1, 2, "ffffff"] to dl
    otherwise if G["fdx"] is less than 0 - 0.5 then
        push ["rect", px2 - 1, py2, 1, 2, "ffffff"] to dl
    otherwise if G["fdy"] is greater than 0.5 then
        push ["rect", px2, py2 + 2, 2, 1, "ffffff"] to dl
    otherwise
        push ["rect", px2, py2 - 1, 2, 1, "ffffff"] to dl
    give back nothing

to render_fpp with dl
    i is 0
    repeat while i is less than 8
        push ["rect", 0, i * 8, 192, 8, G["ceil"][i]] to dl
        i is i + 1
    i is 0
    repeat while i is less than 8
        push ["rect", 0, 64 + i * 8, 192, 8, G["flor"][i]] to dl
        i is i + 1
    ox is G["ptx"] + G["pfx"]
    oy is G["pty"] + G["pfy"]
    fdx is G["fdx"]
    fdy is G["fdy"]
    rdx is fdx * 0.83867 + fdy * 0.54464
    rdy is (0 - fdx) * 0.54464 + fdy * 0.83867
    zb is []
    xb is []
    i is 0
    repeat while i is less than 48
        side is cast_one with ox and oy and rdx and rdy and zb and xb
        dist is zb[i]
        wh is 128 / dist
        if wh is greater than 128 then
            wh is 128
        whi is ipart with wh
        y0 is ipart with (64 - wh / 2)
        y1 is y0 + whi
        if y1 is greater than 128 then
            y1 is 128
        hh is y1 - y0
        if hh is greater than 0 then
            shade is 1 - dist / 14
            if shade is less than 0.15 then
                shade is 0.15
            if side is 1 then
                shade is shade * 0.7
            push ["slice", SPR["tile_wall"], xb[i], i * 4 + G["shx"], y0 + G["shy"], hh, shade] to dl
        nrx is rdx * 0.99970 - rdy * 0.02450
        nrdy is rdx * 0.02450 + rdy * 0.99970
        rdx is nrx
        rdy is nrdy
        i is i + 1
    draw_fpp_sprites with dl and zb and ox and oy
    draw_fpp_parts with dl and zb and ox and oy
    push ["rect", 94 + G["shx"], 116 + G["shy"], 4, 12, "9a9ab0"] to dl
    push ["rect", 93 + G["shx"], 112 + G["shy"], 6, 4, "dfe6f5"] to dl
    draw_fpp_minimap with dl
    give back nothing

note ---- WebGL 3D scene emission (first-person) ----
note The driver draws this with real perspective, depth testing, torch light
note and distance fog. cam3d carries the camera; quad3d carries dungeon
note geometry as (x, y-up, z-grid) corners; model3d places a low-poly cuboid
note model by name. Command counts stay bounded: one 13x13 window of wall
note faces plus the culled visible entities.

to face_yaw with dx and dy
    note Coarse 8-direction yaw toward (dx, dy); no trig needed in the language.
    note Yaw 0 faces south (+grid-y); pi/2 faces east (+grid-x).
    ax is absv with dx
    ay is absv with dy
    if ax is greater than ay * 2 then
        if dx is greater than 0 then
            give back 1.5708
        give back 4.7124
    if ay is greater than ax * 2 then
        if dy is greater than 0 then
            give back 0
        give back 3.1416
    if dx is greater than 0 and dy is greater than 0 then
        give back 0.7854
    if dx is less than 0 and dy is greater than 0 then
        give back 5.4978
    if dx is greater than 0 and dy is less than 0 then
        give back 2.3562
    give back 3.927

to fpp3d_put with dl and wx and wy and h and nm and yaw and pose and maxd
    note Cull to the view cone, then emit one model3d command.
    ox is G["ptx"] + G["pfx"]
    oy is G["pty"] + G["pfy"]
    fdx is G["fdx"]
    fdy is G["fdy"]
    d is sproj with wx and wy and ox and oy and fdx and fdy
    if d is less than 0.3 or d is greater than maxd then
        give back nothing
    rx is 0 - fdy
    ry is fdx
    lat is (wx - ox) * rx + (wy - oy) * ry
    alat is absv with lat
    if alat is greater than d * 0.8 + 1 then
        give back nothing
    push ["model3d", nm, wx, h, wy, yaw, pose, 1] to dl
    give back nothing

to render_fpp3d with dl
    ox is G["ptx"] + G["pfx"]
    oy is G["pty"] + G["pfy"]
    fdx is G["fdx"]
    fdy is G["fdy"]
    push ["cam3d", ox, oy, fdx, fdy] to dl
    cx is ipart with ox
    cy is ipart with oy
    x0 is cx - 6
    if x0 is less than 0 then
        x0 is 0
    x1 is cx + 6
    if x1 is greater than 59 then
        x1 is 59
    y0 is cy - 6
    if y0 is less than 0 then
        y0 is 0
    y1 is cy + 6
    if y1 is greater than 41 then
        y1 is 41
    note Floor and ceiling span the window as single quads.
    push ["quad3d", x0, 0, y0, x1 + 1, 0, y0, x1 + 1, 0, y1 + 1, x0, 0, y1 + 1, "floor", 1] to dl
    push ["quad3d", x0, 1, y1 + 1, x1 + 1, 1, y1 + 1, x1 + 1, 1, y0, x0, 1, y0, "ceil", 1] to dl
    note Walls: one quad per exposed face of each wall cell in the window.
    my is y0
    repeat while my is less than y1 + 1
        mx is x0
        repeat while mx is less than x1 + 1
            if G["grid"][my][mx] is 1 then
                if my is greater than 0 then
                    if G["grid"][my - 1][mx] is not 1 then
                        push ["quad3d", mx, 0, my, mx + 1, 0, my, mx + 1, 1, my, mx, 1, my, "wall", 1] to dl
                if my is less than 41 then
                    if G["grid"][my + 1][mx] is not 1 then
                        push ["quad3d", mx, 0, my + 1, mx + 1, 0, my + 1, mx + 1, 1, my + 1, mx, 1, my + 1, "wall", 0.8] to dl
                if mx is greater than 0 then
                    if G["grid"][my][mx - 1] is not 1 then
                        push ["quad3d", mx, 0, my, mx, 0, my + 1, mx, 1, my + 1, mx, 1, my, "wall", 0.85] to dl
                if mx is less than 59 then
                    if G["grid"][my][mx + 1] is not 1 then
                        push ["quad3d", mx + 1, 0, my, mx + 1, 0, my + 1, mx + 1, 1, my + 1, mx + 1, 1, my, "wall", 0.85] to dl
            mx is mx + 1
        my is my + 1
    for each e in G["enemies"]
        wx is e["x"] + 0.5
        wy is e["y"] + 0.5
        yaw is face_yaw with ox - wx and oy - wy
        pose is 0
        if (G["tick"] + e["x"] + e["y"]) % 4 is less than 2 then
            pose is 1
        fpp3d_put with dl and wx and wy and 0 and e["type"] and yaw and pose and 14
    for each n in G["npcs"]
        wx is n["x"] + 0.5
        wy is n["y"] + 0.5
        yaw is face_yaw with ox - wx and oy - wy
        pose is 0
        if (G["tick"] + n["ph"]) % 8 is less than 4 then
            pose is 1
        fpp3d_put with dl and wx and wy and 0 and n["nkind"] and yaw and pose and 14
    for each it in G["items"]
        wx is it["x"] + 0.5
        wy is it["y"] + 0.5
        fpp3d_put with dl and wx and wy and 0 and it["kind"] and 0 and 0 and 12
    for each p in G["parts"]
        wx is p["x"] + 0.5
        wy is p["y"] + 0.5
        fpp3d_put with dl and wx and wy and 0.5 and "spark" and 0 and 0 and 10
    sw is 0
    if G["tick"] - G["patk"] is less than 2 then
        sw is 1
    push ["sword3d", sw] to dl
    draw_fpp_minimap with dl
    give back nothing

to refresh_out
    hud is a new table
    hud["hp"] is G["hp"]
    hud["maxhp"] is G["maxhp"]
    hud["depth"] is G["depth"]
    hud["gold"] is G["gold"]
    hud["potions"] is G["potions"]
    hud["kills"] is G["kills"]
    dep is G["depth"]
    if dep is less than 1 then
        dep is 1
    hud["score"] is G["gold"] + ((dep - 1) * 100) + (G["kills"] * 10)
    hud["mission"] is G["mission"]
    hud["quest"] is G["quest"]
    bb is 0
    bbm is 1
    bbn is ""
    for each e in G["enemies"]
        if e["boss"] then
            bb is e["hp"]
            bbm is e["maxhp"]
            bbn is e["name"]
    hud["bosshp"] is bb
    hud["bossmax"] is bbm
    hud["bossname"] is bbn
    hud["mode"] is G["mode"]
    hud["over3d"] is 0
    note Overworld 3D pulled back 20261008: HUD must match the 2D renderer.
    note (The old "if gl3d then over3d=1" lied after the revert.)
    hud["paused"] is G["paused"]
    hud["diff"] is G["dname"]
    if G["map"] is "over" then
        hud["realm"] is "Emberhold"
    otherwise
        hud["realm"] is "Depth " + (text of G["depth"])
    OUT["hud"] is hud
    OUT["msgs"] is G["log"]
    OUT["over"] is G["over"]
    OUT["score"] is hud["score"]
    OUT["snd"] is G["sndq"]
    G["sndq"] is []
    give back nothing
