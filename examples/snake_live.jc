note Snake, live: the v2.0 sprint 2 demo. The same update/draw shape as
note examples/snake.jc, but driven by window_run: real keypresses steer
note the snake in your terminal. Arrows turn, Ctrl-C quits. Runs on the
note bootstrap (read key is bootstrap-only); the walker parses it and
note says so honestly.

bring in "window"

to live_new with sim
    sim["snake"] is [[4, 4], [3, 4], [2, 4]]
    sim["dir"] is [1, 0]
    sim["pellets"] is [[10, 4], [11, 10]]
    sim["score"] is 0
    give back nothing

to live_turn with sim and k
    d is sim["dir"]
    if k is "up" and d[1] is not 1 then
        sim["dir"] is [0, 0 - 1]
    otherwise if k is "down" and d[1] is not 0 - 1 then
        sim["dir"] is [0, 1]
    otherwise if k is "left" and d[0] is not 1 then
        sim["dir"] is [0 - 1, 0]
    otherwise if k is "right" and d[0] is not 0 - 1 then
        sim["dir"] is [1, 0]
    give back nothing

to live_update with sim
    k is game_poll with sim["pad"]
    if k is not nothing then
        live_turn with sim and k
    body is sim["snake"]
    head is body[0]
    d is sim["dir"]
    nx is head[0] + d[0]
    ny is head[1] + d[1]
    if nx is less than 0 then
        nx is 0
    if nx is greater than 63 then
        nx is 63
    if ny is less than 0 then
        ny is 0
    if ny is greater than 47 then
        ny is 47
    newhead is [nx, ny]
    pellets is sim["pellets"]
    ate is false
    kept is []
    for each p in pellets
        if p[0] is nx and p[1] is ny then
            ate is true
        otherwise
            push p to kept
    sim["pellets"] is kept
    newbody is [newhead]
    i is 0
    keepn is length of body
    if ate is false then
        keepn is keepn - 1
    repeat while i is less than keepn
        push body[i] to newbody
        i is i + 1
    sim["snake"] is newbody
    if ate then
        sim["score"] is sim["score"] + 1
    give back nothing

to live_draw with sim
    frame is sim["frame"]
    game_clear with frame and "000000"
    for each p in sim["pellets"]
        game_rect with frame and p[0] * 2 and p[1] * 2 and 2 and 2 and "FF0000"
    for each seg in sim["snake"]
        game_rect with frame and seg[0] * 2 and seg[1] * 2 and 2 and 2 and "00FF00"
    game_number with frame and 2 and 2 and sim["score"] and 1 and "FFFFFF"
    give back nothing

sim is game_sim with 64 and 48
live_new with sim
w is window_open with 64 and 48
report is window_run with 200 and sim and live_update and live_draw and w
window_close with w
final is window_frame with w
game_save with final and "snake_live_final.ppm"
show "ticks: " + (text of report["ticks"]) + ", frames: " + (text of report["frames"])
show "score: " + (text of sim["score"])
