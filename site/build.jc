note Jesun.Code site builder: regenerates docs/ through the sitegen package.
note Run from the repo root: python3 jesun.py site/build.jc
note   Output goes to ./docs by default; set JESUN_CODE_SITE_BASE to a
note   relative folder to stage elsewhere. Page bodies live in
note   site/content/*.body.html and are authored content; every byte of
note   chrome (head, nav, footer, blog index, sitemap, robots, llms.txt)
note   is emitted by the sitegen package. No post-processing, no hacks:
note   what sitegen_build writes is what ships.

bring in "sitegen"

import os as osmod
import builtins as bmod

note ---- output base: JESUN_CODE_SITE_BASE, default "docs". Relative,
note ---- sandboxed by sitegen (no absolute paths, no ".."). ----
base is "docs"
getenv is bmod.getattr(osmod, "getenv")
envbase is getenv("JESUN_CODE_SITE_BASE")
if envbase is not nothing then
    base is envbase

note ---- shared site table ----
site is a new table
site["base"] is base
site["site_url"] is "https://jesunahmadushno.github.io/jesun-code/"
site["version"] is "v2.0.0"

note ---- sitemap: explicit entries, hand order preserved ----
sitemap_entries is []
push {"url": "https://jesunahmadushno.github.io/jesun-code/", "changefreq": "weekly", "priority": "1.0"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/faq.html", "changefreq": "monthly", "priority": "0.8"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/about.html", "changefreq": "monthly", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/community.html", "changefreq": "weekly", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/brand/", "changefreq": "monthly", "priority": "0.6"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/", "changefreq": "weekly", "priority": "0.9"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v0.5.0-bangla-vscode.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v1.1.0-native.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v1.2.0-jweb.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v1.3.0-frontend.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v1.4.0-interop.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v1.5.0-sitegen.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v2.0.0-games.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/games/deepdelve.html", "changefreq": "monthly", "priority": "0.8"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v1.0.0-self-hosting.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v0.6.0-fleets.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
push {"url": "https://jesunahmadushno.github.io/jesun-code/blog/v0.4.0-jpm-packages.html", "changefreq": "never", "priority": "0.7"} to sitemap_entries
site["sitemap_urls"] is sitemap_entries

note ---- link-list helper: the footer columns and custom navs ----
to build_links with pairs
    out is []
    for each p in pairs
        push {"label": p[1], "href": p[0]} to out
    give back out

