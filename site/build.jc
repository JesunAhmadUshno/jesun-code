note ---- pages ----
pages is []
home is a new table
home["path"] is "index.html"
home["title"] is "Jesun.Code: The programming language that reads like plain English"
home["description"] is "Jesun.Code is a programming language that reads like plain English. AI agents, the whole Python ecosystem, a Bangla keyword flavor, zero-install binaries for Windows, macOS and Linux."
home["canonical"] is "https://jesunahmadushno.github.io/jesun-code/"
home["root_prefix"] is ""
home["github_svg"] is true
home["og_description"] is "If a sentence makes sense to a person, it should make sense to the machine. AI agents, the Python ecosystem, a Bangla flavor, one binary."
home["twitter_description"] is "If a sentence makes sense to a person, it should make sense to the machine. AI agents, the Python ecosystem, a Bangla flavor, one binary."
home["foot_stroke"] is true
home["gap_before_jsonld"] is true
home["gap_after_body_tag"] is true
read file "site/content/index.body.html" giving home_body
home["body"] is home_body
read file "site/content/index.jsonld" giving home_jsonld
home["jsonld"] is home_jsonld
push home to pages

