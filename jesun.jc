note ============================================================
note jesun.jc: the Jesun.Code interpreter, written in Jesun.Code.
note Phase A (spec docs/spec-v1.0.md): the v0.1 core. The Python
note interpreter is the bootstrap; this file is the interpreter.
note Run it: python jesun.py jesun.jc program.jc
note Tokens are [kind, value, line]. Keyword kinds are the words
note themselves; "name", "number", "text" for the rest; punctuation
note kinds are the single characters; "indent", "dedent", "eof".
note
note Phase B part 1 (spec section 7): the walker delegates stdin, file
note I/O, and the Python bridge to the bootstrap through these imports.
note They run once, when the bootstrap loads this file.
note ============================================================

import builtins
import sys
import pathlib
import os
import importlib.util
import operator
import difflib
import pkgutil
import unicodedata

note ---- ask ai bridge source (spec 8.2): one CONSTANT Python template
note defining the mind-protocol helpers (_jc_ai_run, _jc_ai_argv,
note _jc_ai_once, _jc_ai_stream, _jc_call_match, _jc_ai_detail).
note Security review: the template never contains program text; user
note data travels only as values in the helper arguments. It cannot
note raise: every outcome is a ["code", ...] list. The walker maps
note codes to plain-English errors at the target line (ai_finish).
_AI_HELPERS_SRC is join of ["# Jesun.Code \"ask ai\" bridge helpers (spec 8.2). CONSTANT source: no", "# program text ever reaches it; user data arrives only as arguments.", "# Nothing here raises: every outcome is [\"ok\", answer] or an error", "# code list, so the walker keeps the target program's line numbers.", "def _jc_ai_detail(text):", "    import re", "    first = (text or \"\").strip().split(\"\\n\")[0][:160]", "    if not first:", "        return \"\"", "    if re.search(r'Traceback|File \"|^\\w*Error:|0x[0-9a-fA-F]+', first):", "        return \"\"", "    return first", "def _jc_ai_argv():", "    import os", "    import shlex", "    command = os.environ.get(\"JESUNCODE_AI_COMMAND\", \"\").strip()", "    if not command:", "        return [\"missing\"]", "    if os.name == \"nt\":", "        argv = []", "        for token in shlex.split(command, posix=False):", "            if len(token) >= 2 and token.startswith('\"') and token.endswith('\"'):", "                token = token[1:-1]", "            argv.append(token)", "    else:", "        argv = shlex.split(command)", "    if not argv:", "        return [\"missing\"]", "    return [\"ok\", argv]", "def _jc_ai_once(argv, prompt):", "    import subprocess", "    try:", "        proc = subprocess.run(argv, input=prompt, capture_output=True, text=True, timeout=60)", "    except FileNotFoundError:", "        return [\"not_found\"]", "    except subprocess.TimeoutExpired:", "        return [\"timeout\"]", "    except Exception:", "        return [\"talk\"]", "    if proc.returncode != 0:", "        return [\"bad_exit\", _jc_ai_detail(proc.stderr or \"\")]", "    out = proc.stdout or \"\"", "    if out.endswith(\"\\n\"):", "        out = out[:-1]", "    if out.endswith(\"\\r\"):", "        out = out[:-1]", "    return [\"ok\", out]", "def _jc_ai_stream(argv, prompt, stdout):", "    import codecs", "    import queue", "    import subprocess", "    import threading", "    import time", "    try:", "        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)", "    except FileNotFoundError:", "        return [\"not_found\"]", "    except Exception:", "        return [\"talk\"]", "    chunks = []", "    try:", "        proc.stdin.write(prompt)", "        proc.stdin.close()", "        raw_out = proc.stdout.buffer", "        pending = queue.Queue()", "        eof = object()", "        def _reader():", "            decoder = codecs.getincrementaldecoder(\"utf-8\")()", "            carry = \"\"", "            while True:", "                data = raw_out.read1(4096)", "                if not data:", "                    break", "                text = carry + decoder.decode(data)", "                if text.endswith(\"\\r\"):", "                    carry = \"\\r\"", "                    text = text[:-1]", "                else:", "                    carry = \"\"", "                text = text.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")", "                if text:", "                    pending.put(text)", "            tail = carry + decoder.decode(b\"\", final=True)", "            tail = tail.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")", "            if tail:", "                pending.put(tail)", "            pending.put(eof)", "        reader = threading.Thread(target=_reader, daemon=True)", "        reader.start()", "        deadline = time.monotonic() + 60", "        while True:", "            remaining = deadline - time.monotonic()", "            if remaining <= 0:", "                proc.kill()", "                return [\"timeout\"]", "            try:", "                item = pending.get(timeout=remaining)", "            except queue.Empty:", "                proc.kill()", "                return [\"timeout\"]", "            if item is eof:", "                break", "            stdout.write(item)", "            stdout.flush()", "            chunks.append(item)", "        proc.wait(timeout=5)", "    except Exception:", "        try:", "            proc.kill()", "        except Exception:", "            pass", "        return [\"talk\"]", "    if proc.returncode != 0:", "        return [\"bad_exit\", \"\"]", "    out = \"\".join(chunks)", "    if out.endswith(\"\\n\"):", "        out = out[:-1]", "    if out.endswith(\"\\r\"):", "        out = out[:-1]", "    return [\"ok\", out]", "def _jc_call_match(line):", "    import re", "    m = re.match(r\"^CALL:\\s*([A-Za-z_][A-Za-z0-9_]*)\\((.*)\\)\\s*$\", line.strip())", "    if not m:", "        return []", "    return [m.group(1), m.group(2)]", "def _jc_ai_run(prompt, streaming, stdout):", "    try:", "        r = _jc_ai_argv()", "        if r[0] == \"missing\":", "            return [\"missing\"]", "        argv = r[1]", "        if streaming:", "            return _jc_ai_stream(argv, prompt, stdout)", "        return _jc_ai_once(argv, prompt)", "    except Exception:", "        return [\"talk\"]", ""] with "\n"

note ---- agent memory bridge source (spec 8.3): one CONSTANT Python template
note defining the memory-path/load/save/forget helpers (_jc_agent_mempath,
note _jc_agent_load, _jc_agent_save, _jc_agent_forget). Same contract as
note _AI_HELPERS_SRC: never contains program text, never raises, every
note outcome is a ["code", ...] list.
_AGENT_HELPERS_SRC is join of ["# Jesun.Code \"agents\" bridge helpers (spec 8.3). CONSTANT source: no", "# program text ever reaches it; user data arrives only as arguments.", "# Nothing here raises: every outcome is a [\"code\", ...] list, so the", "# walker keeps the target program's line numbers.", "def _jc_agent_mempath(name, memfile):", "    import os", "    from pathlib import Path", "    if memfile:", "        return memfile", "    override = os.environ.get(\"JESUN_CODE_HOME\", \"\").strip()", "    base = Path(override) if override else Path.home() / \".jesun-code\"", "    safe = \"\".join(c if (c.isalnum() or c in \"-_\") else \"_\" for c in name)", "    return str(base / \"memory\" / ((safe or \"agent\") + \".json\"))", "", "def _jc_agent_load(path):", "    import json", "    from pathlib import Path", "    try:", "        raw = Path(path).read_text(encoding=\"utf-8\")", "    except FileNotFoundError:", "        return [\"missing\"]", "    except OSError:", "        return [\"unreadable\"]", "    try:", "        data = json.loads(raw)", "        if not isinstance(data, list):", "            raise ValueError(\"bad memory\")", "        turns = []", "        for item in data:", "            if not isinstance(item, (list, tuple)) or len(item) != 2:", "                raise ValueError(\"bad turn\")", "            prompt_text, answer_text = item", "            if not isinstance(prompt_text, str) or not isinstance(answer_text, str):", "                raise ValueError(\"bad turn\")", "            turns.append([prompt_text, answer_text])", "        return [\"ok\", turns]", "    except Exception:", "        return [\"unreadable\"]", "", "def _jc_agent_save(path, turns):", "    import json", "    from pathlib import Path", "    try:", "        target = Path(path)", "        target.parent.mkdir(parents=True, exist_ok=True)", "        kept = turns[-200:]", "        target.write_text(json.dumps(kept, ensure_ascii=False, indent=1), encoding=\"utf-8\")", "        return [\"ok\"]", "    except Exception:", "        return [\"failed\"]", "", "def _jc_agent_forget(path):", "    from pathlib import Path", "    try:", "        Path(path).unlink()", "        return [\"ok\"]", "    except FileNotFoundError:", "        return [\"missing\"]", "    except OSError:", "        return [\"failed\"]"] with "\n"

note ---- jpm package-find bridge source (spec 8.4): one CONSTANT Python template
note defining _jc_jpm_find (mirrors the bootstrap _jpm_find dir scan).
note Same contract as _AI_HELPERS_SRC: never contains program text,
note never raises, every outcome is a ["code", ...] list.
_JPM_HELPERS_SRC is join of ["# Jesun.Code \"bring in\" bridge helper (spec 8.4). CONSTANT source: no", "# program text ever reaches it; user data arrives only as arguments.", "# Nothing here raises: every outcome is a [\"code\", ...] list, so the", "# walker keeps the target program's line numbers.", "def _jc_jpm_find(name):", "    import os", "    from pathlib import Path", "    override = os.environ.get(\"JESUN_CODE_HOME\", \"\").strip()", "    base = Path(override) if override else Path.home() / \".jesun-code\"", "    pkgs = base / \"packages\"", "    try:", "        if not pkgs.is_dir():", "            return [\"missing\"]", "        hosts = sorted(p for p in pkgs.iterdir() if p.is_dir())", "    except OSError:", "        return [\"missing\"]", "    for host_dir in hosts:", "        try:", "            users = sorted(p for p in host_dir.iterdir() if p.is_dir())", "        except OSError:", "            continue", "        for user_dir in users:", "            candidate = user_dir / name", "            try:", "                if candidate.is_dir():", "                    return [\"ok\", str(candidate)]", "            except OSError:", "                continue", "    return [\"missing\"]", ""] with "\n"

note ---- fleet memory bridge source (spec 8.4): one CONSTANT Python template
note defining the fleet memory load/save helpers (_jc_fleet_load,
note _jc_fleet_save). Same contract as _AGENT_HELPERS_SRC: never
note contains program text, never raises, every outcome is a
note ["code", ...] list.
_FLEET_HELPERS_SRC is join of ["# Jesun.Code \"fleet\" bridge helpers (spec 8.4). CONSTANT source: no", "# program text ever reaches it; user data arrives only as arguments.", "# Nothing here raises: every outcome is a [\"code\", ...] list, so the", "# walker keeps the target program's line numbers.", "def _jc_fleet_load(path):", "    import json", "    from pathlib import Path", "    try:", "        raw = Path(path).read_text(encoding=\"utf-8\")", "    except FileNotFoundError:", "        return [\"missing\"]", "    except OSError:", "        return [\"unreadable\"]", "    try:", "        data = json.loads(raw)", "        if not isinstance(data, list):", "            raise ValueError(\"bad memory\")", "        triples = []", "        for item in data:", "            if not isinstance(item, (list, tuple)) or len(item) != 3:", "                raise ValueError(\"bad triple\")", "            q, a, who = item", "            if not isinstance(q, str) or not isinstance(a, str) or not isinstance(who, str):", "                raise ValueError(\"bad triple\")", "            triples.append([q, a, who])", "        return [\"ok\", triples]", "    except Exception:", "        return [\"unreadable\"]", "", "def _jc_fleet_save(path, triples):", "    import json", "    from pathlib import Path", "    try:", "        target = Path(path)", "        target.parent.mkdir(parents=True, exist_ok=True)", "        kept = triples[-200:]", "        target.write_text(json.dumps(kept, ensure_ascii=False, indent=1), encoding=\"utf-8\")", "        return [\"ok\"]", "    except Exception:", "        return [\"failed\"]", ""] with "\n"

note ==== SECTION: HELPERS ====

to parse_error with lineno and msg
    fail with "Line " + text of lineno + ": " + msg

to bridge_is_digit with ch
    ns is builtins.dict([["__jc_c", ch]])
    give back builtins.eval("__jc_c.isdigit()", ns)

to bridge_is_alpha with ch
    ns is builtins.dict([["__jc_c", ch]])
    give back builtins.eval("__jc_c.isalpha()", ns)

to bridge_is_word_char with ch
    ns is builtins.dict([["__jc_c", ch]])
    give back builtins.eval("__jc_c.isalnum() or __jc_c == '_' or __import__('unicodedata').category(__jc_c).startswith('M')", ns)

to bridge_number_text with digits
    ns is builtins.dict([["__jc_t", digits]])
    give back builtins.eval("(__import__('builtins').int(__jc_t) if __jc_t.isdecimal() else (__import__('builtins').float(__jc_t) if __jc_t.replace('.', '', 1).isdecimal() else 'NAN'))", ns)

to bridge_dict_keys with v
    ns is builtins.dict([["__jc_v", v]])
    give back builtins.eval("list(__jc_v.keys()) if isinstance(__jc_v, dict) else None", ns)

to is_digit with ch
    give back bridge_is_digit with ch

to is_word_start with ch
    if ch is "_" then
        give back true
    if "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" contains ch then
        give back true
    note Bangla mode: any letter starts a word, mirroring the
    note bootstrap's ch.isalpha(). Combining marks never start one.
    give back bridge_is_alpha with ch

to is_word_char with ch
    note Mirrors the bootstrap's is_word_char exactly: alnum, "_",
    note or a combining mark (unicodedata category M). Symbols like
    note arrows end the word on both sides now.
    give back bridge_is_word_char with ch

to pop_last with xs
    trimmed is []
    total is length of xs
    n is 1
    for each x in xs
        if n is less than total then
            push x to trimmed
        n is n + 1
    give back trimmed

to strip_bom with source
    bom is "﻿"
    chars is characters of source
    n is length of chars
    i is 0
    repeat while i is less than n
        if chars[i] is not bom then
            stop
        i is i + 1
    out is ""
    j is i
    repeat while j is less than n
        out is out + chars[j]
        j is j + 1
    give back out

note ==== END HELPERS ====

note ==== SECTION: LEXER ====

kinds is [["show", "show"], ["is", "is"], ["not", "not"], ["true", "true"], ["false", "false"], ["nothing", "nothing"], ["if", "if"], ["then", "then"], ["otherwise", "otherwise"], ["repeat", "repeat"], ["times", "times"], ["while", "while"], ["for", "for"], ["each", "each"], ["in", "in"], ["to", "to"], ["with", "with"], ["and", "and"], ["or", "or"], ["give", "give"], ["back", "back"], ["stop", "stop"], ["skip", "skip"], ["of", "of"], ["first", "first"], ["last", "last"], ["length", "length"], ["uppercase", "uppercase"], ["lowercase", "lowercase"], ["greater", "greater"], ["less", "less"], ["than", "than"], ["least", "least"], ["most", "most"], ["at", "at"], ["contains", "contains"], ["split", "split"], ["join", "join"], ["trim", "trim"], ["by", "by"], ["push", "push"], ["characters", "characters"], ["text", "text"], ["kind", "kind"], ["fail", "fail"], ["ask", "ask"], ["giving", "giving"], ["read", "read"], ["write", "write"], ["append", "append"], ["file", "file"], ["import", "import"], ["as", "as"], ["keys", "keys"], ["ai", "ai"], ["tools", "tools"], ["within", "within"], ["steps", "steps"], ["open", "open"], ["terminal", "terminal"], ["named", "named"], ["send", "send"], ["close", "close"], ["agent", "agent"], ["persona", "persona"], ["remember", "remember"], ["always", "always"], ["forget", "forget"], ["memory", "memory"], ["streaming", "streaming"], ["use", "use"], ["fleet", "fleet"], ["bring", "bring"]]

note Bangla keyword flavor (spec v0.5 s23): mirrors the bootstrap's
note BANGLA_KEYWORDS one for one, mapping to the same walker kinds.
bangla_kinds is [["অথবা", "or"], ["আছে", "contains"], ["আনো", "import"], ["আবার", "repeat"], ["এআই", "ai"], ["এজেন্ট", "agent"], ["এড়িয়ে", "skip"], ["এবং", "and"], ["এর", "of"], ["কমপক্ষে", "least"], ["খোলো", "open"], ["চাবি", "keys"], ["চেয়ে", "than"], ["ছাঁটো", "trim"], ["ছোট", "less"], ["ছোটহাতা", "lowercase"], ["জন্য", "for"], ["জন্যে", "to"], ["জিজ্ঞেস", "ask"], ["জোড়া", "join"], ["টার্মিনাল", "terminal"], ["তাহলে", "then"], ["থামো", "stop"], ["দল", "fleet"], ["দাও", "give"], ["দিয়ে", "by"], ["দেখাও", "show"], ["দৈর্ঘ্য", "length"], ["ধাপ", "steps"], ["নইলে", "otherwise"], ["নম্বরে", "at"], ["না", "not"], ["নামে", "named"], ["নিয়ে", "bring"], ["পড়ো", "read"], ["পাঠাও", "send"], ["পারসোনা", "persona"], ["প্রতিটি", "each"], ["প্রথম", "first"], ["ফাঁকা", "nothing"], ["ফাইল", "file"], ["ফেরত", "back"], ["বড়", "greater"], ["বড়হাতা", "uppercase"], ["বন্ধকরো", "close"], ["বার", "times"], ["ব্যবহার", "use"], ["ভাগ", "split"], ["ভুলেযাও", "forget"], ["ভেতরে", "in"], ["মধ্যে", "within"], ["মনেকরো", "remember"], ["মিথ্যা", "false"], ["যতক্ষণ", "while"], ["যদি", "if"], ["যোগকরো", "append"], ["রেখে", "giving"], ["লেখো", "write"], ["শেষ", "last"], ["সত্য", "true"], ["সবচেয়ে", "most"], ["সবসময়", "always"], ["সরাসরি", "streaming"], ["সহ", "with"], ["স্মৃতি", "memory"], ["হয়", "is"], ["হাতিয়ার", "tools"], ["হিসেবে", "as"]]

to keyword_kind with word and bangla
    table is kinds
    if bangla then
        table is bangla_kinds
    for each pair in table
        if pair[0] is word then
            give back pair[1]
    give back "name"

to simple_kind with ch
    pairs is [["+", "+"], ["-", "-"], ["*", "*"], ["/", "/"], ["%", "%"], ["(", "("], [")", ")"], ["[", "["], ["]", "]"], [",", ","], [".", "."], ["=", "="]]
    for each pair in pairs
        if pair[0] is ch then
            give back pair[1]
    give back ""

to is_comment_here with cs and i and n and word
    note The comment word is "note" in English mode, "মন্তব্য" in
    note Bangla mode. Header detection always reads in English mode.
    wcs is characters of word
    wlen is length of wcs
    if i + wlen is greater than n then
        give back false
    j is 0
    repeat while j is less than wlen
        if cs[i + j] is not wcs[j] then
            give back false
        j is j + 1
    before_ok is true
    if i is greater than 0 then
        before_ok is not is_word_char with cs[i - 1]
    after_ok is true
    if i + wlen is less than n then
        after_ok is not is_word_char with cs[i + wlen]
    give back before_ok and after_ok

to cut_comment with rawline and comment_word
    out is ""
    cs is characters of rawline
    n is length of cs
    i is 0
    quote is ""
    repeat while i is less than n
        ch is cs[i]
        if quote is not "" then
            if ch is "\\" and i + 1 is less than n then
                out is out + ch + cs[i + 1]
                i is i + 2
                skip
            if ch is quote then
                quote is ""
            out is out + ch
            i is i + 1
            skip
        if ch is "\"" or ch is "'" then
            quote is ch
            out is out + ch
            i is i + 1
            skip
        if is_comment_here with cs and i and n and comment_word then
            give back out
        out is out + ch
        i is i + 1
    give back out

to bangla_header with source
    note Mirrors the bootstrap's _bangla_header_lineno: the first
    note non-blank line (blank after cutting an English "note"
    note comment), exactly "use bangla" or the lone word "বাংলা".
    lineno is 0
    for each rawline in split of source by "\n"
        lineno is lineno + 1
        cleaned is cut_comment with rawline and "note"
        if trim of cleaned is not "" then
            if trim of cleaned is "use bangla" or trim of cleaned is "বাংলা" then
                give back lineno
            give back 0
    give back 0

to count_leading_spaces with given_line
    n is 0
    for each ch in characters of given_line
        if ch is " " then
            n is n + 1
        otherwise
            give back n
    give back n

to read_string with cs and i and n and lineno
    quote is cs[i]
    i is i + 1
    out is ""
    repeat while i is less than n
        ch is cs[i]
        if ch is "\\" and i + 1 is less than n then
            nxt is cs[i + 1]
            if nxt is "n" then
                out is out + "\n"
            otherwise if nxt is "t" then
                out is out + "\t"
            otherwise if nxt is "\"" then
                out is out + "\""
            otherwise if nxt is "'" then
                out is out + "'"
            otherwise if nxt is "\\" then
                out is out + "\\"
            otherwise
                out is out + nxt
            i is i + 2
            skip
        if ch is quote then
            give back [["string", out, lineno], i + 1]
        out is out + ch
        i is i + 1
    parse_error with lineno and "this text never ends; close the quote."

to read_number with cs and i and n and lineno
    note The digit run is text until the bridge converts it: the
    note bootstrap accepts any isdigit() run (Bengali digits work) and
    note converts with int()/float(), failing "I did not expect" when
    note the run is not decimal (e.g. a lone superscript 2).
    digits is ""
    repeat while i is less than n and is_digit with cs[i]
        digits is digits + cs[i]
        i is i + 1
    if i + 1 is less than n and cs[i] is "." and is_digit with cs[i + 1] then
        digits is digits + "."
        i is i + 1
        repeat while i is less than n and is_digit with cs[i]
            digits is digits + cs[i]
            i is i + 1
    val is bridge_number_text with digits
    if val is "NAN" then
        note The bootstrap's lexer reports this with no line prefix
        note (its unexpected-exception path), so the bare fail matches.
        fail with "I hit something I did not expect and stopped instead of guessing."
    give back [["number", val, lineno], i]

to read_word with cs and i and n and lineno and bangla
    word is ""
    repeat while i is less than n and is_word_char with cs[i]
        word is word + cs[i]
        i is i + 1
    give back [[keyword_kind with word and bangla, word, lineno], i]

to lex_line with stripped and lineno and bangla
    toks is []
    cs is characters of stripped
    n is length of cs
    i is 0
    repeat while i is less than n
        ch is cs[i]
        note Whitespace skip. CR never reaches here: lex trims each line
        note first, and the "\r" escape reads as "r" in literals anyway.
        if ch is " " or ch is "\t" then
            i is i + 1
            skip
        if ch is "\"" or ch is "'" then
            pair is read_string with cs and i and n and lineno
            push pair[0] to toks
            i is pair[1]
            skip
        if is_digit with ch then
            pair is read_number with cs and i and n and lineno
            push pair[0] to toks
            i is pair[1]
            skip
        if is_word_start with ch then
            pair is read_word with cs and i and n and lineno and bangla
            push pair[0] to toks
            i is pair[1]
            skip
        skind is simple_kind with ch
        if skind is not "" then
            push [skind, ch, lineno] to toks
            i is i + 1
            skip
        parse_error with lineno and "I do not know what \"" + ch + "\" means here."
    give back toks

to lex with source and header and bangla
    source is strip_bom with source
    toks is []
    indents is [0]
    lineno is 0
    comment_word is "note"
    if bangla then
        comment_word is "মন্তব্য"
    for each rawline in split of source by "\n"
        lineno is lineno + 1
        if lineno is header then
            skip
        cleaned is cut_comment with rawline and comment_word
        if cleaned contains "\t" and trim of cleaned is not "" then
            parse_error with lineno and "I do not understand tabs; please indent with spaces."
        if trim of cleaned is "" then
            skip
        indent is count_leading_spaces with cleaned
        if indent is greater than last of indents then
            push indent to indents
            push ["indent", "", lineno] to toks
        otherwise
            repeat while indent is less than last of indents
                indents is pop_last with indents
                push ["dedent", "", lineno] to toks
            if indent is not last of indents then
                parse_error with lineno and "this line does not line up with any block I opened."
        for each tok in lex_line with trim of cleaned and lineno and bangla
            push tok to toks
        push ["newline", "", lineno] to toks
    repeat while length of indents is greater than 1
        indents is pop_last with indents
        push ["dedent", "", lineno] to toks
    push ["eof", "", lineno] to toks
    give back toks

note ==== END LEXER ====

note ==== SECTION: PARSER ====
note Every parse function takes the token list and a position, and gives
note back [node, new_position]. Nodes are lists with a tag word first.

to peek_kind with toks and i
    give back toks[i][0]

to peek_value with toks and i
    give back toks[i][1]

to peek_line with toks and i
    give back toks[i][2]

to peek_is with toks and i and want
    k is peek_kind with toks and i
    give back k is want

to expect with toks and i and want and what
    k is peek_kind with toks and i
    if k is want then
        give back i + 1
    ln is peek_line with toks and i
    parse_error with ln and "I expected " + what + " here."

to parse_program with toks
    i is 0
    stmts is []
    repeat while not peek_is with toks and i and "eof"
        pair is parse_statement with toks and i
        push pair[0] to stmts
        i is pair[1]
    give back stmts

to parse_block with toks and i
    if not peek_is with toks and i and "indent" then
        ln is peek_line with toks and i
        parse_error with ln and "I expected an indented block here."
    i is i + 1
    stmts is []
    repeat while not peek_is with toks and i and "dedent"
        if peek_is with toks and i and "eof" then
            ln is peek_line with toks and i
            parse_error with ln and "this block never ends."
        pair is parse_statement with toks and i
        push pair[0] to stmts
        i is pair[1]
    give back [stmts, i + 1]

to parse_show with toks and i
    ln is peek_line with toks and i
    pair is parse_or with toks and i + 1
    i is expect with toks and pair[1] and "newline" and "the end of the line"
    give back [["show", pair[0], ln], i]

to parse_assign with toks and i
    name is peek_value with toks and i
    ln is peek_line with toks and i
    pair is parse_or with toks and i + 2
    i is expect with toks and pair[1] and "newline" and "the end of the line"
    give back [["is", name, pair[0], ln], i]

to parse_push with toks and i
    ln is peek_line with toks and i
    pair is parse_or with toks and i + 1
    i is expect with toks and pair[1] and "to" and "\"to\""
    name is peek_value with toks and i
    i is expect with toks and i and "name" and "a list name after \"to\""
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["push", pair[0], name, ln], i]

to parse_fail with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "with" and "\"with\""
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "newline" and "the end of the line"
    give back [["fail", pair[0], ln], i]

note ---- phase B part 1: ask, file I/O, import (spec section 7) ----

to parse_ask with toks and i
    ln is peek_line with toks and i
    i is i + 1
    if peek_is with toks and i and "ai" then
        give back parse_ask_ai with toks and i
    if peek_is with toks and i and "name" then
        if not peek_is with toks and i + 1 and "giving" then
            give back parse_ask_agent with toks and i
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "giving" and "\"giving\" followed by a name"
    name is peek_value with toks and i
    i is expect with toks and i and "name" and "a name to store the answer in"
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["ask", pair[0], name, ln], i]

to parse_ask_ai with toks and i
    ln is peek_line with toks and i
    i is i + 1
    pair is parse_or with toks and i
    i is pair[1]
    toolnames is []
    max_steps is 10
    if peek_is with toks and i and "with" then
        i is i + 1
        i is expect with toks and i and "tools" and "\"tools\""
        i is expect with toks and i and "[" and "\"[\" around the tool names"
        if not peek_is with toks and i and "]" then
            push peek_value with toks and i to toolnames
            i is expect with toks and i and "name" and "a tool name"
            repeat while peek_is with toks and i and ","
                i is i + 1
                push peek_value with toks and i to toolnames
                i is expect with toks and i and "name" and "a tool name"
        i is expect with toks and i and "]" and "a closing \"]\""
        if peek_is with toks and i and "within" then
            i is i + 1
            sln is peek_line with toks and i
            sval is peek_value with toks and i
            i is expect with toks and i and "number" and "a number of steps"
            if not builtins.isinstance(sval, builtins.int) or sval is less than 1 then
                parse_error with sln and "\"within\" needs a whole number of steps, at least 1."
            max_steps is sval
            i is expect with toks and i and "steps" and "\"steps\""
    i is expect with toks and i and "giving" and "\"giving\" followed by a name"
    name is peek_value with toks and i
    i is expect with toks and i and "name" and "a name to store the answer in"
    dostream is false
    if peek_is with toks and i and "streaming" then
        i is i + 1
        dostream is true
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["askai", pair[0], toolnames, max_steps, name, dostream, ln], i]

to parse_ask_agent with toks and i
    ln is peek_line with toks and i
    aname is peek_value with toks and i
    i is expect with toks and i and "name" and "an agent name"
    pair is parse_or with toks and i
    i is pair[1]
    i is expect with toks and i and "giving" and "\"giving\" followed by a name"
    name is peek_value with toks and i
    i is expect with toks and i and "name" and "a name to store the answer in"
    dostream is false
    if peek_is with toks and i and "streaming" then
        i is i + 1
        dostream is true
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["askagent", aname, pair[0], name, dostream, ln], i]

to parse_forget with toks and i
    ln is peek_line with toks and i
    name is peek_value with toks and i + 1
    i is expect with toks and i + 1 and "name" and "an agent name to forget"
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["forget", name, ln], i]

to parse_agent_is_or_are with toks and i
    if peek_is with toks and i and "is" then
        give back i + 1
    if peek_is with toks and i and "name" then
        w is peek_value with toks and i
        if w is "are" then
            give back i + 1
    ln is peek_line with toks and i
    parse_error with ln and "I expected \"is\" or \"are\" here."

to agent_dup_check with seen and field and fline
    if seen contains field then
        parse_error with fline and "\"" + field + "\" is already set for this agent."
    push field to seen
    give back nothing

to parse_agentdef with toks and i
    ln is peek_line with toks and i
    name is peek_value with toks and i + 1
    i is expect with toks and i + 1 and "name" and "a name for the agent"
    i is expect with toks and i and "newline" and "the end of the line"
    if not peek_is with toks and i and "indent" then
        eln is peek_line with toks and i
        parse_error with eln and "an agent needs an indented block of settings."
    i is i + 1
    per is nothing
    toolnames is []
    rmode is "off"
    memfile is nothing
    max_steps is 10
    seen is []
    repeat while not peek_is with toks and i and "dedent"
        if peek_is with toks and i and "eof" then
            eln is peek_line with toks and i
            parse_error with eln and "this block never ends."
        fline is peek_line with toks and i
        fkind is peek_kind with toks and i
        if fkind is "persona" then
            agent_dup_check with seen and "persona" and fline
            i is i + 1
            i is expect with toks and i and "is" and "\"is\""
            pair is parse_or with toks and i
            per is pair[0]
            i is pair[1]
        otherwise if fkind is "tools" then
            agent_dup_check with seen and "tools" and fline
            i is i + 1
            i is parse_agent_is_or_are with toks and i
            i is expect with toks and i and "[" and "\"[\" around the tool names"
            if not peek_is with toks and i and "]" then
                push peek_value with toks and i to toolnames
                i is expect with toks and i and "name" and "a tool name"
                repeat while peek_is with toks and i and ","
                    i is i + 1
                    push peek_value with toks and i to toolnames
                    i is expect with toks and i and "name" and "a tool name"
            i is expect with toks and i and "]" and "a closing \"]\""
        otherwise if fkind is "remember" then
            agent_dup_check with seen and "remember" and fline
            i is i + 1
            i is expect with toks and i and "is" and "\"is\""
            if peek_is with toks and i and "true" then
                i is i + 1
                rmode is "run"
            otherwise if peek_is with toks and i and "false" then
                i is i + 1
                rmode is "off"
            otherwise if peek_is with toks and i and "always" then
                i is i + 1
                rmode is "always"
            otherwise
                eln is peek_line with toks and i
                parse_error with eln and "\"remember\" needs true, false, or always."
        otherwise if fkind is "memory" then
            agent_dup_check with seen and "memory file" and fline
            i is i + 1
            i is expect with toks and i and "file" and "\"file\""
            i is expect with toks and i and "is" and "\"is\""
            pair is parse_or with toks and i
            memfile is pair[0]
            i is pair[1]
        otherwise if fkind is "steps" then
            agent_dup_check with seen and "steps" and fline
            i is i + 1
            i is parse_agent_is_or_are with toks and i
            sln is peek_line with toks and i
            sval is peek_value with toks and i
            i is expect with toks and i and "number" and "a number of steps"
            if not builtins.isinstance(sval, builtins.int) or sval is less than 1 then
                parse_error with sln and "\"steps\" needs a whole number of steps, at least 1."
            max_steps is sval
        otherwise
            if fkind is "name" then
                got is peek_value with toks and i
            otherwise
                got is fkind
            parse_error with fline and "I do not know the agent setting \"" + got + "\". I know: persona, tools, remember, steps, memory file."
        i is expect with toks and i and "newline" and "the end of the line"
    i is i + 1
    give back [["agentdef", name, per, toolnames, rmode, memfile, max_steps, ln], i]

note ---- later-phase statements (spec 8.4): the walker parses use,
note bring, and the tmux terminal statements exactly like the
note bootstrap, so every parse error matches word for word. Execution
note is not implemented yet: valid shapes fail at run time with the
note honest later-phase message (later_phase_error). Fleets parse the
note same way and now EXECUTE (exec_fleetdef, spec 8.4); "terminal" and
note "within" are not statement starters in the bootstrap either; they
note fall through to parse_or below.

to later_phase_error with ln and word
    rt_error with ln and "\"" + word + "\" is for a later phase; this interpreter does not speak it yet."

to parse_usepkg with toks and i
    ln is peek_line with toks and i
    pair is parse_or with toks and i + 1
    i is pair[1]
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["usepkg", pair[0], ln], i]

to parse_bringin with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "in" and "\"in\""
    pair is parse_or with toks and i
    i is pair[1]
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["bringin", pair[0], ln], i]

to parse_termopen with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "terminal" and "\"terminal\""
    i is expect with toks and i and "named" and "\"named\""
    pair is parse_or with toks and i
    i is pair[1]
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["termopen", pair[0], ln], i]

to parse_termsend with toks and i
    ln is peek_line with toks and i
    pair is parse_or with toks and i + 1
    cmd is pair[0]
    i is pair[1]
    i is expect with toks and i and "to" and "\"to\""
    i is expect with toks and i and "terminal" and "\"terminal\""
    pair is parse_or with toks and i
    i is pair[1]
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["termsend", cmd, pair[0], ln], i]

to parse_termread with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "terminal" and "\"terminal\""
    pair is parse_or with toks and i
    i is pair[1]
    i is expect with toks and i and "giving" and "\"giving\" followed by a name"
    target is peek_value with toks and i
    i is expect with toks and i and "name" and "a name to store the output in"
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["termread", pair[0], target, ln], i]

to parse_termclose with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "terminal" and "\"terminal\""
    pair is parse_or with toks and i
    i is pair[1]
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["termclose", pair[0], ln], i]

to fleet_got with toks and i
    fkind is peek_kind with toks and i
    if fkind is "name" then
        give back peek_value with toks and i
    pairs is [["text", "string"], ["[", "lbracket"], ["]", "rbracket"], ["(", "lparen"], [")", "rparen"], [",", "comma"], [".", "dot"], ["+", "plus"], ["-", "minus"], ["*", "star"], ["/", "slash"], ["%", "percent"], ["=", "eq"]]
    for each pair in pairs
        if fkind is pair[0] then
            give back pair[1]
    give back fkind

to parse_fleetdef with toks and i
    ln is peek_line with toks and i
    name is peek_value with toks and i + 1
    i is expect with toks and i + 1 and "name" and "a name for the fleet"
    i is expect with toks and i and "with" and "\"with\""
    members is [peek_value with toks and i]
    i is expect with toks and i and "name" and "an agent name"
    repeat while peek_is with toks and i and "and"
        i is i + 1
        push peek_value with toks and i to members
        i is expect with toks and i and "name" and "an agent name"
    i is expect with toks and i and "newline" and "the end of the line"
    if not peek_is with toks and i and "indent" then
        eln is peek_line with toks and i
        parse_error with eln and "a fleet needs an indented block of asks."
    i is i + 1
    asks is []
    memfile is nothing
    repeat while not peek_is with toks and i and "dedent"
        if peek_is with toks and i and "eof" then
            eln is peek_line with toks and i
            parse_error with eln and "this block never ends."
        fline is peek_line with toks and i
        fkind is peek_kind with toks and i
        if fkind is "ask" then
            i is i + 1
            member is peek_value with toks and i
            i is expect with toks and i and "name" and "a fleet member to ask"
            if not members contains member then
                parse_error with fline and "\"" + member + "\" is not a member of fleet \"" + name + "\"."
            pair is parse_or with toks and i
            prompt is pair[0]
            i is pair[1]
            i is expect with toks and i and "giving" and "\"giving\" followed by a name"
            gname is peek_value with toks and i
            i is expect with toks and i and "name" and "a name to store the answer in"
            if peek_is with toks and i and "streaming" then
                parse_error with fline and "streaming asks cannot run in a fleet; take \"streaming\" out."
            i is expect with toks and i and "newline" and "the end of the line"
            push [member, prompt, gname, fline] to asks
        otherwise if fkind is "memory" then
            if memfile is not nothing then
                parse_error with fline and "\"memory file\" is already set for this fleet."
            i is i + 1
            i is expect with toks and i and "file" and "\"file\""
            i is expect with toks and i and "is" and "\"is\""
            pair is parse_or with toks and i
            memfile is pair[0]
            i is pair[1]
            i is expect with toks and i and "newline" and "the end of the line"
        otherwise
            got is fleet_got with toks and i
            parse_error with fline and "I do not know the fleet line \"" + got + "\". A fleet holds one ask per line, like ask scout \"is it up?\" giving answer, and optionally one line: memory file is \"crew.json\"."
    i is i + 1
    give back [["fleetdef", name, members, asks, memfile, ln], i]

to parse_readfile with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "file" and "\"file\""
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "giving" and "\"giving\" followed by a name"
    name is peek_value with toks and i
    i is expect with toks and i and "name" and "a name to store the text in"
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["readfile", pair[0], name, ln], i]

to parse_writefile with toks and i
    ln is peek_line with toks and i
    appending is peek_is with toks and i and "append"
    i is i + 1
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "to" and "\"to\""
    i is expect with toks and i and "file" and "\"file\""
    pair2 is parse_or with toks and i
    i is expect with toks and pair2[1] and "newline" and "the end of the line"
    give back [["writefile", pair[0], pair2[0], appending, ln], i]

to parse_import with toks and i
    ln is peek_line with toks and i
    i is i + 1
    name is peek_value with toks and i
    i is expect with toks and i and "name" and "a module name"
    parts is [name]
    repeat while peek_is with toks and i and "."
        i is i + 1
        name is peek_value with toks and i
        i is expect with toks and i and "name" and "a module name"
        push name to parts
    modname is join of parts with "."
    alias is ""
    if peek_is with toks and i and "as" then
        i is i + 1
        alias is peek_value with toks and i
        i is expect with toks and i and "name" and "a name for the module"
    i is expect with toks and i and "newline" and "the end of the line"
    give back [["import", modname, alias, ln], i]

to parse_if with toks and i
    ln is peek_line with toks and i
    pair is parse_or with toks and i + 1
    i is expect with toks and pair[1] and "then" and "\"then\""
    i is expect with toks and i and "newline" and "the end of the line"
    bpair is parse_block with toks and i
    branches is [[pair[0], bpair[0]]]
    i is bpair[1]
    elsebody is []
    repeat while peek_is with toks and i and "otherwise"
        i is i + 1
        if peek_is with toks and i and "if" then
            pair is parse_or with toks and i + 1
            i is expect with toks and pair[1] and "then" and "\"then\""
            i is expect with toks and i and "newline" and "the end of the line"
            bpair is parse_block with toks and i
            push [pair[0], bpair[0]] to branches
            i is bpair[1]
        otherwise
            i is expect with toks and i and "newline" and "a new line after \"otherwise\""
            bpair is parse_block with toks and i
            elsebody is bpair[0]
            i is bpair[1]
            stop
    give back [["if", branches, elsebody, ln], i]

to parse_repeat with toks and i
    ln is peek_line with toks and i
    i is i + 1
    if peek_is with toks and i and "while" then
        pair is parse_or with toks and i + 1
        i is expect with toks and pair[1] and "newline" and "the end of the line"
        bpair is parse_block with toks and i
        give back [["repeat_while", pair[0], bpair[0], ln], bpair[1]]
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "times" and "\"times\""
    i is expect with toks and i and "newline" and "the end of the line"
    bpair is parse_block with toks and i
    give back [["repeat_times", pair[0], bpair[0], ln], bpair[1]]

to parse_foreach with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "each" and "\"each\""
    varname is peek_value with toks and i
    i is expect with toks and i and "name" and "a name for each item"
    i is expect with toks and i and "in" and "\"in\""
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "newline" and "the end of the line"
    bpair is parse_block with toks and i
    give back [["foreach", varname, pair[0], bpair[0], ln], bpair[1]]

to parse_funcdef with toks and i
    ln is peek_line with toks and i
    i is i + 1
    fname is peek_value with toks and i
    i is expect with toks and i and "name" and "a name for the function"
    params is []
    if peek_is with toks and i and "with" then
        i is i + 1
        pname is peek_value with toks and i
        i is expect with toks and i and "name" and "a name for the input"
        push pname to params
        repeat while peek_is with toks and i and "and"
            i is i + 1
            pname is peek_value with toks and i
            i is expect with toks and i and "name" and "a name for the input"
            push pname to params
    i is expect with toks and i and "newline" and "the end of the line"
    bpair is parse_block with toks and i
    give back [["to", fname, params, bpair[0], ln], bpair[1]]

to parse_giveback with toks and i
    ln is peek_line with toks and i
    i is expect with toks and i + 1 and "back" and "\"back\""
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "newline" and "the end of the line"
    give back [["giveback", pair[0], ln], i]

to parse_statement with toks and i
    k is peek_kind with toks and i
    ln is peek_line with toks and i
    if k is "indent" then
        parse_error with ln and "this line starts a block, but I did not expect one here."
    if k is "show" then
        give back parse_show with toks and i
    if k is "if" then
        give back parse_if with toks and i
    if k is "repeat" then
        give back parse_repeat with toks and i
    if k is "for" then
        give back parse_foreach with toks and i
    if k is "to" then
        give back parse_funcdef with toks and i
    if k is "give" then
        give back parse_giveback with toks and i
    if k is "stop" then
        i is expect with toks and i + 1 and "newline" and "the end of the line"
        give back [["stop", ln], i]
    if k is "skip" then
        i is expect with toks and i + 1 and "newline" and "the end of the line"
        give back [["skip", ln], i]
    if k is "push" then
        give back parse_push with toks and i
    if k is "fail" then
        give back parse_fail with toks and i
    if k is "otherwise" then
        parse_error with ln and "\"otherwise\" needs an \"if\" above it."
    if k is "ask" then
        give back parse_ask with toks and i
    if k is "read" then
        if peek_is with toks and i + 1 and "file" then
            give back parse_readfile with toks and i
        give back parse_termread with toks and i
    if k is "write" or k is "append" then
        give back parse_writefile with toks and i
    if k is "import" then
        give back parse_import with toks and i
    if k is "name" then
        if peek_is with toks and i + 1 and "is" then
            give back parse_assign with toks and i
    if k is "agent" then
        give back parse_agentdef with toks and i
    if k is "forget" then
        give back parse_forget with toks and i
    if k is "use" then
        give back parse_usepkg with toks and i
    if k is "bring" then
        give back parse_bringin with toks and i
    if k is "fleet" then
        give back parse_fleetdef with toks and i
    if k is "open" then
        give back parse_termopen with toks and i
    if k is "close" then
        give back parse_termclose with toks and i
    if k is "send" then
        give back parse_termsend with toks and i
    note "terminal" and "within" are not statement starters in the
    note bootstrap either: they fall through to parse_or, which reads
    note them as a broken expression ("I expected a value here.").
    note it as a broken expression ("I expected a value here."), and the
    note self-hosted parser must say the same word for word.
    pair is parse_or with toks and i
    i is expect with toks and pair[1] and "newline" and "the end of the line"
    give back [["exprstmt", pair[0], ln], i]

to parse_or with toks and i
    pair is parse_and with toks and i
    node is pair[0]
    i is pair[1]
    repeat while peek_is with toks and i and "or"
        ln is peek_line with toks and i
        pair is parse_and with toks and i + 1
        node is ["binop", "or", node, pair[0], ln]
        i is pair[1]
    give back [node, i]

to parse_and with toks and i
    pair is parse_not with toks and i
    node is pair[0]
    i is pair[1]
    repeat while peek_is with toks and i and "and"
        ln is peek_line with toks and i
        pair is parse_not with toks and i + 1
        node is ["binop", "and", node, pair[0], ln]
        i is pair[1]
    give back [node, i]

to parse_not with toks and i
    if peek_is with toks and i and "not" then
        ln is peek_line with toks and i
        pair is parse_not with toks and i + 1
        give back [["not", pair[0], ln], pair[1]]
    give back parse_comparison with toks and i

to parse_comparison with toks and i
    pair is parse_additive with toks and i
    node is pair[0]
    i is pair[1]
    repeat while true
        k is peek_kind with toks and i
        if k is "is" then
            if peek_is with toks and i + 1 and "not" then
                ln is peek_line with toks and i
                pair is parse_additive with toks and i + 2
                node is ["compare", "ne", node, pair[0], ln]
                i is pair[1]
                skip
            ln is peek_line with toks and i
            i is i + 1
            k2 is peek_kind with toks and i
            op is "eq"
            if k2 is "greater" then
                i is expect with toks and i + 1 and "than" and "\"than\""
                op is "gt"
            otherwise if k2 is "less" then
                i is expect with toks and i + 1 and "than" and "\"than\""
                op is "lt"
            otherwise if k2 is "at" then
                i is i + 1
                k3 is peek_kind with toks and i
                if k3 is "least" then
                    i is i + 1
                    op is "ge"
                otherwise if k3 is "most" then
                    i is i + 1
                    op is "le"
                otherwise
                    ln2 is peek_line with toks and i
                    parse_error with ln2 and "I expected \"least\" or \"most\" after \"at\"."
            pair is parse_additive with toks and i
            node is ["compare", op, node, pair[0], ln]
            i is pair[1]
            skip
        if k is "contains" then
            ln is peek_line with toks and i
            pair is parse_additive with toks and i + 1
            node is ["compare", "contains", node, pair[0], ln]
            i is pair[1]
            skip
        give back [node, i]

to parse_additive with toks and i
    pair is parse_multiplicative with toks and i
    node is pair[0]
    i is pair[1]
    repeat while peek_is with toks and i and "+" or peek_is with toks and i and "-"
        ln is peek_line with toks and i
        k is peek_kind with toks and i
        pair is parse_multiplicative with toks and i + 1
        if k is "+" then
            node is ["binop", "add", node, pair[0], ln]
        otherwise
            node is ["binop", "sub", node, pair[0], ln]
        i is pair[1]
    give back [node, i]

to parse_multiplicative with toks and i
    pair is parse_unary with toks and i
    node is pair[0]
    i is pair[1]
    repeat while peek_is with toks and i and "*" or peek_is with toks and i and "/" or peek_is with toks and i and "%"
        ln is peek_line with toks and i
        k is peek_kind with toks and i
        pair is parse_unary with toks and i + 1
        if k is "*" then
            node is ["binop", "mul", node, pair[0], ln]
        otherwise if k is "/" then
            node is ["binop", "div", node, pair[0], ln]
        otherwise
            node is ["binop", "mod", node, pair[0], ln]
        i is pair[1]
    give back [node, i]

to parse_unary with toks and i
    if peek_is with toks and i and "-" then
        ln is peek_line with toks and i
        pair is parse_unary with toks and i + 1
        give back [["neg", pair[0], ln], pair[1]]
    give back parse_primary with toks and i

to parse_builtin_operand with toks and i
    if peek_is with toks and i and "name" then
        v is peek_value with toks and i
        ln is peek_line with toks and i
        give back parse_postfix with toks and i + 1 and ["var", v, ln]
    give back parse_unary with toks and i

to parse_postfix with toks and i and node
    repeat while true
        if peek_is with toks and i and "[" then
            ln is peek_line with toks and i
            pair is parse_or with toks and i + 1
            i is expect with toks and pair[1] and "]" and "a closing \"]\""
            node is ["subscript", node, pair[0], ln]
            skip
        if peek_is with toks and i and "." then
            ln is peek_line with toks and i
            ni is i + 1
            i is expect with toks and ni and "name" and "a name after the dot"
            node is ["attr", node, peek_value with toks and ni, ln]
            skip
        if peek_is with toks and i and "(" then
            ln is peek_line with toks and i
            trio is parse_call_args with toks and i + 1
            node is ["callf", node, trio[0], trio[1], ln]
            i is trio[2]
            skip
        give back [node, i]

to parse_call_args with toks and i
    args is []
    kwargs is []
    if peek_is with toks and i and ")" then
        give back [args, kwargs, i + 1]
    repeat while true
        is_kw is false
        if peek_is with toks and i and "name" then
            if peek_is with toks and i + 1 and "=" then
                is_kw is true
        if is_kw then
            kw is peek_value with toks and i
            pair is parse_or with toks and i + 2
            push [kw, pair[0]] to kwargs
            i is pair[1]
        otherwise
            if length of kwargs is greater than 0 then
                parse_error with peek_line with toks and i and "named inputs must come after the plain ones."
            pair is parse_or with toks and i
            push pair[0] to args
            i is pair[1]
        if peek_is with toks and i and "," then
            i is i + 1
            skip
        i is expect with toks and i and ")" and "a closing \")\""
        give back [args, kwargs, i]

to parse_expr_fragment with inner and ln
    toks is lex_line with trim of inner and ln and bangla_mode
    push ["newline", "", ln] to toks
    push ["eof", "", ln] to toks
    pair is parse_or with toks and 0
    i is expect with toks and pair[1] and "newline" and "the end of the {{...}}"
    give back pair[0]

to parse_string with value and ln
    if not value contains "{{" then
        give back ["lit", value, ln]
    parts is []
    buf is ""
    found is false
    cs is characters of value
    n is length of cs
    i is 0
    repeat while i is less than n
        ch is cs[i]
        if ch is "{{" then
            if i + 1 is less than n and cs[i + 1] is "{{" then
                buf is buf + "{{"
                i is i + 2
                skip
            depth is 1
            j is i + 1
            repeat while j is less than n and depth is greater than 0
                if cs[j] is "{{" then
                    depth is depth + 1
                otherwise if "}}" contains cs[j] then
                    depth is depth - 1
                j is j + 1
            if depth is not 0 then
                note A lone "}}" has no "{" so the outer bootstrap leaves
                note it two chars; last of its characters is one "}".
                parse_error with ln and "this \"{{\" never closes; add a \"" + last of characters of "x}}" + "\" to finish it."
            inner is ""
            k is i + 1
            repeat while k is less than j - 1
                inner is inner + cs[k]
                k is k + 1
            if trim of inner is "" then
                parse_error with ln and "these braces are empty; put a value inside."
            push ["text", buf] to parts
            buf is ""
            push ["expr", parse_expr_fragment with inner and ln] to parts
            found is true
            i is j
            skip
        if "}}" contains ch and i + 1 is less than n and "}}" contains cs[i + 1] then
            buf is buf + last of characters of "x}}"
            i is i + 2
            skip
        buf is buf + ch
        i is i + 1
    push ["text", buf] to parts
    if not found then
        collapsed is ""
        for each part in parts
            collapsed is collapsed + part[1]
        give back ["lit", collapsed, ln]
    give back ["interp", parts, ln]

to parse_primary with toks and i
    k is peek_kind with toks and i
    v is peek_value with toks and i
    ln is peek_line with toks and i
    if k is "number" then
        give back [["lit", v, ln], i + 1]
    if k is "string" then
        give back [parse_string with v and ln, i + 1]
    if k is "true" then
        give back [["lit", true, ln], i + 1]
    if k is "false" then
        give back [["lit", false, ln], i + 1]
    if k is "nothing" then
        give back [["lit", nothing, ln], i + 1]
    if k is "(" then
        pair is parse_or with toks and i + 1
        i is expect with toks and pair[1] and ")" and "a closing \")\""
        give back [pair[0], i]
    if k is "[" then
        i is i + 1
        items is []
        if not peek_is with toks and i and "]" then
            pair is parse_or with toks and i
            push pair[0] to items
            i is pair[1]
            repeat while peek_is with toks and i and ","
                pair is parse_or with toks and i + 1
                push pair[0] to items
                i is pair[1]
        i is expect with toks and i and "]" and "a closing \"]\""
        give back [["list", items, ln], i]
    if k is "first" or k is "last" or k is "length" or k is "uppercase" or k is "lowercase" or k is "trim" or k is "characters" or k is "text" or k is "kind" or k is "split" or k is "join" or k is "keys" then
        i is i + 1
        i is expect with toks and i and "of" and "\"of\""
        if k is "split" or k is "join" then
            pair is parse_builtin_operand with toks and i
        otherwise
            pair is parse_unary with toks and i
        operand is pair[0]
        i is pair[1]
        if k is "split" then
            i is expect with toks and i and "by" and "\"by\""
            pair is parse_unary with toks and i
            give back [["builtin2", "split", operand, pair[0], ln], pair[1]]
        if k is "join" then
            i is expect with toks and i and "with" and "\"with\""
            pair is parse_unary with toks and i
            give back [["builtin2", "join", operand, pair[0], ln], pair[1]]
        give back [["builtin", k, operand, ln], i]
    if k is "name" then
        i is i + 1
        if peek_is with toks and i and "with" then
            i is i + 1
            args is []
            pair is parse_not with toks and i
            push pair[0] to args
            i is pair[1]
            repeat while peek_is with toks and i and "and"
                pair is parse_not with toks and i + 1
                push pair[0] to args
                i is pair[1]
            give back [["call", v, args, ln], i]
        give back parse_postfix with toks and i and ["var", v, ln]
    parse_error with ln and "I expected a value here."

note ==== END PARSER ====

note ==== SECTION: EVALUATOR ====
note The tree-walker. ev gives back [value, signal]; "" means no signal,
note a list like ["stop", ln] carries one. Statement exec gives back a
note signal: ["none"], ["giveback", v, ln], ["stop", ln], ["skip", ln].
note "fail with" ends everything at once, so the walker never carries it.

to rt_error with ln and msg
    fail with "Line " + text of ln + ": " + msg

note ---- environments: a list of scopes; each scope is a list of
note [name, value] pairs. Setting always shadows in the current scope,
note which matches what the bootstrap shows from the outside.

to env_get with env and name and ln
    i is length of env
    repeat while i is greater than 0
        i is i - 1
        scope is env[i]
        j is length of scope
        repeat while j is greater than 0
            j is j - 1
            pair is scope[j]
            if pair[0] is name then
                give back pair[1]
    rt_error with ln and "I do not know the word \"" + name + "\"." + suggest_name with name and env

to env_set with env and name and value
    scope is last of env
    push [name, value] to scope

to starts_with with s and prefix
    if length of prefix is greater than length of s then
        give back false
    sc is characters of s
    pc is characters of prefix
    i is 0
    repeat while i is less than length of pc
        if sc[i] is not pc[i] then
            give back false
        i is i + 1
    give back true

to suggest_name with name and env
    seen is []
    for each scope in env
        for each pair in scope
            if not seen contains pair[0] then
                push pair[0] to seen
    for each cand in seen
        if cand is not name then
            if starts_with with cand and name or starts_with with name and cand then
                give back " Did you mean \"" + cand + "\"?"
    give back ""

note ---- value kinds and rendering

to is_function_value with v
    if kind of v is "list" then
        if length of v is 6 then
            if v[0] is "function" then
                give back true
    give back false

to is_real_list with v
    if is_function_value with v then
        give back false
    give back kind of v is "list"

to render with v
    if is_function_value with v then
        give back "<function " + v[1] + ">"
    if kind of v is "list" then
        parts is []
        for each item in v
            push render with item to parts
        give back "[" + join of parts with ", " + "]"
    give back text of v

to values_equal with a and b
    if is_function_value with a or is_function_value with b then
        give back false
    ka is kind of a
    kb is kind of b
    if ka is "true/false" or kb is "true/false" then
        if ka is "true/false" and kb is "true/false" then
            give back a is b
        give back false
    if ka is "number" and kb is "number" then
        give back a is b
    if ka is "text" and kb is "text" then
        give back a is b
    if ka is "nothing" and kb is "nothing" then
        give back true
    if ka is "python value" and kb is "python value" then
        give back a is b
    if ka is "list" and kb is "list" then
        if length of a is not length of b then
            give back false
        i is 0
        repeat while i is less than length of a
            if not values_equal with a[i] and b[i] then
                give back false
            i is i + 1
        give back true
    give back false

to subscript_index with index and len and ln and what
    if kind of index is not "number" then
        rt_error with ln and what + " needs a whole-number position in brackets."
    if index % 1 is not 0 then
        rt_error with ln and what + " needs a whole-number position in brackets."
    i is index
    if i is less than 0 then
        i is i + len
    if i is less than 0 or i is at least len then
        rt_error with ln and "position " + text of index + " is outside this " + what + " of " + text of len + "."
    give back i

note ---- expression evaluation: ev gives back [value, signal]

to ev_binop with node and env and depth
    op is node[1]
    ln is node[4]
    if op is "and" then
        p is ev with node[2] and env and depth
        if p[1] is not "" then
            give back p
        if p[0] then
            q is ev with node[3] and env and depth
            if q[1] is not "" then
                give back q
            if q[0] then
                give back [true, ""]
            give back [false, ""]
        give back [false, ""]
    if op is "or" then
        p is ev with node[2] and env and depth
        if p[1] is not "" then
            give back p
        if p[0] then
            give back [true, ""]
        q is ev with node[3] and env and depth
        if q[1] is not "" then
            give back q
        if q[0] then
            give back [true, ""]
        give back [false, ""]
    p is ev with node[2] and env and depth
    if p[1] is not "" then
        give back p
    q is ev with node[3] and env and depth
    if q[1] is not "" then
        give back q
    left is p[0]
    right is q[0]
    ln is node[4]
    if op is "add" then
        if kind of left is "number" and kind of right is "number" then
            give back [left + right, ""]
        if kind of left is "text" and kind of right is "text" then
            give back [left + right, ""]
        rt_error with ln and "I can only add numbers to numbers and text to text."
    if kind of left is not "number" or kind of right is not "number" then
        rt_error with ln and "I can only use \"-\", \"*\", \"/\" and \"%\" with numbers."
    if op is "sub" then
        give back [left - right, ""]
    if op is "mul" then
        give back [left * right, ""]
    if right is 0 then
        rt_error with ln and "I cannot divide by zero."
    if op is "div" then
        give back [left / right, ""]
    give back [left % right, ""]

to ev_compare with node and env and depth
    op is node[1]
    ln is node[4]
    p is ev with node[2] and env and depth
    if p[1] is not "" then
        give back p
    q is ev with node[3] and env and depth
    if q[1] is not "" then
        give back q
    left is p[0]
    right is q[0]
    if op is "eq" then
        if values_equal with left and right then
            give back [true, ""]
        give back [false, ""]
    if op is "ne" then
        if values_equal with left and right then
            give back [false, ""]
        give back [true, ""]
    if op is "contains" then
        if kind of left is "text" and kind of right is "text" then
            if left contains right then
                give back [true, ""]
            give back [false, ""]
        if is_real_list with left then
            for each item in left
                if values_equal with item and right then
                    give back [true, ""]
            give back [false, ""]
        rt_error with ln and "\"contains\" needs text with text, or a list."
    if kind of left is not "number" or kind of right is not "number" then
        rt_error with ln and "I can only use comparisons like this with numbers."
    if op is "gt" then
        if left is greater than right then
            give back [true, ""]
        give back [false, ""]
    if op is "lt" then
        if left is less than right then
            give back [true, ""]
        give back [false, ""]
    if op is "ge" then
        if left is at least right then
            give back [true, ""]
        give back [false, ""]
    if left is at most right then
        give back [true, ""]
    give back [false, ""]

to arity_word with name and need and got and ln
    word is "input"
    if need is not 1 then
        word is "inputs"
    rt_error with ln and "\"" + name + "\" needs " + text of need + " " + word + ", but you gave " + text of got + "."

to call_function with fn and argvals and env and depth and ln
    if depth is at least 100 then
        rt_error with ln and "the functions are calling each other too deep; I stopped before falling over."
    closure is fn[4]
    new_env is []
    for each scope in closure
        push scope to new_env
    push [] to new_env
    params is fn[2]
    i is 0
    repeat while i is less than length of params
        env_set with new_env and params[i] and argvals[i]
        i is i + 1
    sig is exec_block with fn[3] and new_env and depth + 1
    if sig[0] is "giveback" then
        give back [sig[1], ""]
    if sig[0] is "none" then
        give back [nothing, ""]
    give back [nothing, [sig[0], sig[1]]]

to ev_var with node and env and depth
    name is node[1]
    ln is node[2]
    target is env_get with env and name and ln
    if is_function_value with target then
        if length of target[2] is 0 then
            give back call_function with target and [] and env and depth and ln
    give back [target, ""]

to ev_call_expr with node and env and depth
    name is node[1]
    args is node[2]
    ln is node[3]
    target is env_get with env and name and ln
    if not is_function_value with target then
        rt_error with ln and "\"" + name + "\" is not a function I can call."
    if length of args is not length of target[2] then
        arity_word with name and length of target[2] and length of args and ln
    argvals is []
    for each a in args
        p is ev with a and env and depth
        if p[1] is not "" then
            give back p
        push p[0] to argvals
    give back call_function with target and argvals and env and depth and ln

to ev_list_lit with node and env and depth
    out is []
    for each item in node[1]
        p is ev with item and env and depth
        if p[1] is not "" then
            give back p
        push p[0] to out
    give back [out, ""]

to ev_interp with node and env and depth
    out is ""
    for each part in node[1]
        if part[0] is "text" then
            out is out + part[1]
        otherwise
            p is ev with part[1] and env and depth
            if p[1] is not "" then
                give back p
            out is out + render with p[0]
    give back [out, ""]

to ev_builtin with node and env and depth
    bkind is node[1]
    ln is node[3]
    p is ev with node[2] and env and depth
    if p[1] is not "" then
        give back p
    v is p[0]
    if bkind is "length" then
        if kind of v is "text" or is_real_list with v then
            give back [length of v, ""]
        rt_error with ln and "\"length of\" needs text or a list."
    if bkind is "first" then
        if not is_real_list with v then
            rt_error with ln and "\"first of\" needs a list."
        if length of v is 0 then
            rt_error with ln and "there is no first of an empty list."
        give back [v[0], ""]
    if bkind is "last" then
        if not is_real_list with v then
            rt_error with ln and "\"last of\" needs a list."
        if length of v is 0 then
            rt_error with ln and "there is no last of an empty list."
        give back [v[length of v - 1], ""]
    if bkind is "uppercase" then
        if kind of v is not "text" then
            rt_error with ln and "\"uppercase of\" needs text."
        give back [uppercase of v, ""]
    if bkind is "lowercase" then
        if kind of v is not "text" then
            rt_error with ln and "\"lowercase of\" needs text."
        give back [lowercase of v, ""]
    if bkind is "trim" then
        if kind of v is not "text" then
            rt_error with ln and "\"trim of\" needs text."
        give back [trim of v, ""]
    if bkind is "characters" then
        if kind of v is not "text" then
            rt_error with ln and "\"characters of\" needs text."
        give back [characters of v, ""]
    if bkind is "text" then
        give back [render with v, ""]
    if bkind is "kind" then
        give back [kind of v, ""]
    if bkind is "keys" then
        ks is bridge_dict_keys with v
        if ks is nothing then
            rt_error with ln and "\"keys of\" needs a python dictionary."
        give back [ks, ""]
    rt_error with ln and "I do not know that built-in."

to ev_builtin2 with node and env and depth
    bkind is node[1]
    ln is node[4]
    p is ev with node[2] and env and depth
    if p[1] is not "" then
        give back p
    q is ev with node[3] and env and depth
    if q[1] is not "" then
        give back q
    v is p[0]
    sep is q[0]
    if bkind is "split" then
        if kind of v is not "text" then
            rt_error with ln and "\"split of\" needs text."
        if kind of sep is not "text" or sep is "" then
            rt_error with ln and "\"split of\" needs a non-empty \"by\" text."
        give back [split of v by sep, ""]
    if not is_real_list with v then
        rt_error with ln and "\"join of\" needs a list."
    if kind of sep is not "text" then
        rt_error with ln and "\"join of\" needs a \"with\" text."
    for each item in v
        if kind of item is not "text" then
            rt_error with ln and "\"join of\" needs a list of text."
    give back [join of v with sep, ""]

to ev_subscript with node and env and depth
    ln is node[3]
    p is ev with node[1] and env and depth
    if p[1] is not "" then
        give back p
    q is ev with node[2] and env and depth
    if q[1] is not "" then
        give back q
    obj is p[0]
    index is q[0]
    if is_real_list with obj then
        i is subscript_index with index and length of obj and ln and "a list"
        give back [obj[i], ""]
    if kind of obj is "text" then
        i is subscript_index with index and length of obj and ln and "text"
        give back [obj[i], ""]
    if kind of obj is "python value" then
        miss is bridge_lookup_miss with obj and index
        if miss is not "" then
            rt_error with ln and "that lookup failed: " + miss
        give back [operator.getitem(obj, index), ""]
    rt_error with ln and "I cannot look inside " + kind of obj + " with brackets."

to ev with node and env and depth
    tag is node[0]
    if tag is "lit" then
        give back [node[1], ""]
    if tag is "var" then
        give back ev_var with node and env and depth
    if tag is "call" then
        give back ev_call_expr with node and env and depth
    if tag is "list" then
        give back ev_list_lit with node and env and depth
    if tag is "interp" then
        give back ev_interp with node and env and depth
    if tag is "subscript" then
        give back ev_subscript with node and env and depth
    if tag is "attr" then
        give back ev_attr with node and env and depth
    if tag is "callf" then
        give back ev_callf with node and env and depth
    if tag is "builtin" then
        give back ev_builtin with node and env and depth
    if tag is "builtin2" then
        give back ev_builtin2 with node and env and depth
    if tag is "binop" then
        give back ev_binop with node and env and depth
    if tag is "compare" then
        give back ev_compare with node and env and depth
    if tag is "and" then
        give back ev_binop with ["binop", "and", node[1], node[2], node[3]] and env and depth
    if tag is "or" then
        give back ev_binop with ["binop", "or", node[1], node[2], node[3]] and env and depth
    if tag is "not" then
        p is ev with node[1] and env and depth
        if p[1] is not "" then
            give back p
        if p[0] then
            give back [false, ""]
        give back [true, ""]
    if tag is "neg" then
        p is ev with node[1] and env and depth
        if p[1] is not "" then
            give back p
        if kind of p[0] is not "number" then
            rt_error with node[2] and "I can only use \"-\" with numbers."
        give back [0 - p[0], ""]
    rt_error with 0 and "I do not know how to work out this value yet."

note ==== SECTION: BRIDGE (phase B part 1, spec section 7) ====
note stdin, file I/O, and the Python bridge, delegated to the bootstrap
note through the walker's own bridge imports at the top of this file.
note Every delegated failure is pre-checked so the target program's line
note number survives. Failures the walker cannot pre-check (a foreign
note call failing at call time, a foreign subscript missing its key)
note surface at the bridge line; see the spec's known-gap note.

to strip_final_newline with line
    chars is characters of line
    n is length of chars
    if n is 0 then
        give back line
    if chars[n - 1] is not "\n" then
        give back line
    out is ""
    i is 0
    repeat while i is less than n - 1
        out is out + chars[i]
        i is i + 1
    give back out

to bridge_ask with prompt and ln
    emit is builtins.getattr(sys.stdout, "write")
    emit(prompt)
    sys.stdout.flush()
    line is sys.stdin.readline()
    if line is "" then
        rt_error with ln and "I asked a question, but the input ended."
    give back strip_final_newline with line

to safe_path with raw and ln and verb
    if kind of raw is "text" then
        shown is raw
    otherwise
        shown is text of raw
    target is pathlib.Path(shown)
    if not target.is_absolute() then
        target is pathlib.Path.cwd().joinpath(shown)
    resolved is target.resolve()
    base is builtins.str(pathlib.Path.cwd().resolve())
    rs is builtins.str(resolved)
    if rs is not base and not starts_with with rs and base + os.sep then
        rt_error with ln and "I cannot " + verb + " \"" + shown + "\": it leaves the current folder."
    give back resolved

to exec_ask with stmt and env and depth
    ln is stmt[3]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    prompt is p[0]
    if kind of prompt is not "text" then
        rt_error with ln and "the question I ask must be text."
    env_set with env and stmt[2] and bridge_ask with prompt and ln
    give back ["none"]

to exec_readfile with stmt and env and depth
    ln is stmt[3]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    raw is p[0]
    if kind of raw is "text" then
        shown is raw
    otherwise
        shown is text of raw
    path is safe_path with raw and ln and "read"
    if path.is_dir() then
        rt_error with ln and "\"" + shown + "\" is a folder, not a file."
    if not path.exists() then
        rt_error with ln and "I could not find the file \"" + shown + "\"."
    env_set with env and stmt[2] and path.read_text(encoding="utf-8", errors="replace")
    give back ["none"]

to exec_writefile with stmt and env and depth
    ln is stmt[4]
    vp is ev with stmt[1] and env and depth
    if vp[1] is not "" then
        give back [vp[1]]
    pp is ev with stmt[2] and env and depth
    if pp[1] is not "" then
        give back [pp[1]]
    raw is pp[0]
    if kind of raw is "text" then
        shown is raw
    otherwise
        shown is text of raw
    path is safe_path with raw and ln and "write to"
    if path.is_dir() then
        rt_error with ln and "\"" + shown + "\" is a folder, not a file."
    if not path.parent.exists() then
        rt_error with ln and "I could not write \"" + shown + "\": its folder does not exist."
    content is text of vp[0]
    if stmt[3] then
        opener is builtins.getattr(builtins, "open")
        handle is opener(path, "a", encoding="utf-8")
        emit is builtins.getattr(handle, "write")
        emit(content)
        closer is builtins.getattr(handle, "close")
        closer()
    otherwise
        path.write_text(content, encoding="utf-8")
    give back ["none"]

to installed_module_names
    infos is builtins.list(pkgutil.iter_modules())
    names is []
    for each info in infos
        n is info[1]
        if not names contains n then
            push n to names
    give back builtins.sorted(names)

to suggest_module with name
    lower is lowercase of name
    cands is installed_module_names
    for each cand in cands
        if cand is not name then
            cl is lowercase of cand
            if starts_with with cl and lower or starts_with with lower and cl then
                give back " Did you mean \"" + cand + "\"?"
    matches is difflib.get_close_matches(name, cands, 1, 0.6)
    if length of matches is greater than 0 then
        give back " Did you mean \"" + matches[0] + "\"?"
    give back ""

to import_missing_msg with modname
    parts is split of modname by "."
    top is parts[0]
    msg is "I could not find the Python package \"" + modname + "\"."
    msg is msg + suggest_module with top
    msg is msg + " If it is a pip package, install it first: pip install " + top
    give back msg

to bridge_import with modname and ln
    parts is split of modname by "."
    head is parts[0]
    if importlib.util.find_spec(head) is nothing then
        rt_error with ln and import_missing_msg with modname
    fullname is head
    i is 1
    repeat while i is less than length of parts
        fullname is fullname + "." + parts[i]
        if importlib.util.find_spec(fullname) is nothing then
            rt_error with ln and import_missing_msg with modname
        i is i + 1
    give back importlib.import_module(modname)

to exec_import with stmt and env and depth
    ln is stmt[3]
    modname is stmt[1]
    alias is stmt[2]
    imported is bridge_import with modname and ln
    if alias is "" then
        topparts is split of modname by "."
        head is topparts[0]
        env_set with env and head and operator.getitem(sys.modules, head)
    otherwise
        env_set with env and alias and imported
    give back ["none"]

to ev_attr with node and env and depth
    ln is node[3]
    op is ev with node[1] and env and depth
    if op[1] is not "" then
        give back op
    obj is op[0]
    name is node[2]
    if kind of obj is not "python value" then
        rt_error with ln and "only python values use dots; this is " + kind of obj + ", and dots are for the Python bridge."
    if not builtins.hasattr(obj, name) then
        tname is builtins.getattr(builtins.type(obj), "__name__")
        rt_error with ln and "the python \"" + tname + "\" has no \"" + name + "\"."
    give back [builtins.getattr(obj, name), ""]

to bridge_call with f and args and kwpairs
    kh is builtins.dict(kwpairs)
    ns is builtins.dict([["__jc_f", f], ["__jc_a", args], ["__jc_k", kh]])
    give back builtins.eval("__jc_f(*__jc_a, **__jc_k)", ns)

to bridge_lookup_miss with obj and key
    ns is builtins.dict([["__jc_o", obj], ["__jc_k", key]])
    give back builtins.eval("((__import__('re').sub('0x[0-9a-fA-F]+', '?', repr(__jc_k))[:200] or 'something went wrong') if __jc_k not in __jc_o else '') if hasattr(__jc_o, '__contains__') else ''", ns)

to ev_callf with node and env and depth
    ln is node[4]
    fp is ev with node[1] and env and depth
    if fp[1] is not "" then
        give back fp
    f is fp[0]
    if kind of f is not "python value" then
        rt_error with ln and "I can only call python functions with parentheses."
    if not builtins.callable(f) then
        rt_error with ln and "I can only call python functions with parentheses."
    args is []
    for each anode in node[2]
        ap is ev with anode and env and depth
        if ap[1] is not "" then
            give back ap
        push ap[0] to args
    kwpairs is []
    for each kw in node[3]
        kp is ev with kw[1] and env and depth
        if kp[1] is not "" then
            give back kp
        push [kw[0], kp[0]] to kwpairs
    give back [bridge_call with f and args and kwpairs, ""]

note ---- phase B part 2: ask ai (spec 8.2) ----
note The mind protocol (argv from JESUNCODE_AI_COMMAND, subprocess with a
note 60s timeout, the streaming reader) is the constant _AI_HELPERS_SRC
note template at the top of this file. Everything else, the transcript,
note the CALL loop, tool dispatch, RESULT lines, lives here in Jesun.Code.

to ai_bridge_ns
    ns is builtins.dict()
    builtins.exec(_AI_HELPERS_SRC, ns)
    give back ns

to ai_finish with r and ln
    code is r[0]
    if code is "missing" then
        rt_error with ln and "no mind connected. Set JESUNCODE_AI_COMMAND to a command that reads a prompt and writes an answer, for example: export JESUNCODE_AI_COMMAND=\"ollama run llama3.1\""
    if code is "not_found" then
        rt_error with ln and "I could not run the mind command."
    if code is "timeout" then
        rt_error with ln and "the mind took too long to answer (over 60 seconds)."
    if code is "talk" then
        rt_error with ln and "I could not talk to the mind."
    if code is "bad_exit" then
        msg is "the mind exited with an error."
        if r[1] is not "" then
            msg is msg + " It said: " + r[1]
        rt_error with ln and msg
    if code is "ok" then
        give back r[1]
    rt_error with ln and "I could not talk to the mind."

to ai_env_lookup with env and name
    i is length of env
    repeat while i is greater than 0
        i is i - 1
        scope is env[i]
        j is length of scope
        repeat while j is greater than 0
            j is j - 1
            pair is scope[j]
            if pair[0] is name then
                give back pair[1]
    give back nothing

to ai_split_top_level with intext
    parts is []
    depth is 0
    cur is ""
    quote is ""
    cs is characters of intext
    n is length of cs
    i is 0
    repeat while i is less than n
        ch is cs[i]
        if quote is not "" then
            cur is cur + ch
            if ch is "\\" and i + 1 is less than n then
                cur is cur + cs[i + 1]
                i is i + 2
                skip
            if ch is quote then
                quote is ""
            i is i + 1
            skip
        if ch is "\"" or ch is "'" then
            quote is ch
            cur is cur + ch
        otherwise
            if ch is "(" or ch is "[" or ch is "{{" then
                depth is depth + 1
                cur is cur + ch
            otherwise
                if ch is ")" or ch is "]" or ch is "}" then
                    if depth is greater than 0 then
                        depth is depth - 1
                    cur is cur + ch
                otherwise
                    if ch is "," and depth is 0 then
                        push cur to parts
                        cur is ""
                    otherwise
                        cur is cur + ch
        i is i + 1
    push cur to parts
    give back parts

to ai_tool_args with argtext and ln and env
    if trim of argtext is "" then
        give back []
    values is []
    for each part in ai_split_top_level with argtext
        p is trim of part
        if p is "" then
            rt_error with ln and "a tool call has an empty input."
        toks is lex with p + "\n" and 0 and false
        pair is parse_or with toks and 0
        i is expect with toks and pair[1] and "newline" and "the end of the line"
        v is ev with pair[0] and [env[0]] and 0
        push v[0] to values
    give back values

to ai_run_tool with name and argtext and toolnames and ln and env and depth and agent_depth
    if not toolnames contains name then
        give back "RESULT of " + name + ": I only have these tools: " + join of toolnames with ", " + ". I do not know a tool called \"" + name + "\"."
    target is ai_env_lookup with env and name
    if is_function_value with target then
        argvals is ai_tool_args with argtext and ln and env
        need is length of target[2]
        if length of argvals is not need then
            word is "input"
            if need is not 1 then
                word is "inputs"
            give back "RESULT of " + name + ": \"" + name + "\" needs " + text of need + " " + word + ", but got " + text of length of argvals + "."
        rv is call_function with target and argvals and env and depth and ln
        give back "RESULT of " + name + ": " + render with rv[0]
    if is_agent_value with target then
        argvals is ai_tool_args with argtext and ln and env
        if length of argvals is not 1 or kind of argvals[0] is not "text" then
            give back "RESULT of " + name + ": I can only ask " + name + " one question at a time, as text."
        if agent_depth + 1 is greater than 3 then
            rt_error with ln and "agents called agents too deep (3 levels max)."
        sub is agent_ask with target and argvals[0] and ln and env and depth and agent_depth + 1 and false
        give back "RESULT of " + name + ": " + sub
    give back "RESULT of " + name + ": I do not know a tool called \"" + name + "\"."

to ai_tool_loop with ns and prompt and toolnames and max_steps and dostream and ln and env and depth and per and history and agent_name and agent_depth
    run_fn is ns["_jc_ai_run"]
    match_fn is ns["_jc_call_match"]
    if per is not nothing and per is not "" then
        stripped is bridge_rstrip with per
        head is stripped + "\n\n"
    otherwise
        head is "You are a helper inside Jesun.Code. "
    system is head + "You can call tools by writing one per line like this:\nCALL: toolname(\"some text\", 2)\nAvailable tools: " + join of toolnames with ", " + "\nCall no other tools. Anything you write outside CALL lines is your final answer to the human."
    transcript is system
    if history is not nothing then
        if length of history is greater than 0 then
            transcript is transcript + "\n\nEarlier in this conversation:"
            for each turn in history
                transcript is transcript + "\nHuman: " + turn[0] + "\nMind: " + turn[1]
    transcript is transcript + "\n\nHuman: " + prompt
    step is 1
    repeat while step is less than max_steps + 1
        r is run_fn(transcript + "\n\n(You have used " + text of step + " of " + text of max_steps + " steps.)", dostream, sys.stdout)
        reply is ai_finish with r and ln
        calls is []
        answer_lines is []
        for each raw in split of reply by "\n"
            m is match_fn(raw)
            if length of m is 2 then
                push m to calls
            otherwise
                push raw to answer_lines
        if length of calls is 0 then
            give back trim of join of answer_lines with "\n"
        results is []
        for each c in calls
            push ai_run_tool with c[0] and c[1] and toolnames and ln and env and depth and agent_depth to results
        transcript is transcript + "\n\nMind:\n" + reply + "\n\nResults:\n" + join of results with "\n"
        step is step + 1
    if agent_name is not "" then
        rt_error with ln and agent_name + " used all " + text of max_steps + " steps without giving an answer."
    rt_error with ln and "the mind used all " + text of max_steps + " steps without giving an answer."

to exec_askai with stmt and env and depth
    ln is stmt[6]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    prompt is p[0]
    if kind of prompt is not "text" then
        rt_error with ln and "the question I ask the mind must be text."
    ns is ai_bridge_ns
    run_fn is ns["_jc_ai_run"]
    if length of stmt[2] is 0 then
        r is run_fn(prompt, stmt[5], sys.stdout)
        answer is ai_finish with r and ln
        env_set with env and stmt[4] and answer
        give back ["none"]
    answer is ai_tool_loop with ns and prompt and stmt[2] and stmt[3] and stmt[5] and ln and env and depth and nothing and nothing and "" and 0
    env_set with env and stmt[4] and answer
    give back ["none"]

note ---- phase B part 2: agents (spec 8.3) ----
note Agent values are ["agent", name, per, tools, rmode, memory_file,
note max_steps, history]. per/memory_file are msg or nothing; rmode
note is "off", "run", or "always"; history is a list of [prompt, answer]
note pairs, newest last, appended in place. A forget pushes a
note ["__jc_cleared__"] marker onto the history; readers use
note history_entries to see only the turns after the last marker. The
note marker survives aliasing (b is mem) because push mutates the
note shared list in place, which a bridge clear could not do: the
note bootstrap deep-copies lists handed to foreign calls.

to is_clear_marker with e
    if kind of e is "list" then
        if length of e is 1 then
            if e[0] is "__jc_cleared__" then
                give back true
    give back false

to history_entries with hist
    start is 0
    j is 0
    repeat while j is less than length of hist
        if is_clear_marker with hist[j] then
            start is j + 1
        j is j + 1
    out is []
    k is start
    repeat while k is less than length of hist
        push hist[k] to out
        k is k + 1
    give back out

to bridge_rstrip with s
    ns is builtins.dict([["__jc_s", s]])
    give back builtins.eval("__jc_s.rstrip()", ns)

to agent_bridge_ns
    ns is builtins.dict()
    builtins.exec(_AGENT_HELPERS_SRC, ns)
    give back ns

to jpm_bridge_ns
    ns is builtins.dict()
    builtins.exec(_JPM_HELPERS_SRC, ns)
    give back ns

to agent_emit with msg
    emit is builtins.getattr(sys.stdout, "write")
    emit(msg + "\n")
    sys.stdout.flush()
    give back nothing

to agent_mempath with name and memfile
    ns is agent_bridge_ns
    fn is ns["_jc_agent_mempath"]
    give back fn(name, memfile)

to agent_memory_load with ag and ln
    ns is agent_bridge_ns
    fn is ns["_jc_agent_load"]
    r is fn(agent_mempath with ag[1] and ag[5])
    code is r[0]
    if code is "missing" then
        give back nothing
    if code is "unreadable" then
        agent_emit with "Line " + text of ln + ": saved memory for " + ag[1] + " was unreadable, starting fresh."
        give back nothing
    hist is ag[7]
    for each turn in r[1]
        push turn to hist
    give back nothing

to agent_memory_save with ag and ln
    ns is agent_bridge_ns
    fn is ns["_jc_agent_save"]
    r is fn(agent_mempath with ag[1] and ag[5], history_entries with ag[7])
    if r[0] is "failed" then
        agent_emit with "Line " + text of ln + ": I could not save memory for " + ag[1] + "."
    give back nothing

to is_agent_value with v
    if kind of v is "list" then
        if length of v is 8 then
            if v[0] is "agent" then
                give back true
    give back false

to suggest_agents with name and env
    cands is []
    i is length of env
    repeat while i is greater than 0
        i is i - 1
        for each pair in env[i]
            if is_agent_value with pair[1] then
                if not cands contains pair[0] then
                    push pair[0] to cands
    lower is lowercase of name
    for each cand in cands
        if cand is not name then
            cl is lowercase of cand
            if starts_with with cl and lower or starts_with with lower and cl then
                give back " Did you mean \"" + cand + "\"?"
    matches is difflib.get_close_matches(name, cands, 1, 0.6)
    if length of matches is greater than 0 then
        give back " Did you mean \"" + matches[0] + "\"?"
    give back ""

to agent_find with name and env and ln
    i is length of env
    repeat while i is greater than 0
        i is i - 1
        scope is env[i]
        j is length of scope
        repeat while j is greater than 0
            j is j - 1
            pair is scope[j]
            if pair[0] is name then
                v is pair[1]
                if is_agent_value with v then
                    give back v
                if is_function_value with v then
                    rt_error with ln and "\"" + name + "\" is a function, not an agent."
                rt_error with ln and "\"" + name + "\" is not an agent, not an agent."
    rt_error with ln and "I do not know an agent called \"" + name + "\"." + suggest_agents with name and env

to agent_find_soft with name and env
    i is length of env
    repeat while i is greater than 0
        i is i - 1
        scope is env[i]
        j is length of scope
        repeat while j is greater than 0
            j is j - 1
            pair is scope[j]
            if pair[0] is name then
                if is_agent_value with pair[1] then
                    give back pair[1]
    give back nothing

to agent_ask with ag and prompt and ln and env and depth and agent_depth and dostream
    ns is ai_bridge_ns
    hist is nothing
    rawhist is nothing
    if ag[4] is not "off" then
        rawhist is ag[7]
        hist is history_entries with rawhist
    answer is ai_tool_loop with ns and prompt and ag[3] and ag[6] and dostream and ln and env and depth and ag[2] and hist and ag[1] and agent_depth
    if ag[4] is not "off" then
        push [prompt, answer] to rawhist
        if ag[4] is "always" then
            agent_memory_save with ag and ln
    give back answer

to exec_agentdef with stmt and env and depth
    ln is stmt[7]
    name is stmt[1]
    if stmt[3] contains name then
        rt_error with ln and name + " cannot list itself as a tool."
    per is nothing
    if stmt[2] is not nothing then
        p is ev with stmt[2] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        if kind of p[0] is not "text" then
            rt_error with ln and "the agent's persona must be text."
        per is p[0]
    memfile is ""
    if stmt[5] is not nothing then
        p is ev with stmt[5] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        if kind of p[0] is not "text" then
            rt_error with ln and "the agent's memory file must be text."
        memfile is p[0]
    ag is ["agent", name, per, stmt[3], stmt[4], memfile, stmt[6], []]
    if stmt[4] is "always" then
        agent_memory_load with ag and ln
    env_set with env and name and ag
    give back ["none"]

to exec_askagent with stmt and env and depth
    ln is stmt[5]
    ag is agent_find with stmt[1] and env and ln
    p is ev with stmt[2] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    if kind of p[0] is not "text" then
        rt_error with ln and "the question I ask the agent must be text."
    answer is agent_ask with ag and p[0] and ln and env and depth and 0 and stmt[4]
    env_set with env and stmt[3] and answer
    give back ["none"]

to exec_forget with stmt and env and depth
    ln is stmt[2]
    name is stmt[1]
    ag is agent_find_soft with name and env
    memfile is ""
    if ag is not nothing then
        memfile is ag[5]
        hist is ag[7]
        push ["__jc_cleared__"] to hist
    ns is agent_bridge_ns
    fn is ns["_jc_agent_forget"]
    r is fn(agent_mempath with name and memfile)
    code is r[0]
    if code is "missing" then
        agent_emit with name + " has nothing to forget."
        give back ["none"]
    if code is "failed" then
        rt_error with ln and "I could not forget " + name + "."
    agent_emit with "Memory of " + name + " cleared."
    give back ["none"]

note Later-phase statements parse like the bootstrap but do not run
note yet: jpm needs the network, tmux needs tmux. Fleets run now (spec
note 8.4), sequentially: the walker has one thread, so the asks run in
note ask order and the run stops at the first failing ask (spec 8.4.1).
note Operands are evaluated first so their errors match the bootstrap;
note a shape that survives that fails with the honest later-phase line.

to jpm_segment_ok with seg
    if seg is "" then
        give back false
    if seg contains ".." then
        give back false
    allowed is "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-"
    for each ch in characters of seg
        if not allowed contains ch then
            give back false
    give back true

to exec_usepkg with stmt and env and depth
    ln is stmt[2]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    raw is p[0]
    if kind of raw is "text" then
        addr is raw
    otherwise
        addr is text of raw
    parts is split of addr by "/"
    ok is length of parts is 3
    if ok then
        for each seg in parts
            if not jpm_segment_ok with seg then
                ok is false
    if not ok then
        rt_error with ln and "\"" + addr + "\" is not a package address; write it like \"github.com/user/pkg\"."
    if parts[0] is not "github.com" then
        rt_error with ln and "I can only fetch packages from github.com, not \"" + parts[0] + "\"."
    later_phase_error with ln and "use"

to exec_bringin with stmt and env and depth
    ln is stmt[2]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    raw is p[0]
    if kind of raw is "text" then
        pname is raw
    otherwise
        pname is text of raw
    if pname is "" or pname is "." or pname is ".." or not jpm_segment_ok with pname then
        rt_error with ln and "\"" + pname + "\" is not a package name; bring in a name like \"time\"."
    ns is jpm_bridge_ns
    fn is ns["_jc_jpm_find"]
    r is fn(pname)
    if r[0] is "missing" then
        rt_error with ln and "I have not fetched the package \"" + pname + "\" yet; run use \"github.com/user/" + pname + "\" first."
    later_phase_error with ln and "bring"

note The fleet nesting guard is a plain Jesun.Code stack, read via
note "last of". A flag mutated through builtins.eval cannot work: the
note bootstrap deep-copies every list handed to a foreign call
note (to_python), so the eval would flip a copy and the walker would
note never see it. push appends in place with no copy, so the stack top
note is always the live value.
fleet_guard_stack is [false]

to fleet_guard_on
    give back last of fleet_guard_stack

to fleet_guard_set with on
    push on to fleet_guard_stack
    give back nothing

to fleet_index_of with names and want
    i is 0
    repeat while i is less than length of names
        if names[i] is want then
            give back i
        i is i + 1
    give back -1

to fleet_bridge_ns
    ns is builtins.dict()
    builtins.exec(_FLEET_HELPERS_SRC, ns)
    give back ns

to fleet_head with shared
    if length of shared is 0 then
        give back ""
    out is "The fleet remembers:\n"
    for each triple in shared
        out is out + "- " + triple[2] + " was asked \"" + triple[0] + "\" and answered \"" + triple[1] + "\"\n"
    out is out + "\n"
    give back out

to fleet_memory_load with mempath and ln
    ns is fleet_bridge_ns
    fn is ns["_jc_fleet_load"]
    r is fn(mempath)
    code is r[0]
    if code is "unreadable" then
        agent_emit with "Line " + text of ln + ": the fleet's saved memory was unreadable, starting fresh."
        give back []
    if code is "ok" then
        give back r[1]
    give back []

to fleet_memory_save with mempath and triples and ln
    ns is fleet_bridge_ns
    fn is ns["_jc_fleet_save"]
    r is fn(mempath, triples)
    if r[0] is "failed" then
        agent_emit with "Line " + text of ln + ": I could not save the fleet's memory."
    give back nothing

to exec_fleetdef with stmt and env and depth
    ln is stmt[5]
    if fleet_guard_on then
        rt_error with ln and "a fleet cannot open inside another fleet's asks."
    flname is stmt[1]
    flmembers is stmt[2]
    flasks is stmt[3]
    flmem is stmt[4]
    aglist is []
    for each m in flmembers
        push agent_find with m and env and ln to aglist
    prompts is []
    for each fq in flasks
        p is ev with fq[1] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        if kind of p[0] is not "text" then
            rt_error with fq[3] and "the question I ask the fleet member must be text."
        push p[0] to prompts
    mempath is ""
    shared is []
    if flmem is not nothing then
        p is ev with flmem and env and depth
        if p[1] is not "" then
            give back [p[1]]
        if kind of p[0] is not "text" then
            rt_error with ln and "the fleet's memory file must be text."
        mempath is p[0]
        shared is fleet_memory_load with mempath and ln
    head is fleet_head with shared
    answers is []
    i is 0
    repeat while i is less than length of flasks
        fq is flasks[i]
        ag is aglist[fleet_index_of with flmembers and fq[0]]
        child is []
        for each scope in env
            push scope to child
        push [] to child
        fleet_guard_set with true
        answer is agent_ask with ag and head + prompts[i] and fq[3] and child and depth and 0 and false
        fleet_guard_set with false
        push answer to answers
        i is i + 1
    if flmem is not nothing then
        j is 0
        repeat while j is less than length of flasks
            push [prompts[j], answers[j], flasks[j][0]] to shared
            j is j + 1
        fleet_memory_save with mempath and shared and ln
    env_set with env and flname and answers
    k is 0
    repeat while k is less than length of flasks
        env_set with env and flasks[k][2] and answers[k]
        k is k + 1
    give back ["none"]

to exec_termopen with stmt and env and depth
    ln is stmt[2]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    later_phase_error with ln and "open"

to exec_termsend with stmt and env and depth
    ln is stmt[3]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    p is ev with stmt[2] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    later_phase_error with ln and "send"

to exec_termread with stmt and env and depth
    ln is stmt[3]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    later_phase_error with ln and "read"

to exec_termclose with stmt and env and depth
    ln is stmt[2]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    later_phase_error with ln and "close"

note ---- statement execution: exec_stmt gives back a signal

to exec_block with stmts and env and depth
    for each stmt in stmts
        sig is exec_stmt with stmt and env and depth
        if sig[0] is not "none" then
            give back sig
    give back ["none"]

to exec_if with stmt and env and depth
    branches is stmt[1]
    elsebody is stmt[2]
    for each branch in branches
        p is ev with branch[0] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        if p[0] then
            give back exec_block with branch[1] and env and depth
    if length of elsebody is greater than 0 then
        give back exec_block with elsebody and env and depth
    give back ["none"]

to loop_signal with sig
    if sig[0] is "skip" then
        give back "skip"
    if sig[0] is "stop" then
        give back "stop"
    if sig[0] is not "none" then
        give back "carry"
    give back "none"

to exec_repeat_times with stmt and env and depth
    ln is stmt[3]
    p is ev with stmt[1] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    count is p[0]
    if kind of count is not "number" then
        rt_error with ln and "\"repeat\" needs a number of times."
    if count % 1 is not 0 then
        rt_error with ln and "\"repeat\" needs a whole number of times."
    if count is less than 0 then
        rt_error with ln and "\"repeat\" needs zero or more times."
    runs is 0
    repeat while runs is less than count
        runs is runs + 1
        if runs is greater than 1000000 then
            rt_error with ln and "this loop ran a million times; I stopped it."
        sig is exec_block with stmt[2] and env and depth
        how is loop_signal with sig
        if how is "skip" then
            skip
        if how is "stop" then
            give back ["none"]
        if how is "carry" then
            give back sig
    give back ["none"]

to exec_repeat_while with stmt and env and depth
    ln is stmt[3]
    runs is 0
    keep_going is true
    repeat while keep_going
        p is ev with stmt[1] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        if not p[0] then
            keep_going is false
            skip
        runs is runs + 1
        if runs is greater than 1000000 then
            rt_error with ln and "this loop ran a million times; I stopped it."
        sig is exec_block with stmt[2] and env and depth
        how is loop_signal with sig
        if how is "skip" then
            skip
        if how is "stop" then
            give back ["none"]
        if how is "carry" then
            give back sig
    give back ["none"]

to exec_foreach with stmt and env and depth
    ln is stmt[4]
    p is ev with stmt[2] and env and depth
    if p[1] is not "" then
        give back [p[1]]
    if not is_real_list with p[0] then
        rt_error with ln and "I can only loop over a list."
    for each item in p[0]
        env_set with env and stmt[1] and item
        sig is exec_block with stmt[3] and env and depth
        how is loop_signal with sig
        if how is "skip" then
            skip
        if how is "stop" then
            give back ["none"]
        if how is "carry" then
            give back sig
    give back ["none"]

to exec_stmt with stmt and env and depth
    tag is stmt[0]
    if tag is "show" then
        p is ev with stmt[1] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        show render with p[0]
        give back ["none"]
    if tag is "is" then
        p is ev with stmt[2] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        env_set with env and stmt[1] and p[0]
        give back ["none"]
    if tag is "push" then
        p is ev with stmt[1] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        target is env_get with env and stmt[2] and stmt[3]
        if not is_real_list with target then
            rt_error with stmt[3] and "I can only push to a list, but \"" + stmt[2] + "\" holds " + kind of target + "."
        push p[0] to target
        give back ["none"]
    if tag is "fail" then
        p is ev with stmt[1] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        if kind of p[0] is not "text" then
            rt_error with stmt[2] and "\"fail with\" needs some text to say."
        fail with p[0]
    if tag is "ask" then
        give back exec_ask with stmt and env and depth
    if tag is "askai" then
        give back exec_askai with stmt and env and depth
    if tag is "agentdef" then
        give back exec_agentdef with stmt and env and depth
    if tag is "askagent" then
        give back exec_askagent with stmt and env and depth
    if tag is "forget" then
        give back exec_forget with stmt and env and depth
    if tag is "usepkg" then
        give back exec_usepkg with stmt and env and depth
    if tag is "bringin" then
        give back exec_bringin with stmt and env and depth
    if tag is "fleetdef" then
        give back exec_fleetdef with stmt and env and depth
    if tag is "termopen" then
        give back exec_termopen with stmt and env and depth
    if tag is "termsend" then
        give back exec_termsend with stmt and env and depth
    if tag is "termread" then
        give back exec_termread with stmt and env and depth
    if tag is "termclose" then
        give back exec_termclose with stmt and env and depth
    if tag is "readfile" then
        give back exec_readfile with stmt and env and depth
    if tag is "writefile" then
        give back exec_writefile with stmt and env and depth
    if tag is "import" then
        give back exec_import with stmt and env and depth
    if tag is "if" then
        give back exec_if with stmt and env and depth
    if tag is "repeat_times" then
        give back exec_repeat_times with stmt and env and depth
    if tag is "repeat_while" then
        give back exec_repeat_while with stmt and env and depth
    if tag is "foreach" then
        give back exec_foreach with stmt and env and depth
    if tag is "to" then
        env_set with env and stmt[1] and ["function", stmt[1], stmt[2], stmt[3], env, stmt[4]]
        give back ["none"]
    if tag is "giveback" then
        p is ev with stmt[1] and env and depth
        if p[1] is not "" then
            give back [p[1]]
        give back ["giveback", p[0], stmt[2]]
    if tag is "stop" then
        give back ["stop", stmt[1]]
    if tag is "skip" then
        give back ["skip", stmt[1]]
    if tag is "exprstmt" then
        e is stmt[1]
        if e[0] is "var" then
            target is env_get with env and e[1] and e[2]
            if is_function_value with target then
                if length of target[2] is greater than 0 then
                    arity_word with e[1] and length of target[2] and 0 and stmt[2]
        p is ev with e and env and depth
        if p[1] is not "" then
            give back [p[1]]
        give back ["none"]
    rt_error with 0 and "I do not know how to run this yet."

note ==== SECTION: DRIVER ====

if length of arguments is 0 then
    show "Call me like this: python jesun.py jesun.jc program.jc"
otherwise
    path is arguments[0]
    read file path giving source
    header is bangla_header with source
    bangla_mode is false
    if header is not 0 then
        bangla_mode is true
    toks is lex with source and header and bangla_mode
    tree is parse_program with toks
    env is [[]]
    sig is exec_block with tree and env and 0
    if sig[0] is "giveback" then
        rt_error with sig[2] and "\"give back\" only makes sense inside a function."
    if sig[0] is "stop" then
        rt_error with sig[1] and "\"stop\" only makes sense inside a loop."
    if sig[0] is "skip" then
        rt_error with sig[1] and "\"skip\" only makes sense inside a loop."
